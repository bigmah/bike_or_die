+/* ------------------------------------------------------------- rarm glue
+ * Bridge for the statically recompiled ARM32 code (tools/recomparm.py).
+ * Mirrors uarmRun(): the recompiled code runs until the PC leaves the `armc`
+ * blobs, which happens for the return stub, the call-68K trampoline, and the
+ * PACE syscall addresses (0x04G0NNNN).
+ */
+
+static uint32_t rarm_ret_addr, rarm_call_addr;
+
+void rarm_panic(rarm_state *S, uint32_t pc, const char *why) {
+  char buf[160];
+  sys_snprintf(buf, sizeof(buf) - 1, "recomp(arm): %s at 0x%08X", why, pc);
+  emupalmos_panic(buf, EMUPALMOS_INVALID_INSTRUCTION);
+  S->halt = 1;
+}
+
+static int rarm_trace_fd = -1;
+static uint32_t rarm_trace_n, rarm_trace_max;
+
+static void rarm_trace_open(const char *path, uint32_t max) {
+  rarm_trace_fd = sys_create(path, SYS_WRITE | SYS_TRUNC, 0644);
+  rarm_trace_n = 0; rarm_trace_max = max; rarm_tracing = (rarm_trace_fd >= 0);
+}
+static void rarm_trace_close(void) {
+  rarm_tracing = 0;
+  if (rarm_trace_fd >= 0) { sys_close(rarm_trace_fd); rarm_trace_fd = -1; }
+}
+void rarm_trace_regs(uint32_t *r, uint32_t n, uint32_t z, uint32_t c, uint32_t v) {
+  rarm_state S;
+  int i;
+  for (i = 0; i < 16; i++) S.r[i] = r[i];
