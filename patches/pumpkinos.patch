diff --git a/script/bod.lua b/script/bod.lua
new file mode 100644
index 0000000..a7a7d7b
--- /dev/null
+++ b/script/bod.lua
@@ -0,0 +1,86 @@
+function cleanup_callback()
+  if pumpkin then
+    pumpkin.finish()
+  end
+end
+
+pit.cleanup(cleanup_callback)
+
+abgr = false
+
+if custom_load then
+  lib = custom_load()
+end
+
+if not lib and pit.getenv("WAYLAND_DISPLAY") then
+  lib = pit.loadlib("libwwayland")
+  if lib then pit.loadlib("libaalsa") end
+end
+
+if not lib then
+  lib = pit.loadlib("libray")
+  if lib then
+    pit.loadlib("libaalsa")
+    abgr = true
+  end
+end
+
+if not lib and pit.getenv("DISPLAY") then
+  lib = pit.loadlib("libwxcb")
+  if lib then pit.loadlib("libaalsa") end
+end
+
+if not lib then
+  lib = pit.loadlib("liblsdl3")
+end
+
+if not lib then
+  lib = pit.loadlib("liblsdl2")
+end
+
+if not lib then
+  lib = pit.loadlib("libfb")
+  if lib then
+    lib.setup(0, 1, 0)
+    lib.cursor(true)
+  end
+end
+
+if not lib then
+  lib = pit.loadlib("libwnull")
+  lib.accept(true, 7000)
+  --lib.connect("127.0.0.1", 7000)
+end
+
+if not lib then
+  print("could not load a display lib")
+  pit.finish(0)
+  return
+end
+
+fullrefresh = false
+if pit.getenv("BE_HOST_CPU") then
+  fullrefresh = true
+end
+
+pit.mount("./vfs/", "/")
+
+pumpkin = pit.loadlib("libos")
+pumpkin.init()
+
+-- window zoom (integer); BOD_ZOOM=1 disables scaling
+local zoom = tonumber(pit.getenv("BOD_ZOOM") or "3") or 3
+
+pumpkin.start {
+  density  = 144,
+  width    = 320,
+  height   = 320,
+  abgr     = abgr,
+  fullrefresh = fullrefresh,
+  depth    = 16,
+  hdepth   = lib.hdepth,
+  xfactor  = zoom,
+  yfactor  = zoom,
+  taskbar  = false,
+  launcher = "BikeOrDie"
+}
diff --git a/script/bodtest.lua b/script/bodtest.lua
new file mode 100644
index 0000000..0b71807
--- /dev/null
+++ b/script/bodtest.lua
@@ -0,0 +1,19 @@
+-- Headless harness: no window, frames written as PPM, input from a script file.
+function cleanup_callback() if pumpkin then pumpkin.finish() end end
+pit.cleanup(cleanup_callback)
+
+lib = pit.loadlib("libwtest")
+if not lib then print("could not load libwtest"); pit.finish(0); return end
+
+pit.mount("./vfs/", "/")
+pumpkin = pit.loadlib("libos")
+pumpkin.init()
+pumpkin.start {
+  density  = 144,
+  width    = 320,
+  height   = 320,
+  depth    = 16,
+  hdepth   = lib.hdepth,
+  taskbar  = false,
+  launcher = "BikeOrDie"
+}
