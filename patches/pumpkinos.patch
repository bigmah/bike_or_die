diff --git a/src/emscripten/Makefile b/src/emscripten/Makefile
index 4114db6..94391eb 100644
--- a/src/emscripten/Makefile
+++ b/src/emscripten/Makefile
@@ -4,16 +4,72 @@ include ../common.mak
 
 PROGRAM=pumpkin
 
+# The statically recompiled game code, built by `make -C src WASM=1`.
+BOD=$(PUMPKINOS)/../..
+RECOMP=$(BOD)/build/librecomp-wasm.a
+
 SOURCE=main.c
 OBJS=$(SOURCE:%.c=%.wasm)
 MODULES=libpit.a libpumpkin.a libscriptlua.a liblsdl2.a libos.a
 
+# PumpkinOS runs the OS, the application and the audio mixer on threads of
+# their own, so the pool has to be deep enough for all of them at once, and
+# the recompiled chunks are large functions that want a real stack.
+# The OS itself stays on the browser's main thread: SDL reaches WebGL through
+# EGL, whose calls Emscripten proxies to that thread unconditionally, so a
+# renderer created anywhere else has no context to draw with.
+# The memory is fixed rather than growable: growing a shared memory is both
+# slow and, in Chrome, fatal to the tab here, and 384 MB comfortably holds the
+# 64 MB system heap, the 8 MB the application gets and the packaged VFS.
+LINKFLAGS=-O1 -pthread \
+  -s USE_SDL=2 \
+  -s ENVIRONMENT=web,worker \
+  -s INITIAL_MEMORY=402653184 \
+  -s STACK_SIZE=8388608 -s DEFAULT_PTHREAD_STACK_SIZE=8388608 \
+  -s PROXY_TO_PTHREAD=1 -s PTHREAD_POOL_SIZE=8 \
+  -s EXPORTED_FUNCTIONS=_main,_cexit,_pumpkin_send_deploy,_bod_reset_saves,_pumpkin_set_ride_keys,_pumpkin_get_ride_keys,_bod_pack_command,_bod_pack_state,_bod_pack_seq,_bod_ui_command,_bod_ui_taken,_bod_ui_state,_bod_ui_seq,_bod_ui_menubar,_bod_ui_menubar_seq,_bod_canvas_info \
+  -s EXPORTED_RUNTIME_METHODS=ccall,stringToNewUTF8,FS \
+  -s INCOMING_MODULE_JS_API=canvas,print,printErr,setStatus,preRun,postRun,onRuntimeInitialized,locateFile,mainScriptUrlOrBlob \
+  -s EXIT_RUNTIME \
+  -s WASMFS=1
+
+# e.g. EXTRA_LINKFLAGS="-sASSERTIONS=1 -g2" for a debuggable build.
+EXTRA_LINKFLAGS?=
+
+# Both preloaded trees are read-only, so /vfs -- the one PumpkinOS runs from --
+# is assembled at startup out of /boot (the script it boots from) and /pristine
+# (the game and its level packs), which is also where a first visit fills the
+# writable half from. WasmFS keeps the filesystem inside the wasm module, so a thread
+# opening a file does not have to go through the browser's main thread, and it
+# is what provides the OPFS backend the writable half is kept in.
+# /pristine is named a tree at a time rather than wholesale. PumpkinOS's vfs
+# also holds app_install, the inbox a native `make install` drops its .prc
+# files into, and packaging the directory whole meant the game shipped with
+# whatever a native build had last left there -- 1.5 MB of stock Palm
+# applications that main.c never reads, since it fills /vfs from these two and
+# app_registry alone. What is in the download should not depend on which build
+# ran last.
+PRELOAD=--preload-file vfs@/boot \
+  --preload-file $(PUMPKINOS)/vfs/app_storage@/pristine/app_storage \
+  --preload-file $(PUMPKINOS)/vfs/app_card@/pristine/app_card
+
 $(PROGRAM).zip: $(PROGRAM).html coi-serviceworker.js
 	zip $(PROGRAM).zip $(PROGRAM).wasm $(PROGRAM).data $(PROGRAM).html $(PROGRAM).js coi-serviceworker.js
 
-$(PROGRAM).html: $(OBJS) $(MODULES) template.html vfs/pumpkin.lua
-	$(EM_CC) -o $(PROGRAM).js -s ALLOW_MEMORY_GROWTH=1 -s USE_SDL=2 -s ENVIRONMENT=web,worker -s PTHREAD_POOL_SIZE=4 -s EXPORTED_FUNCTIONS=_main,_cmain,_cexit,_pumpkin_send_deploy -s EXPORTED_RUNTIME_METHODS=ccall -s EXIT_RUNTIME -pthread -lidbfs.js --preload-file vfs $(OBJS) $(MODULES)
+# The shared CFLAGS say -ffreestanding, under which clang does not treat main
+# as special and so does not emit the __main_argc_argv entry point that
+# PROXY_TO_PTHREAD's startup object calls.
+main.wasm: main.c
+	@echo Compiling $<
+	@$(EM_CC) $(CFLAGS) -fhosted -c -o $@ $<
+
+$(PROGRAM).html: $(OBJS) $(MODULES) $(RECOMP) template.html bod-pre.js vfs/pumpkin.lua
+	@echo Linking $(PROGRAM).js
+	$(EM_CC) -o $(PROGRAM).js $(LINKFLAGS) $(EXTRA_LINKFLAGS) --pre-js bod-pre.js $(PRELOAD) $(OBJS) $(MODULES) $(RECOMP)
 	cp template.html $(PROGRAM).html
 
+serve: $(PROGRAM).html
+	@python3 $(BOD)/tools/webserver.py 8080 .
+
 clean:
 	rm -f $(OBJS) $(PROGRAM).zip $(PROGRAM).wasm $(PROGRAM).data $(PROGRAM).html $(PROGRAM).js
diff --git a/src/emscripten/bod-pre.js b/src/emscripten/bod-pre.js
new file mode 100644
index 0000000..bb39a2e
--- /dev/null
+++ b/src/emscripten/bod-pre.js
@@ -0,0 +1,495 @@
+// Browser-side setup for the Bike or Die 2 WebAssembly build: the environment
+// that tools/make_app.sh exports around the native one, and the page's half of
+// the saved data.
+
+// What tools/make_app.sh exports before running pumpkin. Anything here can be
+// overridden from the page (window.BOD_ENV) or the query string (?user=Me).
+var bodDefaultEnv = {
+  PUMPKIN_DISPLAY_LE: '1',    // the game's ARM blitter writes little-endian RGB565
+  PUMPKIN_SOUND:      '1',
+  PUMPKIN_VOLUME:     '64',   // PumpkinOS defaults the Palm volumes to 0
+  PUMPKIN_USER:       'PalmDB',
+  BOD_RECOMP:         '1',
+  BOD_ARM_ENGINE:     'recomp',
+  BOD_ZOOM:           '1',    // the page scales the canvas, not the game
+  BOD_FPS:            '60'    // PumpkinOS refreshes every 50ms; a game wants more
+};
+
+// Returned to C as "KEY=VALUE\n..." and applied with setenv, so that the value
+// lives in the wasm heap where every thread can read it.
+function bodEnvString() {
+  var env = {}, k;
+  for (k in bodDefaultEnv) env[k] = bodDefaultEnv[k];
+  if (typeof self !== 'undefined' && self.BOD_ENV) {
+    for (k in self.BOD_ENV) env[k] = String(self.BOD_ENV[k]);
+  }
+  try {
+    // main() runs on a thread of its own, where there is no page to ask -- but
+    // the page passes its own query string on to the workers' script URL, so
+    // self.location has it in both places.
+    var q = new URLSearchParams(self.location.search);
+    if (q.get('user')) env.PUMPKIN_USER = q.get('user');
+    if (q.get('sound') !== null) env.PUMPKIN_SOUND = q.get('sound') === '0' ? '0' : '1';
+    q.forEach(function (v, n) {
+      if (n.indexOf('BOD_') === 0 || n.indexOf('PUMPKIN_') === 0) env[n] = v;
+    });
+  } catch (e) { /* no query string is fine */ }
+  var out = '';
+  for (k in env) out += k + '=' + env[k] + '\n';
+  return out;
+}
+
+// Everything the game writes is kept by the wasm side (see main.c); the page
+// only has to hold main() back until the runtime is up, and to offer a way to
+// throw the saved data away.
+var Module = typeof Module != 'undefined' ? Module : {};
+
+function bodReset() {
+  try {
+    Module.ccall('bod_reset_saves', null, null, null);
+  } catch (e) {
+    console.warn('could not clear the saved data:', e);
+  }
+  window.location.reload();
+}
+
+// ------------------------------------------------------------ presenting --
+//
+// The page draws the frame; the game never waits for it to.
+//
+// SDL's software renderer presents with MAIN_THREAD_EM_ASM -- the thread
+// holding the frame stops while the browser's main thread converts 102,400
+// pixels in JavaScript and calls putImageData -- and that hop is what held the
+// game to thirty-seven frames a second arriving two display refreshes apart.
+// So the wasm side converts the frame where it already is and leaves it in the
+// shared heap (liblsdl2_web.c); this reads it from there in its own
+// requestAnimationFrame. Neither side ever blocks on the other.
+//
+// The same loop paces the game. Each turn bumps `vsync`, and the game draws at
+// most one frame per refresh it has not answered yet, so a frame is drawn just
+// after a refresh and shown on the next one -- evenly spaced, instead of a
+// clock of the game's own beating against the display's. A tab in the
+// background stops calling requestAnimationFrame, the counter stops, and the
+// game falls back to its own timer after a quarter of a second.
+//
+// `seq` counts published frames, and is read either side of the copy: a frame
+// published while this one was being copied is copied again rather than torn
+// into the one before it.
+//
+// What it draws with is the other half: see the screen, below.
+
+// ------------------------------------------------------------ the screen --
+//
+// The game draws 320x320, and the screen it is looked at on has several times
+// that many pixels in each direction. How they are made up is the Screen
+// setting on the page:
+//
+//   pixels  every one of the game's pixels a square, as a Palm showed it. At
+//           a whole-number scale that is exactly nearest-neighbour. At any
+//           other -- a phone, whose screen is as big as the phone allows --
+//           the squares cannot all be the same size, so the one device pixel
+//           that straddles a seam is blended instead of some rows doubling.
+//   smooth  bilinear.
+//   xbr     Hyllian's xBR (level 2). Each pixel's corners are redrawn from the
+//           edges that run through its 5x5 neighbourhood, so lettering,
+//           wheels and the outlines of hills come out as smooth lines at the
+//           display's own resolution, while flat colour and texture are left
+//           as they were.
+//
+// Each is a fragment shader, drawn into the canvas with its backing store set
+// to its CSS size times devicePixelRatio: one of its pixels per device pixel,
+// which is the resolution the frame is upscaled to. The frame itself goes up
+// as a 320x320 texture. Upscaling on the CPU instead would make the copy out
+// of the heap and the putImageData after it sixteen times the size, sixty
+// times a second, on the thread the page's controls run on.
+//
+// Without WebGL the canvas keeps the 2D context and its 320x320 backing, and
+// the browser scales it the way the stylesheet says: pixels or smooth. xBR
+// needs the shader and is not offered.
+
+var BOD_SCREEN_MODES = ['pixels', 'smooth', 'xbr'];
+
+var BOD_SCREEN_VS = [
+  'attribute vec2 a_pos;',
+  'varying vec2 v_uv;',
+  'void main() {',
+  '  v_uv = a_pos * vec2(0.5, -0.5) + 0.5;',   // row 0 of the frame at the top
+  '  gl_Position = vec4(a_pos, 0.0, 1.0);',
+  '}'
+].join('\n');
+
+// u_size is the frame in pixels, u_scale how many device pixels each of them
+// covers on the screen.
+var BOD_SCREEN_HEAD = [
+  'precision highp float;',
+  'uniform sampler2D u_tex;',
+  'uniform vec2 u_size;',
+  'uniform vec2 u_scale;',
+  'varying vec2 v_uv;',
+  ''
+].join('\n');
+
+var BOD_SCREEN_FS = {
+  // Sampled bilinearly, but only ever at a texel's centre except within half
+  // a device pixel of a seam, where the sample slides across it.
+  pixels: BOD_SCREEN_HEAD + [
+    'void main() {',
+    '  vec2 p = v_uv * u_size;',
+    '  vec2 seam = floor(p + 0.5);',
+    '  vec2 d = clamp((p - seam) * u_scale, -0.5, 0.5);',
+    '  gl_FragColor = texture2D(u_tex, (seam + d) / u_size);',
+    '}'
+  ].join('\n'),
+
+  smooth: BOD_SCREEN_HEAD + [
+    'void main() { gl_FragColor = texture2D(u_tex, v_uv); }'
+  ].join('\n'),
+
+  // xBR-lv2, after Hyllian's (MIT licence), with corner type C. Sampled with
+  // nearest-neighbour. The 5x5 neighbourhood of the pixel E being drawn:
+  //
+  //        A1 B1 C1
+  //     A0  A  B  C C4
+  //     D0  D  E  F F4
+  //     G0  G  H  I I4
+  //        G5 H5 I5
+  //
+  // Everything is worked out for the four corners of E at once, as the four
+  // components of a vec4: the bottom right, top right, top left and bottom
+  // left, each with its neighbours renamed as if it were the bottom right.
+  // The comparisons are of luma scaled to 0-48; delta is how far across an
+  // edge the blend runs, one device pixel's worth.
+  xbr: BOD_SCREEN_HEAD + [
+    'const vec3 Y  = vec3(14.352, 28.176, 5.472);',
+    'const vec4 Ao = vec4( 1.0, -1.0, -1.0,  1.0);',
+    'const vec4 Bo = vec4( 1.0,  1.0, -1.0, -1.0);',
+    'const vec4 Co = vec4( 1.5,  0.5, -0.5,  0.5);',
+    'const vec4 Ax = vec4( 1.0, -1.0, -1.0,  1.0);',
+    'const vec4 Bx = vec4( 0.5,  2.0, -0.5, -2.0);',
+    'const vec4 Cx = vec4( 1.0,  1.0, -0.5,  0.0);',
+    'const vec4 Ay = vec4( 1.0, -1.0, -1.0,  1.0);',
+    'const vec4 By = vec4( 2.0,  0.5, -2.0, -0.5);',
+    'const vec4 Cy = vec4( 2.0,  0.0, -1.0,  0.5);',
+    'vec4 df(vec4 a, vec4 b) { return abs(a - b); }',
+    'float cdf(vec3 a, vec3 b) { vec3 d = abs(a - b); return d.r + d.g + d.b; }',
+    'vec4 eq(vec4 a, vec4 b) { return step(df(a, b), vec4(15.0)); }',
+    'vec4 neq(vec4 a, vec4 b) { return vec4(1.0) - eq(a, b); }',
+    'vec4 wd(vec4 a, vec4 b, vec4 c, vec4 d, vec4 e, vec4 f, vec4 g, vec4 h) {',
+    '  return df(a, b) + df(a, c) + df(d, e) + df(d, f) + 4.0 * df(g, h);',
+    '}',
+    'vec3 at(vec2 c, float x, float y) { return texture2D(u_tex, c + vec2(x, y) / u_size).rgb; }',
+    'void main() {',
+    '  vec2 p = v_uv * u_size;',
+    '  vec2 fp = fract(p);',
+    '  vec2 c = (floor(p) + 0.5) / u_size;',
+    '  vec3 A1 = at(c, -1.0, -2.0), B1 = at(c, 0.0, -2.0), C1 = at(c, 1.0, -2.0);',
+    '  vec3 A0 = at(c, -2.0, -1.0), A = at(c, -1.0, -1.0), B = at(c, 0.0, -1.0), C = at(c, 1.0, -1.0), C4 = at(c, 2.0, -1.0);',
+    '  vec3 D0 = at(c, -2.0,  0.0), D = at(c, -1.0,  0.0), E = at(c, 0.0,  0.0), F = at(c, 1.0,  0.0), F4 = at(c, 2.0,  0.0);',
