+// Take the whole menu off the screen and give the form back its window.
+
+static void menu_close(MenuBarType *menuP) {
+  MenuPullDownType *pd = &menuP->menus[menuP->curMenu];
+
+  if (!pd->hidden) {
+    menu_hide_pd(menuP, pd);
+  }
+  pd->selectedItem = -1;
