+++ b/src/libpumpkin/bodpack.h
@@ -0,0 +1,19 @@
+#ifndef BODPACK_H
+#define BODPACK_H
+
+/* Bike or Die's level pack chooser, driven from the host. See bodpack.c. */
+
+/* For the host, from any thread. */
+void bod_pack_command(const char *cmd);
+const char *bod_pack_state(void);
+uint32_t bod_pack_seq(void);
+
+/* The application thread's hooks. */
+void bod_pack_idle(void);
+void bod_pack_form_drawn(FormType *formP);
+
+/* Text being drawn while a list item is read; see WinDrawChars. */
+extern volatile int bod_pack_capturing;
+void bod_pack_capture(const UInt8 *chars, Int16 len);
+
+#endif
diff --git a/src/libpumpkin/bodui.c b/src/libpumpkin/bodui.c
new file mode 100644
index 0000000..bb0f25c
--- /dev/null
+++ b/src/libpumpkin/bodui.c
@@ -0,0 +1,885 @@
+#include <PalmOS.h>
+
+#include "sys.h"
+#include "pumpkin.h"
+#include "bodui.h"
+#include "debug.h"
+
+/* The game's own UI, kept off the screen and drawn by the host instead.
+ *
+ * Bike or Die is a Palm OS 5 application, and everything around the riding
+ * is Palm OS 5 UI: a menu bar behind the menu key, twenty-five forms, and
+ * the alerts the game puts up as it goes. On a Palm that was the machine's
+ * own look. In a window on a Mac, or on a page, it is a 320x320 postage
+ * stamp of somebody else's operating system blown up by three, and none of
+ * it can be driven the way the rest of the machine is.
+ *
+ * So none of it is drawn. The forms are still there and the game still
+ * runs them -- they are what knows what a level pack is, what the sound
+ * settings mean, which recording is which -- but their windows never reach
+ * the screen, and what is on them is published for the host, which puts up
+ * a window of its own with real controls in it. A press on one of those
+ * comes back here and goes into the form the way the pen would.
+ *
+ * Three things make that possible, and all three are already true:
+ *
+ *   - Every form draws into a bitmap of its own (FrmInitFormInternal), and
+ *     reaches the screen only by being the active window when something is
+ *     drawn -- one place, WinDirtyRegion. Dropping the form's updates there
+ *     leaves the game's last frame on the screen, untouched, with the form
+ *     live behind it.
+ *   - The form keeps working with nobody looking: the game's handlers run
+ *     on its own thread out of its own event queue, so a control pressed
+ *     from here is indistinguishable from one pressed by the pen.
+ *   - The host is already talking to this side (bodpack.c) to drive the
+ *     level pack chooser. This is the same arrangement, generalised: a
+ *     command string in, a description of what the game has on screen out,
+ *     both across a sequence number so neither thread has to take a lock.
+ *
+ * What is published, line by line. The first line is "busy" or "ready";
+ * everything after it describes the form that is up, and is a snapshot, so
+ * a host that reads it while the game is in the middle of a redraw simply
+ * reads it again (the sequence number is odd while it is being written).
+ *
+ *   form <id> <0|1 modal> <w> <h>
+ *                             the form and its size, or "form 0" when the
+ *                             game itself has the screen and there is
+ *                             nothing to show. The size matters: a Palm
+ *                             form parks the objects it is not using
+ *                             outside itself rather than hiding them
+ *   title <text>              the form's title
+ *   default <objIndex>        the button Return should press, or -1
+ *   obj <objIndex> <kind> <id> <flags> <value> <group> <link> <x> <y> <w> <h> <text>
+ *   items <objIndex> <count> <selection>
+ *   item <objIndex> <n> <text>
+ *   slider <objIndex> <value> <min> <max>
+ *
+ * `kind` is what the host draws: button, repeat, push, check, popup,
+ * selector, slider, field, list, table, label, title, gadget, scroll,
+ * bitmap or other. `flags` is 1 visible, 2 enabled, 4 the default button,
+ * 8 has the focus, 16 graphical (a control drawn as a bitmap, whose label
+ * is not worth showing). `group` is the push button group, so the host can
+ * draw a group as one control, and `link` ties a popup trigger to its list
+ * and a list back to its trigger. Text is UTF-8, converted from the game's
+ * Latin-1.
+ *
+ * The menu bar is published once, separately, since it never changes:
+ *
+ *   menu <n> <title>
+ *   mitem <n> <m> <id> <label>
+ *
+ * The commands, which arrive from the host's thread and are taken between
+ * the application's events. Several can be sent at once, a line each, and
+ * are carried out in order:
+ *
+ *   refresh              publish the form again
+ *   press <objIndex>     press a control, exactly as CtlHitControl does
+ *   value <objIndex> <n> set a checkbox or push button without pressing it
+ *   select <objIndex> <n>  choose item n of a list, or of a popup's list
+ *   text <objIndex> <s>  replace a field's text
+ *   slider <objIndex> <n>  leave a slider at n
+ *   pick <menu> <item>   pick a menu item, by its place in the menu bar
+ *   close                the form's Cancel, or its default button
+ *   pause <1|0>          hold the game still, or let it go (see below)
+ *
+ * `pause` is not queued behind the others: it takes effect the moment it is
+ * sent, so it can never overwrite a command that has not been taken yet, or
+ * be overwritten by one. While it is on and the game has the screen -- no
+ * dialog of its own up -- the application's thread waits in EvtGetEvent
+ * rather than going back to the game, and the game's clock leaves that time
+ * out (TimSkipTicks). The game does not simply stop being drawn: it stops,
+ * and carries on from the same moment. Everything else keeps working while
+ * it waits. The other commands are still taken, so a host's pause menu can
+ * open the game's dialogs and switch levels from behind it; a dialog the
+ * game puts up is not held, since it has already stopped the game itself;
+ * and the audio stream goes on, silent (SoundMgr.c).
+ *
+ * BOD_NATIVE_UI=0 turns all of it off: the forms draw where they always
+ * did, the menu key opens the Palm menu, and the host's window is the game
+ * with a title bar, as it was.
+ */
+
+#define UI_GAME_FORM   1001    /* the playfield: the one form that is drawn */
+#define UI_MENU_BAR    1000    /* the game's menu bar resource */
+
+#define UI_MAX_HIDDEN  16
+#define UI_MAX_ITEMS   256
+#define UI_ITEM_LEN    64
+#define UI_CMD_LEN     1024
+#define UI_STATUS_LEN  49152
+#define UI_MENUS_LEN   4096
+
+/* flags, as published */
+#define UI_VISIBLE     1
+#define UI_ENABLED     2
+#define UI_DEFAULT     4
+#define UI_FOCUS       8
+#define UI_GRAPHICAL   16
+
+/* ------------------------------------------------------------- on or off */
+
+static int ui_enabled = -1;
+
+int bod_ui_on(void) {
+  char *e;
+
+  if (ui_enabled < 0) {
+    e = sys_getenv("BOD_NATIVE_UI");
+    ui_enabled = (e && sys_atoi(e) == 0) ? 0 : 1;
+    debug(DEBUG_INFO, "BOD", "native UI %s", ui_enabled ? "on: the game's own menus and dialogs are not drawn" : "off");
+  }
+
+  return ui_enabled;
+}
+
+/* --------------------------------------------------------- what is hidden */
+
+/* The windows of the forms that are up and not drawn. A form is one of
+ * these from the moment it is initialised, which is before it has drawn
+ * anything, so nothing of it is ever seen. */
+static WinHandle ui_hidden[UI_MAX_HIDDEN];
+static int ui_hidden_n;
+static WinHandle ui_game_win;
+
+int bod_ui_window_hidden(WindowType *wh) {
+  /* Nothing is hidden while the game has the screen to itself, which is
+   * almost always: this is on the path of every drawing operation. */
+  if (ui_hidden_n == 0 || wh == NULL) return 0;
+
+  /* The game's own screen still goes out. So does anything drawn straight
+   * into the display: the ARM blitter's frames land there. */
+  if (wh == ui_game_win || wh == WinGetDisplayWindow()) return 0;
+
+  /* Anything else, while a hidden form is up, belongs to it -- the form
+   * itself, a list popped up over it, the menu, the bits saved behind any
+   * of them. */
+  return 1;
+}
+
+int bod_ui_form_hidden(FormType *formP) {
+  if (formP == NULL) return 0;
+
+  return bod_ui_window_hidden(&formP->window);
+}
+
+/* ------------------------------------------------------------ the channel */
+
+static char ui_cmd[UI_CMD_LEN];
+static volatile uint32_t ui_cmd_seq;
+static volatile uint32_t ui_cmd_seen;
+
+static char ui_status[UI_STATUS_LEN];
+static volatile uint32_t ui_status_seq;
+
+static char ui_menus[UI_MENUS_LEN];
+static volatile uint32_t ui_menus_seq;
+static int ui_menus_read;
+
+static int ui_busy;          /* a command is being carried out */
+
+/* --------------------------------------------------------------- pausing */
+
+static volatile int ui_pause;   /* the host wants the game held */
+volatile int bod_ui_holding;    /* the application's thread is holding it */
+
+static FormType *ui_form(void);
+
+int bod_ui_hold_wanted(void) {
+  /* A dialog of the game's has already stopped it, and is the host's to
+   * drive; holding the thread would hold the dialog too. */
+  return ui_pause && ui_form() == NULL;
+}
+
+uint32_t bod_ui_command(const char *cmd) {
+  if (cmd == NULL) return 0;
+  if (!sys_strncmp(cmd, "pause ", 6)) {
+    ui_pause = sys_atoi(cmd + 6) != 0;
+    return 0;
+  }
+  sys_strncpy(ui_cmd, cmd, UI_CMD_LEN - 1);
+  ui_cmd[UI_CMD_LEN - 1] = 0;
+  return __atomic_add_fetch(&ui_cmd_seq, 1, __ATOMIC_RELEASE);
+}
+
+/* The number bod_ui_command() handed back for the last command taken. A
+ * host that sends a second command before this has caught up with the first
+ * replaces the first, so one that cannot send both at once waits for it. */
+uint32_t bod_ui_taken(void) {
+  return __atomic_load_n(&ui_cmd_seen, __ATOMIC_ACQUIRE);
+}
+
+const char *bod_ui_state(void) {
+  return ui_status;
+}
+
+uint32_t bod_ui_seq(void) {
+  return __atomic_load_n(&ui_status_seq, __ATOMIC_ACQUIRE);
+}
+
+const char *bod_ui_menubar(void) {
+  return ui_menus;
+}
+
+uint32_t bod_ui_menubar_seq(void) {
+  return __atomic_load_n(&ui_menus_seq, __ATOMIC_ACQUIRE);
+}
+
+/* ---------------------------------------------------------------- strings */
+
+/* Palm's character set to UTF-8, `max` bytes of output including the
+ * terminator. Above 0x9F it is Latin-1; 0x80 to 0x9F is where Palm, like
+ * Windows, keeps its punctuation -- the ellipsis of "About..." is 0x85 --
+ * and mapping that range as Latin-1 would give control characters. */
+static const uint16_t ui_cp1252[32] = {
+  0x20AC, 0x0081, 0x201A, 0x0192, 0x201E, 0x2026, 0x2020, 0x2021,
+  0x02C6, 0x2030, 0x0160, 0x2039, 0x0152, 0x008D, 0x017D, 0x008F,
+  0x0090, 0x2018, 0x2019, 0x201C, 0x201D, 0x2022, 0x2013, 0x2014,
+  0x02DC, 0x2122, 0x0161, 0x203A, 0x0153, 0x009D, 0x017E, 0x0178
+};
+
+static int ui_utf8(char *out, int max, const char *s) {
+  unsigned int w;
+  unsigned char c;
+  int n = 0;
+
+  if (s == NULL) { if (max > 0) out[0] = 0; return 0; }
+
+  for (; *s && n < max - 4; s++) {
+    c = (unsigned char)*s;
+    if (c == '\n' || c == '\r' || c == '\t') c = ' ';
+    w = (c >= 0x80 && c < 0xA0) ? ui_cp1252[c - 0x80] : c;
+    if (w < 0x80) {
+      out[n++] = w;
+    } else if (w < 0x800) {
+      out[n++] = 0xC0 | (w >> 6);
+      out[n++] = 0x80 | (w & 0x3F);
+    } else {
+      out[n++] = 0xE0 | (w >> 12);
+      out[n++] = 0x80 | ((w >> 6) & 0x3F);
+      out[n++] = 0x80 | (w & 0x3F);
+    }
+  }
+  out[n] = 0;
+
+  return n;
+}
+
+/* And back, for text the host types into a field. Anything that is not a
+ * Latin-1 character the game could have had is dropped. */
+static void ui_latin1(char *out, int max, const char *s) {
+  unsigned char c;
+  int n = 0;
+
+  for (; *s && n < max - 1; s++) {
+    c = (unsigned char)*s;
+    if (c < 0x80) {
+      out[n++] = c;
+    } else if ((c & 0xE0) == 0xC0 && (s[1] & 0xC0) == 0x80) {
+      unsigned int w = ((c & 0x1F) << 6) | (s[1] & 0x3F);
+      if (w >= 0xA0 && w <= 0xFF) out[n++] = w;
+      s++;
+    } else if ((c & 0xF0) == 0xE0) {
+      s += 2;
+    } else if ((c & 0xF8) == 0xF0) {
+      s += 3;
+    }
+  }
+  out[n] = 0;
+}
+
+/* --------------------------------------------------- reading a list's items */
+
+/* Bike or Die draws its list items itself -- a level's name and its best
+ * time are made up as the row is drawn -- so the only way to read one is to
+ * draw it where nobody can see it and keep what it writes. */
+volatile int bod_ui_capturing;
+static char ui_items[UI_MAX_ITEMS][UI_ITEM_LEN];
+static int ui_item_count;
+static int ui_item_at = -1;
+
+/* An item is drawn in pieces -- a name here, a time there -- and comes back
+ * with the gaps between them at its ends. */
+static void ui_trim(char *s) {
+  int n = sys_strlen(s), i = 0;
+
+  while (n > 0 && (unsigned char)s[n-1] <= ' ') s[--n] = 0;
+  while (s[i] && (unsigned char)s[i] <= ' ') i++;
+  if (i) sys_memmove(s, s + i, n - i + 1);
+}
+
+void bod_ui_capture(const unsigned char *chars, int len) {
+  char *item;
+  int n, i;
+
+  if (ui_item_at < 0 || ui_item_at >= UI_MAX_ITEMS) return;
+  item = ui_items[ui_item_at];
+  n = sys_strlen(item);
+  if (n && n < UI_ITEM_LEN - 1) item[n++] = ' ';
+  for (i = 0; i < len && n < UI_ITEM_LEN - 1; i++) item[n++] = chars[i];
+  item[n] = 0;
+}
+
+static int ui_read_items(ListType *list) {
+  WinHandle off, old;
+  RectangleType rect;
+  FontID font;
+  Int16 dy;
+  UInt16 err;
+  int i;
+
+  ui_item_count = 0;
+  if (list == NULL || list->numItems <= 0) return 0;
+
+  ui_item_count = list->numItems < UI_MAX_ITEMS ? list->numItems : UI_MAX_ITEMS;
+
+  /* An ordinary list keeps its items as strings. They are read through
+   * LstGetSelectionText and not out of itemsText: in a 68k application that
+   * array holds addresses in the emulated machine's memory, not pointers
+   * this side can follow. */
+  if (list->m68k_drawfunc == 0 && list->drawItemsCallback == NULL) {
+    for (i = 0; i < ui_item_count; i++) {
+      const Char *text = LstGetSelectionText(list, i);
+
+      ui_items[i][0] = 0;
+      if (text) {
+        sys_strncpy(ui_items[i], text, UI_ITEM_LEN - 1);
+        ui_trim(ui_items[i]);
+      }
+    }
+    return ui_item_count;
+  }
+
+  font = FntSetFont(list->font);
+  dy = FntCharHeight();
+  FntSetFont(font);
+
+  if ((off = WinCreateOffscreenWindow(list->bounds.extent.x, dy, nativeFormat, &err)) == NULL) {
+    ui_item_count = 0;
+    return 0;
+  }
+  old = WinSetDrawWindow(off);
+
+  for (i = 0; i < ui_item_count; i++) {
+    ui_items[i][0] = 0;
+    RctSetRectangle(&rect, 1, 0, list->bounds.extent.x - 2, dy);
+    ui_item_at = i;
+    bod_ui_capturing = 1;
+    if (list->m68k_drawfunc) {
+      CallListDrawItem(list->m68k_drawfunc, i, &rect, list->itemsText);
+    } else {
+      list->drawItemsCallback(i, &rect, list->itemsText);
+    }
+    bod_ui_capturing = 0;
+    ui_item_at = -1;
+    if (ui_items[i][0] == 0) sys_snprintf(ui_items[i], UI_ITEM_LEN, "(item %d)", i + 1);
+    else ui_trim(ui_items[i]);
+  }
+
+  WinSetDrawWindow(old);
+  WinDeleteWindow(off, false);
+  FntSetFont(font);
+
+  return ui_item_count;
+}
+
+/* ------------------------------------------------------- describing a form */
+
+static const char *ui_control_kind(const ControlType *ctl) {
+  switch (ctl->style) {
+    case buttonCtl:          return "button";
+    case pushButtonCtl:      return "push";
+    case checkboxCtl:        return "check";
+    case popupTriggerCtl:    return "popup";
+    case selectorTriggerCtl: return "selector";
+    case repeatingButtonCtl: return "repeat";
+    case sliderCtl:
+    case feedbackSliderCtl:  return "slider";
+    default:                 return "other";
+  }
+}
+
+/* One object, and for a list the items behind it. */
+static int ui_put_object(char *out, int max, FormType *formP, UInt16 i) {
+  const ControlType *ctl;
+  const FieldType *fld;
+  const ListType *list;
+  RectangleType rect;
+  const char *kind = NULL, *text = NULL;
+  int flags = 0, value = 0, group = 0, link = 0;
+  int n = 0, j;
+
+  MemSet(&rect, sizeof(RectangleType), 0);
+  FrmGetObjectBounds(formP, i, &rect);
+
+  switch (FrmGetObjectType(formP, i)) {
+    case frmControlObj:
+      ctl = (const ControlType *)FrmGetObjectPtr(formP, i);
+      if (ctl == NULL) return 0;
+      kind = ui_control_kind(ctl);
+      text = CtlGetLabel(ctl);
+      /* Whether a checkbox is ticked or a push button is the one down in its
+       * group; `selected` is only the highlight while the pen is on it. */
+      value = ctl->attr.on ? 1 : 0;
+      group = ctl->group;
+      link = ctl->listID;
+      if (ctl->attr.visible) flags |= UI_VISIBLE;
+      if (ctl->attr.usable && ctl->attr.enabled) flags |= UI_ENABLED;
+      if (ctl->attr.graphical) flags |= UI_GRAPHICAL;
+      break;
+
+    case frmFieldObj:
+      fld = (const FieldType *)FrmGetObjectPtr(formP, i);
+      if (fld == NULL) return 0;
+      kind = "field";
+      text = FldGetTextPtr((FieldType *)fld);
+      /* A field the game only writes into -- the time a level was finished
+       * in, say -- is text, not somewhere to type. */
+      if (fld->attr.visible) flags |= UI_VISIBLE;
+      if (fld->attr.editable) flags |= UI_ENABLED;
+      break;
+
+    case frmListObj:
+      list = (const ListType *)FrmGetObjectPtr(formP, i);
+      if (list == NULL) return 0;
+      kind = "list";
+      value = list->currentItem;
+      link = list->controlID;
+      if (list->attr.visible) flags |= UI_VISIBLE;
+      flags |= UI_ENABLED;
+      break;
+
+    case frmLabelObj:
+      kind = "label";
+      /* Not FrmGetLabel: that finds a label by its id, and the game has
+       * several with no id of their own. */
+      text = formP->objects[i].object.label ? formP->objects[i].object.label->text : NULL;
+      if (formP->objects[i].object.label && formP->objects[i].object.label->attr.visible) flags |= UI_VISIBLE;
+      break;
+
+    case frmTitleObj:
+      kind = "title";
+      text = FrmGetTitle(formP);
+      flags |= UI_VISIBLE;
+      break;
+
+    case frmTableObj:   kind = "table";  flags |= UI_VISIBLE | UI_ENABLED; break;
+    case frmScrollBarObj: kind = "scroll"; break;
+    case frmBitmapObj:  kind = "bitmap"; break;
+    case frmGadgetObj:  kind = "gadget"; break;
+    default:
+      return 0;
+  }
+
+  if (formP->defaultButton && FrmGetObjectId(formP, i) == formP->defaultButton) flags |= UI_DEFAULT;
+  if (formP->focus == i) flags |= UI_FOCUS;
+
+  n += sys_snprintf(out + n, max - n, "obj %u %s %u %d %d %d %d %d %d %d %d ",
+                    i, kind, FrmGetObjectId(formP, i), flags, value, group, link,
+                    rect.topLeft.x, rect.topLeft.y, rect.extent.x, rect.extent.y);
+  n += ui_utf8(out + n, max - n, text);
+  n += sys_snprintf(out + n, max - n, "\n");
+
+  /* A slider is a range, not a state: what it is set to and what it may be. */
+  if (!sys_strcmp(kind, "slider")) {
+    UInt16 lo = 0, hi = 0, page = 0, at = 0;
+
+    CtlGetSliderValues((const ControlType *)FrmGetObjectPtr(formP, i), &lo, &hi, &page, &at);
+    n += sys_snprintf(out + n, max - n, "slider %u %d %d %d\n", i, at, lo, hi);
+  }
+
+  if (FrmGetObjectType(formP, i) == frmListObj) {
+    list = (const ListType *)FrmGetObjectPtr(formP, i);
+    ui_read_items((ListType *)list);
+    n += sys_snprintf(out + n, max - n, "items %u %d %d\n", i, ui_item_count, list->currentItem);
+    for (j = 0; j < ui_item_count && n < max - UI_ITEM_LEN * 2 - 32; j++) {
+      n += sys_snprintf(out + n, max - n, "item %u %d ", i, j);
+      n += ui_utf8(out + n, max - n, ui_items[j]);
+      n += sys_snprintf(out + n, max - n, "\n");
+    }
+  }
+
+  return n;
+}
+
+/* The form the host should be showing: the one that is up, unless it is
+ * the game itself. */
+static FormType *ui_form(void) {
+  FormType *formP = FrmGetActiveForm();
+
+  if (formP == NULL || formP->formId == UI_GAME_FORM) return NULL;
+
+  return formP;
+}
+
+static void ui_publish(void) {
+  FormType *formP = ui_form();
+  UInt16 i, count;
+  int n = 0;
+
+  /* Odd while the text is being written, so a torn read is noticed. */
+  __atomic_add_fetch(&ui_status_seq, 1, __ATOMIC_RELEASE);
+
+  n += sys_snprintf(ui_status + n, UI_STATUS_LEN - n, "%s\n", ui_busy ? "busy" : "ready");
+
+  if (formP == NULL) {
+    n += sys_snprintf(ui_status + n, UI_STATUS_LEN - n, "form 0\n");
+  } else {
+    n += sys_snprintf(ui_status + n, UI_STATUS_LEN - n, "form %u %d %d %d\n",
+                      formP->formId, formP->window.windowFlags.modal ? 1 : 0,
+                      formP->window.windowBounds.extent.x, formP->window.windowBounds.extent.y);
+    n += sys_snprintf(ui_status + n, UI_STATUS_LEN - n, "title ");
+    n += ui_utf8(ui_status + n, UI_STATUS_LEN - n, FrmGetTitle(formP));
+    n += sys_snprintf(ui_status + n, UI_STATUS_LEN - n, "\n");
+    n += sys_snprintf(ui_status + n, UI_STATUS_LEN - n, "default %d\n",
+                      formP->defaultButton ? (int)FrmGetObjectIndex(formP, formP->defaultButton) : -1);
+
+    count = FrmGetNumberOfObjects(formP);
+    for (i = 0; i < count && n < UI_STATUS_LEN - 4096; i++) {
+      n += ui_put_object(ui_status + n, UI_STATUS_LEN - n, formP, i);
+    }
+  }
+
+  __atomic_add_fetch(&ui_status_seq, 1, __ATOMIC_RELEASE);
+}
+
+/* ------------------------------------------------------------ the menu bar */
+
+/* The game's menu bar, read once out of its MBAR resource. The host builds
+ * its own menu from it, so the items are named by where they are rather
+ * than by their labels: two of Bike or Die's are called "Control" and
+ * three "Hall of Fame". */
+static void ui_read_menus(void) {
+  MenuBarType *mbar;
+  MemHandle h;
+  int n = 0, i, j;
+
+  if (ui_menus_read) return;
+  if ((h = DmGetResource(MenuRscType, UI_MENU_BAR)) == NULL) return;
+
+  if ((mbar = MemHandleLock(h)) != NULL) {
+    __atomic_add_fetch(&ui_menus_seq, 1, __ATOMIC_RELEASE);
+
+    for (i = 0; i < mbar->numMenus && n < UI_MENUS_LEN - 256; i++) {
+      n += sys_snprintf(ui_menus + n, UI_MENUS_LEN - n, "menu %d ", i);
+      n += ui_utf8(ui_menus + n, UI_MENUS_LEN - n, mbar->menus[i].title);
+      n += sys_snprintf(ui_menus + n, UI_MENUS_LEN - n, "\n");
+
+      for (j = 0; j < mbar->menus[i].numItems && n < UI_MENUS_LEN - 128; j++) {
+        if (mbar->menus[i].items[j].itemStr == NULL) continue;
+        n += sys_snprintf(ui_menus + n, UI_MENUS_LEN - n, "mitem %d %d %u ", i, j, mbar->menus[i].items[j].id);
+        n += ui_utf8(ui_menus + n, UI_MENUS_LEN - n, mbar->menus[i].items[j].itemStr);
+        n += sys_snprintf(ui_menus + n, UI_MENUS_LEN - n, "\n");
+      }
+    }
+
+    ui_menus_read = 1;
+    __atomic_add_fetch(&ui_menus_seq, 1, __ATOMIC_RELEASE);
+    MemHandleUnlock(h);
+    debug(DEBUG_INFO, "BOD", "native UI: read the game's menu bar, %d menus", mbar->numMenus);
+  }
+
+  DmReleaseResource(h);
+}
+
+/* The item id at (menu, item) of the game's own menu bar. */
+static UInt16 ui_menu_item(int menu, int item) {
+  MenuBarType *mbar;
+  MemHandle h;
+  UInt16 id = 0;
+
+  if ((h = DmGetResource(MenuRscType, UI_MENU_BAR)) == NULL) return 0;
+  if ((mbar = MemHandleLock(h)) != NULL) {
+    if (menu >= 0 && menu < mbar->numMenus && item >= 0 && item < mbar->menus[menu].numItems) {
+      id = mbar->menus[menu].items[item].id;
+    }
+    MemHandleUnlock(h);
+  }
+  DmReleaseResource(h);
+
+  return id;
+}
+
+/* -------------------------------------------------------------- commands */
+
+static FormType *ui_command_form(void) {
+  FormType *formP = ui_form();
+
+  if (formP == NULL) debug(DEBUG_INFO, "BOD", "native UI: no dialog is up");
+
+  return formP;
+}
+
+static void ui_press(FormType *formP, UInt16 i) {
+  ControlType *ctl;
+  EventType event;
+
+  if (FrmGetObjectType(formP, i) != frmControlObj) return;
+  if ((ctl = (ControlType *)FrmGetObjectPtr(formP, i)) == NULL) return;
+
+  /* A pen changes a checkbox or a push button as it goes down on it
+   * (ctlEnterEvent in Control.c), and the game reads the new value when it
+   * hears the ctlSelectEvent that follows. CtlHitControl is only the second
+   * half, so on its own a checkbox would never tick. */
+  if (ctl->style == checkboxCtl || ctl->style == pushButtonCtl) {
+    if (!ctl->attr.usable || !ctl->attr.enabled) return;
+    if (ctl->style == checkboxCtl) {
+      CtlUpdateCheckboxGroup(ctl, !ctl->attr.on);
+    } else if (!ctl->group || !ctl->attr.on) {
+      CtlUpdateGroup(ctl, !ctl->attr.on);
+    }
+    MemSet(&event, sizeof(EventType), 0);
+    event.eType = ctlSelectEvent;
+    event.data.ctlSelect.controlID = ctl->id;
+    event.data.ctlSelect.pControl = ctl;
+    event.data.ctlSelect.on = ctl->style == checkboxCtl ? ctl->attr.on : false;
+    EvtAddEventToQueue(&event);
+    return;
+  }
+
+  CtlHitControl(ctl);
+}
+
+/* Choosing an item of a list, the way the five-way navigator does it: the
+ * game hears a popSelectEvent for a popup's list and an lstSelectEvent for
+ * a plain one, which is what its handlers are written against. */
+static void ui_select(FormType *formP, UInt16 i, Int16 sel) {
+  EventType event;
+  ListType *list;
+
+  if (FrmGetObjectType(formP, i) != frmListObj) return;
+  if ((list = (ListType *)FrmGetObjectPtr(formP, i)) == NULL) return;
+  if (sel < 0 || sel >= list->numItems) return;
+
+  LstSetSelection(list, sel);
+  LstMakeItemVisible(list, sel);
+  if (list->attr.visible) LstDrawList(list);
+
+  MemSet(&event, sizeof(EventType), 0);
+  if (list->controlID) {
+    event.eType = popSelectEvent;
+    event.data.popSelect.listID = list->id;
+    event.data.popSelect.listP = list;
+    event.data.popSelect.selection = sel;
+    event.data.popSelect.priorSelection = list->currentItem;
+    event.data.popSelect.controlID = list->controlID;
+    event.data.popSelect.controlP = FrmGetObjectPtr(formP, FrmGetObjectIndex(formP, list->controlID));
+  } else {
+    event.eType = lstSelectEvent;
+    event.data.lstSelect.listID = list->id;
+    event.data.lstSelect.pList = list;
+    event.data.lstSelect.selection = sel;
+  }
+  list->currentItem = sel;
+  EvtAddEventToQueue(&event);
+}
+
+/* Moving a slider, the way letting go of it over the control does: the game
+ * hears one ctlSelectEvent carrying the value it was left at. */
+static void ui_slider(FormType *formP, UInt16 i, Int16 value) {
+  ControlType *ctl;
+  EventType event;
+  UInt16 lo = 0, hi = 0, at;
+
+  if (FrmGetObjectType(formP, i) != frmControlObj) return;
+  if ((ctl = (ControlType *)FrmGetObjectPtr(formP, i)) == NULL) return;
+  if (ctl->style != sliderCtl && ctl->style != feedbackSliderCtl) return;
+
+  CtlGetSliderValues(ctl, &lo, &hi, NULL, NULL);
+  if (value < (Int16)lo) value = lo;
+  if (value > (Int16)hi) value = hi;
+  at = value;
+  CtlSetSliderValues(ctl, NULL, NULL, NULL, &at);
+
+  MemSet(&event, sizeof(EventType), 0);
+  event.eType = ctlSelectEvent;
+  event.data.ctlSelect.controlID = ctl->id;
+  event.data.ctlSelect.pControl = ctl;
+  event.data.ctlSelect.value = at;
+  EvtAddEventToQueue(&event);
+}
+
+static void ui_text(FormType *formP, UInt16 i, const char *utf8) {
+  char latin1[UI_CMD_LEN];
+  FieldType *fld;
+
+  if (FrmGetObjectType(formP, i) != frmFieldObj) return;
+  if ((fld = (FieldType *)FrmGetObjectPtr(formP, i)) == NULL) return;
+
+  ui_latin1(latin1, sizeof(latin1), utf8);
+  FrmSetFocus(formP, i);
+  FldDelete(fld, 0, FldGetTextLength(fld));
+  FldInsert(fld, latin1, sys_strlen(latin1));
+}
+
+/* The way out of a dialog: what the player would press to leave it alone. */
+static void ui_close(FormType *formP) {
+  static const char *ways[] = { "Cancel", "Close", "Done", "No", "OK", NULL };
+  const ControlType *ctl;
+  const Char *label;
+  UInt16 i, count;
+  int w;
+
+  count = FrmGetNumberOfObjects(formP);
+  for (w = 0; ways[w]; w++) {
+    for (i = 0; i < count; i++) {
+      if (FrmGetObjectType(formP, i) != frmControlObj) continue;
+      if ((ctl = (const ControlType *)FrmGetObjectPtr(formP, i)) == NULL || !ctl->attr.visible) continue;
+      if (ctl->style != buttonCtl) continue;
+      if ((label = CtlGetLabel(ctl)) != NULL && !sys_strcmp(label, ways[w])) {
+        CtlHitControl(ctl);
+        return;
+      }
+    }
+  }
+
+  if (formP->defaultButton) {
+    i = FrmGetObjectIndex(formP, formP->defaultButton);
+    if (i != frmInvalidObjectId) ui_press(formP, i);
+  }
+}
+
+static void ui_run_command(char *cmd) {
+  FormType *formP;
+  EventType event;
+  UInt16 id;
+  int a = 0, b = 0;
+  char *arg;
+
+  debug(DEBUG_INFO, "BOD", "native UI: command \"%s\"", cmd);
+
+  if (!sys_strcmp(cmd, "refresh")) {
+    /* published below */
+
+  } else if (!sys_strncmp(cmd, "press ", 6)) {
+    if ((formP = ui_command_form()) != NULL) ui_press(formP, sys_atoi(cmd + 6));
+
+  } else if (!sys_strncmp(cmd, "value ", 6)) {
+    arg = cmd + 6;
+    a = sys_atoi(arg);
+    while (*arg && *arg != ' ') arg++;
+    b = sys_atoi(arg);
+    if ((formP = ui_command_form()) != NULL && FrmGetObjectType(formP, a) == frmControlObj) {
+      CtlSetValue((ControlType *)FrmGetObjectPtr(formP, a), b);
+    }
+
+  } else if (!sys_strncmp(cmd, "select ", 7)) {
+    arg = cmd + 7;
+    a = sys_atoi(arg);
+    while (*arg && *arg != ' ') arg++;
+    b = sys_atoi(arg);
+    if ((formP = ui_command_form()) != NULL) ui_select(formP, a, b);
+
+  } else if (!sys_strncmp(cmd, "text ", 5)) {
+    arg = cmd + 5;
+    a = sys_atoi(arg);
+    while (*arg && *arg != ' ') arg++;
+    if (*arg) arg++;
+    if ((formP = ui_command_form()) != NULL) ui_text(formP, a, arg);
+
+  } else if (!sys_strncmp(cmd, "pick ", 5)) {
+    arg = cmd + 5;
+    a = sys_atoi(arg);
+    while (*arg && *arg != ' ') arg++;
+    b = sys_atoi(arg);
+    if ((id = ui_menu_item(a, b)) != 0) {
+      MemSet(&event, sizeof(EventType), 0);
+      event.eType = menuEvent;
+      event.data.menu.itemID = id;
+      EvtAddEventToQueue(&event);
+    } else {
+      debug(DEBUG_ERROR, "BOD", "native UI: no menu item %d/%d", a, b);
+    }
+
+  } else if (!sys_strncmp(cmd, "slider ", 7)) {
+    arg = cmd + 7;
+    a = sys_atoi(arg);
+    while (*arg && *arg != ' ') arg++;
+    b = sys_atoi(arg);
+    if ((formP = ui_command_form()) != NULL) ui_slider(formP, a, b);
+
+  } else if (!sys_strcmp(cmd, "close")) {
+    if ((formP = ui_command_form()) != NULL) ui_close(formP);
+
+  } else if (cmd[0]) {
+    debug(DEBUG_ERROR, "BOD", "native UI: unknown command \"%s\"", cmd);
+  }
+}
+
+/* There is one slot, and a command sent before the one in it was taken
+ * replaces it. So a host that means two things at once -- choose this item,
+ * then press the default button -- sends them together, a line each, and
+ * they are carried out in order. */
+static void ui_take_command(void) {
+  uint32_t seq = __atomic_load_n(&ui_cmd_seq, __ATOMIC_ACQUIRE);
+  char cmd[UI_CMD_LEN], *line, *next;
+
+  if (seq == ui_cmd_seen) return;
+  ui_cmd_seen = seq;
+  sys_strncpy(cmd, ui_cmd, UI_CMD_LEN - 1);
+  cmd[UI_CMD_LEN - 1] = 0;
+
+  ui_busy = 1;
+
+  for (line = cmd; line; line = next) {
+    if ((next = sys_strchr(line, '\n')) != NULL) *next++ = 0;
+    ui_run_command(line);
+  }
+
+  /* What the commands did lands in the game's event queue; the form as it
+   * will be is published when it next draws. This is the acknowledgement. */
+  ui_busy = 0;
+  ui_publish();
+}
+
+/* ----------------------------------------------------------- the hooks */
+
+void bod_ui_form_init(FormType *formP) {
+  if (formP == NULL) return;
+
+  if (formP->formId == UI_GAME_FORM) {
+    ui_game_win = &formP->window;
+    return;
+  }
+
+  if (!bod_ui_on()) return;
+
+  if (ui_hidden_n < UI_MAX_HIDDEN) {
+    ui_hidden[ui_hidden_n++] = &formP->window;
+    debug(DEBUG_TRACE, "BOD", "native UI: form %d is up and not drawn", formP->formId);
+  } else {
+    debug(DEBUG_ERROR, "BOD", "native UI: more than %d forms at once; form %d is drawn", UI_MAX_HIDDEN, formP->formId);
+  }
+}
+
+void bod_ui_form_delete(FormType *formP) {
+  int i;
+
+  if (formP == NULL) return;
+  if (&formP->window == ui_game_win) ui_game_win = NULL;
+
+  for (i = 0; i < ui_hidden_n; i++) {
+    if (ui_hidden[i] == &formP->window) {
+      ui_hidden[i] = ui_hidden[--ui_hidden_n];
+      break;
+    }
+  }
+
+  if (bod_ui_on()) ui_publish();
+}
+
+void bod_ui_form_drawn(FormType *formP) {
+  if (formP == NULL || !bod_ui_on()) return;
+  ui_publish();
+}
+
+void bod_ui_idle(void) {
+  if (!bod_ui_on()) return;
+  ui_read_menus();
+  ui_take_command();
+}
+
+int bod_ui_swallow_menu_key(void) {
+  /* The native menu bar is the game's menu bar: the Palm one behind the
+   * menu key would only be the same items, drawn small and hidden. */
+  return bod_ui_on();
+}
diff --git a/src/libpumpkin/bodui.h b/src/libpumpkin/bodui.h
new file mode 100644
index 0000000..db796c9
--- /dev/null
+++ b/src/libpumpkin/bodui.h
@@ -0,0 +1,54 @@
+#ifndef BODUI_H
+#define BODUI_H
+
+#include <stdint.h>
+
+/* The game's own UI, kept off the screen and mirrored to the host.
+ * bodui.c describes all of it. */
+
+/* Whether the native front is on at all (BOD_NATIVE_UI, default 1). */
+int bod_ui_on(void);
+
+/* The host's side: a command in, a description of what the game has on
+ * screen out. Both may be called from another thread. A command is
+ * numbered, and bod_ui_taken() says which one the game has taken last. */
+uint32_t bod_ui_command(const char *cmd);
+uint32_t bod_ui_taken(void);
+const char *bod_ui_state(void);
+uint32_t bod_ui_seq(void);
