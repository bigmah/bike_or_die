+#ifndef LIBLSDL2_SCREEN_H
+#define LIBLSDL2_SCREEN_H
+
+/* The native window's screen: the game's frame, composited on the CPU and
+ * upscaled to the resolution of the display the window is on. See
+ * liblsdl2_screen.c. */
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SCREEN_PIXELS 0   /* nearest-neighbour squares, as the Palm showed them */
+#define SCREEN_SMOOTH 1   /* bilinear */
+#define SCREEN_XBR    2   /* xBR, the edges redrawn at the display's resolution */
+
+/* The largest factor xBR is run at; a bigger screen is scaled up from that. */
+#define SCREEN_MAX_FACTOR 8
+
+int  screen_mode_named(const char *name);    /* -1 if it is not one */
+const char *screen_mode_name(int mode);
+
+int  screen_init(int width, int height);
+void screen_finish(void);
+uint32_t *screen_frame(int *width, int *height);
+void screen_fill(uint32_t argb);
+void screen_blit(uint32_t *src, int src_width, int src_height, int sx, int sy, int w, int h, int dx, int dy);
+
+/* ARGB8888 in, ARGB8888 out, n times the size in each direction; dst_stride is
+ * in pixels. xbr() matches the shader the browser build draws with, sampled at
+ * the centre of each output pixel; nearest() is the pixels mode's first half
+ * when the display is not a whole multiple of the frame. */
+void screen_xbr(const uint32_t *src, int width, int height, uint32_t *dst, int dst_stride, int n);
+void screen_nearest(const uint32_t *src, int width, int height, uint32_t *dst, int dst_stride, int n);
+
+#ifdef __cplusplus
+}
