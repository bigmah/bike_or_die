diff --git a/src/emscripten/Makefile b/src/emscripten/Makefile
index 4114db6..30e6dcf 100644
--- a/src/emscripten/Makefile
+++ b/src/emscripten/Makefile
@@ -4,16 +4,63 @@ include ../common.mak
 
 PROGRAM=pumpkin
 
+# The statically recompiled game code, built by `make -C src WASM=1`.
+BOD=$(PUMPKINOS)/../..
+RECOMP=$(BOD)/build/librecomp-wasm.a
+
 SOURCE=main.c
 OBJS=$(SOURCE:%.c=%.wasm)
 MODULES=libpit.a libpumpkin.a libscriptlua.a liblsdl2.a libos.a
 
+# PumpkinOS runs the OS, the application and the audio mixer on threads of
+# their own, so the pool has to be deep enough for all of them at once, and
+# the recompiled chunks are large functions that want a real stack.
+# The OS itself stays on the browser's main thread: SDL reaches WebGL through
+# EGL, whose calls Emscripten proxies to that thread unconditionally, so a
+# renderer created anywhere else has no context to draw with.
+# The memory is fixed rather than growable: growing a shared memory is both
+# slow and, in Chrome, fatal to the tab here, and 384 MB comfortably holds the
+# 64 MB system heap, the 8 MB the application gets and the packaged VFS.
+LINKFLAGS=-O1 -pthread \
+  -s USE_SDL=2 \
+  -s ENVIRONMENT=web,worker \
+  -s INITIAL_MEMORY=402653184 \
+  -s STACK_SIZE=8388608 -s DEFAULT_PTHREAD_STACK_SIZE=8388608 \
+  -s PROXY_TO_PTHREAD=1 -s PTHREAD_POOL_SIZE=8 \
+  -s EXPORTED_FUNCTIONS=_main,_cexit,_pumpkin_send_deploy,_bod_reset_saves \
+  -s EXPORTED_RUNTIME_METHODS=ccall,stringToNewUTF8,FS \
+  -s INCOMING_MODULE_JS_API=canvas,print,printErr,setStatus,preRun,postRun,onRuntimeInitialized,locateFile,mainScriptUrlOrBlob \
+  -s EXIT_RUNTIME \
+  -s WASMFS=1
+
+# e.g. EXTRA_LINKFLAGS="-sASSERTIONS=1 -g2" for a debuggable build.
+EXTRA_LINKFLAGS?=
+
+# Both preloaded trees are read-only, so /vfs -- the one PumpkinOS runs from --
+# is assembled at startup out of /boot (the script it boots from) and /pristine
+# (the game and its level packs), which is also where a first visit fills the
+# writable half from. WasmFS keeps the filesystem inside the wasm module, so a thread
+# opening a file does not have to go through the browser's main thread, and it
+# is what provides the OPFS backend the writable half is kept in.
+PRELOAD=--preload-file vfs@/boot --preload-file $(PUMPKINOS)/vfs@/pristine
+
 $(PROGRAM).zip: $(PROGRAM).html coi-serviceworker.js
 	zip $(PROGRAM).zip $(PROGRAM).wasm $(PROGRAM).data $(PROGRAM).html $(PROGRAM).js coi-serviceworker.js
 
-$(PROGRAM).html: $(OBJS) $(MODULES) template.html vfs/pumpkin.lua
-	$(EM_CC) -o $(PROGRAM).js -s ALLOW_MEMORY_GROWTH=1 -s USE_SDL=2 -s ENVIRONMENT=web,worker -s PTHREAD_POOL_SIZE=4 -s EXPORTED_FUNCTIONS=_main,_cmain,_cexit,_pumpkin_send_deploy -s EXPORTED_RUNTIME_METHODS=ccall -s EXIT_RUNTIME -pthread -lidbfs.js --preload-file vfs $(OBJS) $(MODULES)
+# The shared CFLAGS say -ffreestanding, under which clang does not treat main
+# as special and so does not emit the __main_argc_argv entry point that
+# PROXY_TO_PTHREAD's startup object calls.
+main.wasm: main.c
+	@echo Compiling $<
+	@$(EM_CC) $(CFLAGS) -fhosted -c -o $@ $<
+
+$(PROGRAM).html: $(OBJS) $(MODULES) $(RECOMP) template.html bod-pre.js vfs/pumpkin.lua
+	@echo Linking $(PROGRAM).js
+	$(EM_CC) -o $(PROGRAM).js $(LINKFLAGS) $(EXTRA_LINKFLAGS) --pre-js bod-pre.js $(PRELOAD) $(OBJS) $(MODULES) $(RECOMP)
 	cp template.html $(PROGRAM).html
 
+serve: $(PROGRAM).html
+	@python3 $(BOD)/tools/webserver.py 8080 .
+
 clean:
 	rm -f $(OBJS) $(PROGRAM).zip $(PROGRAM).wasm $(PROGRAM).data $(PROGRAM).html $(PROGRAM).js
diff --git a/src/emscripten/bod-pre.js b/src/emscripten/bod-pre.js
new file mode 100644
index 0000000..7be454e
--- /dev/null
+++ b/src/emscripten/bod-pre.js
@@ -0,0 +1,53 @@
+// Browser-side setup for the Bike or Die 2 WebAssembly build: the environment
+// that tools/make_app.sh exports around the native one, and the page's half of
+// the saved data.
+
+// What tools/make_app.sh exports before running pumpkin. Anything here can be
+// overridden from the page (window.BOD_ENV) or the query string (?user=Me).
+var bodDefaultEnv = {
+  PUMPKIN_DISPLAY_LE: '1',    // the game's ARM blitter writes little-endian RGB565
+  PUMPKIN_SOUND:      '1',
+  PUMPKIN_VOLUME:     '64',   // PumpkinOS defaults the Palm volumes to 0
+  PUMPKIN_USER:       'PalmDB',
+  BOD_RECOMP:         '1',
+  BOD_ARM_ENGINE:     'recomp',
+  BOD_ZOOM:           '1'     // the page scales the canvas, not the game
+};
+
+// Returned to C as "KEY=VALUE\n..." and applied with setenv, so that the value
+// lives in the wasm heap where every thread can read it.
+function bodEnvString() {
+  var env = {}, k;
+  for (k in bodDefaultEnv) env[k] = bodDefaultEnv[k];
+  if (typeof self !== 'undefined' && self.BOD_ENV) {
+    for (k in self.BOD_ENV) env[k] = String(self.BOD_ENV[k]);
+  }
+  try {
+    // main() runs on a thread of its own, where there is no page to ask -- but
+    // the page passes its own query string on to the workers' script URL, so
+    // self.location has it in both places.
+    var q = new URLSearchParams(self.location.search);
+    if (q.get('user')) env.PUMPKIN_USER = q.get('user');
+    if (q.get('sound') !== null) env.PUMPKIN_SOUND = q.get('sound') === '0' ? '0' : '1';
+    q.forEach(function (v, n) {
+      if (n.indexOf('BOD_') === 0 || n.indexOf('PUMPKIN_') === 0) env[n] = v;
+    });
+  } catch (e) { /* no query string is fine */ }
+  var out = '';
+  for (k in env) out += k + '=' + env[k] + '\n';
+  return out;
+}
+
+// Everything the game writes is kept by the wasm side (see main.c); the page
+// only has to hold main() back until the runtime is up, and to offer a way to
+// throw the saved data away.
+var Module = typeof Module != 'undefined' ? Module : {};
+
+function bodReset() {
+  try {
+    Module.ccall('bod_reset_saves', null, null, null);
+  } catch (e) {
+    console.warn('could not clear the saved data:', e);
+  }
+  window.location.reload();
+}
diff --git a/src/emscripten/main.c b/src/emscripten/main.c
index ea74bb2..6fe5735 100644
--- a/src/emscripten/main.c
+++ b/src/emscripten/main.c
@@ -1,8 +1,260 @@
 #include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <dirent.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/stat.h>
+#include <errno.h>
 #include <emscripten.h>
+#include <emscripten/wasmfs.h>
+#include <pthread.h>
+#include <time.h>
 
 #include "main.h"
 
+/* The tree PumpkinOS writes to. The packaged copy of it is mounted read-only
+ * at /pristine and these are filled from it once, the way the native launcher
+ * copies its VFS into Application Support the first time it runs. */
+#define VFS_DIR      "/vfs"
+#define BOOT_DIR     "/boot"
+#define PRISTINE_DIR "/pristine"
+
+static char pbuf[1024], qbuf[1024];
+
+/* The launcher script exports a handful of variables before running pumpkin
+ * (display byte order, sound, the HotSync user the registration code is keyed
+ * to). The page decides them here; apply them with setenv so they live in the
+ * wasm heap, which every thread shares, rather than in the main thread's JS. */
+static void apply_env(void) {
+  char *env, *line, *next, *eq;
+
+  env = (char *)EM_ASM_PTR({ return stringToNewUTF8(bodEnvString()); });
+  if (env == NULL) return;
+
+  for (line = env; line && *line; line = next) {
+    next = strchr(line, '\n');
+    if (next) *next++ = 0;
+    if ((eq = strchr(line, '=')) == NULL) continue;
+    *eq = 0;
+    setenv(line, eq + 1, 1);
+  }
+
+  free(env);
+}
+
+static int copy_file(const char *src, const char *dst) {
+  char buf[16384];
+  ssize_t n;
+  int in, out, r = -1;
+
+  if ((in = open(src, O_RDONLY)) < 0) return -1;
+  if ((out = open(dst, O_WRONLY | O_CREAT | O_TRUNC, 0666)) >= 0) {
+    r = 0;
+    while ((n = read(in, buf, sizeof(buf))) > 0) {
+      if (write(out, buf, n) != n) { r = -1; break; }
+    }
+    if (n < 0) r = -1;
+    close(out);
+  }
+  close(in);
+
+  return r;
+}
+
+/* Depth-first copy; the storage tree is two levels deep, so recursion is
+ * bounded by the path buffers rather than by anything the tree can do. */
+static int copy_tree(const char *src, const char *dst, int *files) {
+  struct dirent *ent;
+  struct stat st;
+  DIR *d;
+  int r = 0;
+
+  if ((d = opendir(src)) == NULL) return -1;   /* nothing saved yet */
+  mkdir(dst, 0777);
+
+  while ((ent = readdir(d)) != NULL) {
+    if (!strcmp(ent->d_name, ".") || !strcmp(ent->d_name, "..")) continue;
+    if (snprintf(pbuf, sizeof(pbuf), "%s/%s", src, ent->d_name) >= (int)sizeof(pbuf)) continue;
+    if (snprintf(qbuf, sizeof(qbuf), "%s/%s", dst, ent->d_name) >= (int)sizeof(qbuf)) continue;
+    if (stat(pbuf, &st) != 0) continue;
+    if (S_ISDIR(st.st_mode)) {
+      char s[1024], t[1024];
+      strcpy(s, pbuf); strcpy(t, qbuf);
+      if (copy_tree(s, t, files) != 0) r = -1;
+    } else {
+      if (copy_file(pbuf, qbuf) != 0) r = -1;
+      else (*files)++;
+    }
+  }
+
+  closedir(d);
+
+  return r;
+}
+
+/* What the game changes is kept in the browser's origin private filesystem,
+ * so that unlocked levels, settings and best times outlive the tab.
+ *
+ * Only the changes: creating a file in OPFS costs on the order of a tenth of a
+ * second, and the packaged tree is four thousand of them, so /vfs itself is
+ * built in memory out of the two read-only trees that ship with the page and
+ * OPFS holds an overlay of the files written since. Restoring it is copying
+ * that handful back over the top.
+ */
+#define SAVE_DIR "/save"
+
+static const char *writable[] = { "app_registry", "app_storage", "app_card", NULL };
+static time_t saved_from;
+static int saving;
+
+static int save_changed(const char *src, const char *dst) {
+  struct dirent *ent;
+  struct stat st;
+  DIR *d;
+  int n = 0;
+
+  if ((d = opendir(src)) == NULL) return 0;
+
+  while ((ent = readdir(d)) != NULL) {
+    char s[1024], t[1024];
+    if (!strcmp(ent->d_name, ".") || !strcmp(ent->d_name, "..")) continue;
+    if (snprintf(s, sizeof(s), "%s/%s", src, ent->d_name) >= (int)sizeof(s)) continue;
+    if (snprintf(t, sizeof(t), "%s/%s", dst, ent->d_name) >= (int)sizeof(t)) continue;
+    if (stat(s, &st) != 0) continue;
+    if (S_ISDIR(st.st_mode)) {
+      n += save_changed(s, t);
+    } else if (st.st_mtime >= saved_from) {
+      mkdir(dst, 0777);
+      if (copy_file(s, t) == 0) n++;
+    }
+  }
+
+  closedir(d);
+
+  return n;
+}
+
+/* Throw away everything the browser has kept, so the next visit starts from
+ * the packaged game again. Called from the page's reset button. */
+void bod_reset_saves(void) {
+  struct dirent *ent;
+  struct stat st;
+  DIR *d;
+  int i;
+
+  saving = 0;
+
+  for (i = 0; writable[i]; i++) {
+    char dir[1024];
+    snprintf(dir, sizeof(dir), "%s/%s", SAVE_DIR, writable[i]);
+    if ((d = opendir(dir)) == NULL) continue;
+    while ((ent = readdir(d)) != NULL) {
+      char sub[1024];
+      if (!strcmp(ent->d_name, ".") || !strcmp(ent->d_name, "..")) continue;
+      if (snprintf(sub, sizeof(sub), "%s/%s", dir, ent->d_name) >= (int)sizeof(sub)) continue;
+      if (stat(sub, &st) != 0) continue;
+      if (S_ISDIR(st.st_mode)) {
+        DIR *e = opendir(sub);
+        struct dirent *f;
+        if (e) {
+          while ((f = readdir(e)) != NULL) {
+            char file[1024];
+            if (!strcmp(f->d_name, ".") || !strcmp(f->d_name, "..")) continue;
+            if (snprintf(file, sizeof(file), "%s/%s", sub, f->d_name) < (int)sizeof(file)) {
+              unlink(file);
+            }
+          }
+          closedir(e);
+        }
+        rmdir(sub);
+      } else {
+        unlink(sub);
+      }
+    }
+    closedir(d);
+  }
+
+  printf("saved data cleared\n");
+}
+
+/* One pass over the writable tree, copying out what has changed since the
+ * last one. Also called from libos on the way out, because the application
+ * writes its settings as it exits. */
+void bod_flush_saves(void) {
+  char from[1024], to[1024];
+  int i, n = 0;
+
+  if (!saving) return;
+
+  for (i = 0; writable[i]; i++) {
+    snprintf(from, sizeof(from), "%s/%s", VFS_DIR, writable[i]);
+    snprintf(to, sizeof(to), "%s/%s", SAVE_DIR, writable[i]);
+    n += save_changed(from, to);
+  }
+  if (n) {
+    printf("saved %d changed file%s\n", n, n == 1 ? "" : "s");
+    saved_from = time(NULL);
+  }
+}
+
+/* A pass every few seconds rather than on every write: the game writes a
+ * database when it finishes a level or a dialog is closed, and OPFS is far too
+ * slow to sit in front of that. */
+static void *saver(void *arg) {
+  for (;;) {
+    usleep(5000000);
+    bod_flush_saves();
+  }
+
+  return NULL;
+}
+
+static void mount_persistent(void) {
+  pthread_t t;
+  backend_t opfs;
+  char from[1024], to[1024];
+  int i, files;
+
+  /* The tree PumpkinOS runs from, assembled from the two packaged ones. */
+  mkdir(VFS_DIR, 0777);
+  snprintf(to, sizeof(to), "%s/app_install", VFS_DIR);
+  mkdir(to, 0777);
+  snprintf(from, sizeof(from), "%s/pumpkin.lua", BOOT_DIR);
