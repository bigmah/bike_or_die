+#define LIBLSDL2_MAC_H
+
+/* Bike or Die's levels and level packs, from the macOS window itself; see
+ * liblsdl2_mac.m. Both are called on the thread that owns the window. */
+
+/* Adds the level controls to this window's title bar, the Level menu to the
+ * menu bar, the level pack sheet, the sheet that draws the game's dialogs and
+ * the pause menu. liblsdl2_mac_attach_window() is the same for a Cocoa window
+ * that SDL did not make. */
+void liblsdl2_mac_attach(SDL_Window *window);
+void liblsdl2_mac_attach_window(void *nswindow);
+
+/* Whether a key pressed now is for those controls rather than for the game:
+ * one of the sheets is up. */
+int liblsdl2_mac_wants_keys(void);
+
+/* Escape, pressed for the game (liblsdl2.c): puts the pause menu up, and says
+ * whether it did -- in which case the key is the window's, not the game's. */
+int liblsdl2_mac_escape(void);
+
+/* SDL takes a key before the sheet it was typed into does, and hands it over
+ * later, when the sheet may already have gone -- Escape on the pause menu
+ * resumes, and the same Escape must not then pause again. So a sheet says when
+ * it comes down, and a key whose SDL event is from no later than that was the
+ * sheet's (liblsdl2_mac.m). */
+void liblsdl2_mac_sheet_closed(void);
+int liblsdl2_mac_wants_key(uint32_t timestamp);
+
+/* debug() for the Objective-C side, which does not include PumpkinOS. */
+void liblsdl2_log(const char *msg);
+
+/* The game's own menus and dialogs, drawn by the window (liblsdl2_mac_form.m).
+ * liblsdl2_mac_attach() puts these up with the rest. */
+void liblsdl2_mac_form_attach(void *nswindow);
+int liblsdl2_mac_form_wants_keys(void);
+
+/* Whether the level pack sheet is up or waiting for the game: while it is,
+ * the game's level and pack lists belong to it and not to the form sheet. */
+int liblsdl2_mac_pack_busy(void);
+
+/* The level controls, for the pause menu (liblsdl2_mac.m): an item of the
+ * game's Game menu by its label, the level pack sheet, the name of the pack
+ * the game is on, the Screen setting chosen and kept, and the Pause button
+ * told whether the game is paused. */
+void liblsdl2_mac_game_menu(const char *label);
+void liblsdl2_mac_open_packs(void);
+const char *liblsdl2_mac_pack_title(void);
+void liblsdl2_mac_screen_choose(int mode);
+void liblsdl2_mac_pause_changed(int paused);
+
+/* The channel to the game's own UI (liblsdl2_mac_form.m): a command, queued
+ * so that one never takes the place of another on the way; the pause, which
+ * goes at once; the game's menu bar as it publishes it, "" until then; and a
+ * dialog asked for on purpose, to be shown as soon as it is up. */
+void liblsdl2_mac_ui_send(const char *cmd);
+void liblsdl2_mac_ui_pause(int on);
+const char *liblsdl2_mac_ui_menubar(void);
+void liblsdl2_mac_form_expect(void);
+int liblsdl2_mac_form_shown(void);
+
+/* The pause menu (liblsdl2_mac_pause.m). */
+void liblsdl2_mac_pause_attach(void *nswindow);
+int  liblsdl2_mac_pause_wants_keys(void);   /* its sheet is up */
+int  liblsdl2_mac_pause_session(void);      /* the game is held for it */
+void liblsdl2_mac_pause_open(void);
+void liblsdl2_mac_pause_resume(void);
+/* Another sheet is coming up over the game, and the menu makes way: for one of
+ * the game's dialogs, after which dialog_closed() says whether it was
+ * dismissed -- back to the menu -- or left some other way, which ends the
+ * pause; or for the level pack sheet, after which back_from_packs() is the way
+ * back if no pack was chosen. */
+void liblsdl2_mac_pause_step_aside(void);
+void liblsdl2_mac_pause_dialog_closed(int dismissed);
+void liblsdl2_mac_pause_hide_for_packs(void);
+void liblsdl2_mac_pause_back_from_packs(void);
+
+/* The Screen setting, for the View menu (liblsdl2.c): SCREEN_PIXELS,
+ * SCREEN_SMOOTH or SCREEN_XBR from liblsdl2_screen.h. Setting it shows the
+ * frame again at once. from_env says BOD_SCREEN chose it for this run. */
+int  liblsdl2_screen_get(void);
+void liblsdl2_screen_set(int mode);
+int  liblsdl2_screen_from_env(void);
+
+#endif
