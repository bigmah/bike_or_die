+/* Which navigator action, if any, a key press stands for. See navkeys.h. */
+
+NavKeyType NavKeyAction(const EventType *eventP) {
+  UInt16 chr, code;
+
+  if (eventP == NULL || eventP->eType != keyDownEvent) return navKeyNone;
+
+  chr = eventP->data.keyDown.chr;
+  code = eventP->data.keyDown.keyCode & (navBitsAll | navChangeBitsAll);
+
+  switch (chr) {
+    // Up and down arrive as page up/down. A device reports the release as the
+    // same character with only the change bit set, so a key that says anything
+    // about the navigator but does not say "held" is a release, not a press.
+    case vchrPageUp:
+      return (code && !(code & navBitUp)) ? navKeyNone : navKeyUp;
+    case vchrPageDown:
+      return (code && !(code & navBitDown)) ? navKeyNone : navKeyDown;
+
+    case vchrNavChange:
+      if (code & navBitLeft)   return navKeyLeft;
+      if (code & navBitRight)  return navKeyRight;
+      if (code & navBitSelect) return navKeySelect;
+      if (code & navBitUp)     return navKeyUp;
+      if (code & navBitDown)   return navKeyDown;
+      return navKeyNone;
+
+    // The keys a Palm has no equivalent for.
+    case 10:
+    case 13:
+    case ' ':
+      return navKeySelect;
+    case 27:
+      return navKeyCancel;
+  }
+
+  if (eventP->data.keyDown.modifiers & commandKeyMask) {
+    switch (chr) {
+      case vchrRockerUp:     return navKeyUp;
+      case vchrRockerDown:   return navKeyDown;
+      case vchrRockerLeft:   return navKeyLeft;
+      case vchrRockerRight:  return navKeyRight;
+      case vchrRockerCenter: return navKeySelect;
+    }
+  }
+
+  return navKeyNone;
+}
