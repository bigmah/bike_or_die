+      // shows it, and only exists on screen while it is popped up.
+      if (obj.list->bitsBehind) return false;
+      if (!obj.list->attr.usable || !obj.list->attr.visible) return false;
+      if (rP) MemMove(rP, &obj.list->bounds, sizeof(RectangleType));
+      return true;
+    case frmFieldObj:
+      if (!obj.field->attr.usable || !obj.field->attr.editable) return false;
+      if (rP) MemMove(rP, &obj.field->rect, sizeof(RectangleType));
