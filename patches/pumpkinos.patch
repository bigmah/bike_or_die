+static void FrmNavHide(FormType *formP) {
+  if (formP && formP->navDrawn) {
+    // Erase from the rectangle it was drawn at: the object may have resized
+    // since -- a popup trigger relabelled from its list, say.
+    FrmNavInvert(formP, &formP->navRect);
+    formP->navDrawn = 0;
+  }
+}
+
+static void FrmNavShow(FormType *formP) {
+  RectangleType rect;
+
+  if (formP && !formP->navDrawn && formP->navFocus != navNoFocus && formP->attr.visible) {
+    if (!FrmNavObject(formP, formP->navFocus, &rect)) return;
+    MemMove(&formP->navRect, &rect, sizeof(RectangleType));
+    FrmNavInvert(formP, &rect);
+    formP->navDrawn = 1;
+  }
+}
+
+// For the object drawing routines, which repaint over the ring. They are given
+// the active form because that is the only one with a ring on it.
+
+// The menu says so when an item was picked from the keyboard: whatever dialog
+// that item opens was asked for with the keyboard too.
+
+void FrmNavFromKeyboard(void) {
+  frm_module_t *module = (frm_module_t *)pumpkin_get_local_storage(frm_key);
+
+  if (module) module->navFromKeyboard = true;
+}
+
+void FrmNavRingHide(void) {
+  FormType *formP = FrmGetActiveForm();
+
+  // Inside FrmDrawForm the whole form is being repainted; it puts the ring back
+  // itself when it is done.
+  if (formP && !formP->attr.drawing) FrmNavHide(formP);
+}
+
+void FrmNavRingShow(void) {
+  FormType *formP = FrmGetActiveForm();
+
+  if (formP && !formP->attr.drawing) FrmNavShow(formP);
+}
+
+static void FrmNavSetFocus(FormType *formP, Int16 index) {
+  if (index == navNoFocus || index == formP->navFocus) return;
+
+  FrmNavHide(formP);
+  formP->navFocus = index;
+  // A field with the ring on it also takes the insertion point, so that typing
+  // goes where the ring is.
+  if (formP->objects[index].objectType == frmFieldObj) {
+    FrmSetFocus(formP, index);
+  } else if (FldGetActiveField() != NULL) {
+    FrmReleaseFocus(formP);
+    FldSetActiveField(NULL);
+  }
+  FrmNavShow(formP);
+}
+
+// Act on the object the ring is on, by tapping it where the pen would.
+//
+// The press is delivered now and the release is left pending: a real release
+// only arrives once the application has worked through everything the press
+// put in the queue, and objects rely on that order -- a button is drawn pressed
+// by the enter event and drawn unpressed again by the release, and a release
+// that overtook the enter event would leave it stuck down.
+
+static void FrmNavTap(FormType *formP, Coord x, Coord y) {
+  frm_module_t *module = (frm_module_t *)pumpkin_get_local_storage(frm_key);
+  EventType event;
+
+  if (module == NULL) return;
+
+  MemSet(&event, sizeof(EventType), 0);
+  event.eType = penDownEvent;
+  event.screenX = x;
+  event.screenY = y;
+  event.penDown = true;
+  if (!FrmDispatchEventInternal(formP, &event)) {
+    FrmHandleEvent(formP, &event);
+  }
+
+  module->penUpPending = true;
+  module->penUpX = x;
+  module->penUpY = y;
+  module->navFromKeyboard = true;
+}
+
+// A real release that arrived while its press was still in the queue. Nothing
+// has taken the press yet -- an object only does that when the application
+// dispatches it -- so releasing now would release nothing, and the list that
+// was tapped would stay on its old selection with the new row highlighted. A
+// browser does this on every quick click: the press and the release come off
+// the page together, and the game's thread pumps both before it dispatches
+// either. The release waits where a keyboard tap's does, for the queue to
+// drain, which is after the press has been dispatched.
+
+void FrmDeferPenUp(Coord x, Coord y) {
+  frm_module_t *module = (frm_module_t *)pumpkin_get_local_storage(frm_key);
+
+  if (module == NULL) return;
+  module->penUpPending = true;
+  module->penUpX = x;
+  module->penUpY = y;
+}
+
+// Called from EvtGetEvent once the queue has drained. Returns true if it put
+// anything in it.
+
+Boolean FrmFinishPenUp(void) {
+  frm_module_t *module = (frm_module_t *)pumpkin_get_local_storage(frm_key);
+  EventType event;
+  Coord x, y;
+
+  if (module == NULL || !module->penUpPending) return false;
+  module->penUpPending = false;
+  x = module->penUpX;
+  y = module->penUpY;
+
+  // The object that took the press is told about the release directly, and the
+  // form still sees the event afterwards. Exactly what a lifted pen does.
+  FrmTrackPenUp(x, y);
+
+  MemSet(&event, sizeof(EventType), 0);
+  event.eType = penUpEvent;
+  event.screenX = x;
+  event.screenY = y;
+  event.data.penUp.start.x = x;
+  event.data.penUp.start.y = y;
+  event.data.penUp.end.x = x;
+  event.data.penUp.end.y = y;
+  EvtAddEventToQueue(&event);
+
+  FrmNavShow(FrmGetActiveForm());
+
+  return true;
+}
+
+static Boolean FrmNavSelect(FormType *formP) {
+  RectangleType rect;
+  ListType *list;
+  Int16 index, row;
+  UInt16 objIndex;
+
+  index = formP->navFocus;
+
+  // Before the ring has been shown, and on a field -- which takes text, not
+  // presses -- select means the form's default button, the way Enter does in
+  // any other dialog.
+  if (index != navNoFocus && formP->objects[index].objectType == frmFieldObj) {
+    index = navNoFocus;
+  }
+  if (index == navNoFocus) {
+    if (formP->defaultButton == 0) return false;
+    objIndex = FrmGetObjectIndex(formP, formP->defaultButton);
+    if (objIndex == frmInvalidObjectId) return false;
+    index = objIndex;
+  }
+
+  if (!FrmNavObject(formP, index, &rect)) return false;
+
+  // Aim at the middle of the object, except in a list, where the row the
+  // selection is on is the thing being tapped.
+  row = rect.topLeft.y + rect.extent.y / 2;
+  if (formP->objects[index].objectType == frmListObj) {
+    list = formP->objects[index].object.list;
+    if (list->visibleItems > 0 && list->currentItem != noListSelection) {
+      row = rect.topLeft.y +
+            (list->currentItem - list->topItem) * (rect.extent.y / list->visibleItems) +
+            (rect.extent.y / list->visibleItems) / 2;
+    }
+  }
+
+  FrmNavHide(formP);
+  FrmNavTap(formP, rect.topLeft.x + rect.extent.x / 2, row);
+
+  return true;
+}
+
+// Up and down inside a list move its selection, and step out of the list at
+// its ends. Returns false when the key should move the ring instead.
+
+static Boolean FrmNavList(FormType *formP, int dir) {
+  ListType *list;
+  Int16 sel;
+
+  if (formP->navFocus == navNoFocus) return false;
+  if (formP->objects[formP->navFocus].objectType != frmListObj) return false;
+
+  list = formP->objects[formP->navFocus].object.list;
+  if (list->numItems <= 0) return false;
+
+  sel = list->currentItem;
+  if (sel == noListSelection) {
+    sel = (dir > 0) ? 0 : list->numItems - 1;
+  } else {
+    sel += dir;
+    if (sel < 0 || sel >= list->numItems) return false;   // out of the list
+  }
+
+  FrmNavHide(formP);
+  LstSetSelection(list, sel);
+  LstMakeItemVisible(list, sel);
+  LstDrawList(list);
+  FrmNavShow(formP);
+
+  return true;
+}
+
+// While a list is popped up it has the keyboard to itself: the trigger that
+// opened it is waiting inside LstPopupList for a selection or a dismissal.
+
+static Boolean FrmNavPopup(FormType *formP, NavKeyType nav) {
+  EventType event;
+  ListType *list;
+  Int16 sel;
+
+  if (formP->activeList < 0 || formP->activeList >= formP->numObjects) return false;
+  if (formP->objects[formP->activeList].objectType != frmListObj) return false;
+  list = formP->objects[formP->activeList].object.list;
+
+  switch (nav) {
+    case navKeyUp:
+    case navKeyDown:
+      if (list->numItems <= 0) return true;
+      sel = list->currentItem;
+      if (sel == noListSelection) {
+        sel = 0;
+      } else {
+        sel += (nav == navKeyDown) ? 1 : -1;
+        if (sel < 0) sel = list->numItems - 1;
+        if (sel >= list->numItems) sel = 0;
+      }
+      LstSetSelection(list, sel);
+      LstMakeItemVisible(list, sel);
+      LstDrawList(list);
+      return true;
+
+    case navKeySelect:
+      MemSet(&event, sizeof(EventType), 0);
+      sel = (list->currentItem == noListSelection) ? 0 : list->currentItem;
+      if (list->controlID) {
+        event.eType = popSelectEvent;
+        event.data.popSelect.listID = list->id;
+        event.data.popSelect.listP = list;
+        event.data.popSelect.selection = sel;
+        event.data.popSelect.priorSelection = list->currentItem;
+        event.data.popSelect.controlID = list->controlID;
+        event.data.popSelect.controlP = FrmGetObjectPtr(formP, FrmGetObjectIndex(formP, list->controlID));
+      } else {
+        event.eType = lstSelectEvent;
+        event.data.lstSelect.listID = list->id;
+        event.data.lstSelect.pList = list;
+        event.data.lstSelect.selection = sel;
+      }
+      list->currentItem = sel;
+      EvtAddEventToQueue(&event);
+      return true;
+
+    case navKeyCancel:
+    case navKeyLeft:
+      MemSet(&event, sizeof(EventType), 0);
+      event.eType = lstExitEvent;
+      event.data.lstExit.listID = list->id;
+      event.data.lstExit.pList = list;
+      EvtAddEventToQueue(&event);
+      return true;
+
+    default:
+      return false;
+  }
+}
+
+// The whole of it, called from EvtGetEvent before the application sees the
+// key. Returns true when the key was a navigator action this form dealt with.
+
+Boolean FrmNavHandleKey(FormType *formP, const EventType *eventP, Boolean quiet) {
+  NavKeyType nav;
+  int dir;
+
+  if (!FrmNavEnabled(formP)) return false;
+  if ((nav = NavKeyAction(eventP)) == navKeyNone) return false;
+
+  // A dialog that came up under the player's hands -- finishing a level puts
+  // one up -- must not take the taps still in flight and walk a focus ring
+  // around itself with them. It waits for the keyboard to fall still first; one
+  // the player opened themselves was armed when it was created.
+  if (!formP->navArmed) {
+    if (!quiet) return false;
+    formP->navArmed = 1;
+  }
+
+  if (formP->activeList != -1) {
+    return FrmNavPopup(formP, nav);
+  }
+
+  // Space is a character wherever text is being entered.
+  if (nav == navKeySelect && eventP->data.keyDown.chr == ' ' && FldGetActiveField() != NULL) {
+    return false;
+  }
+
+  switch (nav) {
+    case navKeyUp:
+    case navKeyDown:
+      dir = (nav == navKeyDown) ? 1 : -1;
+      if (formP->navFocus == navNoFocus) {
+        FrmNavSetFocus(formP, FrmNavFirst(formP));
+      } else if (!FrmNavList(formP, dir)) {
+        FrmNavSetFocus(formP, FrmNavStep(formP, dir));
+      }
+      return true;
+
+    case navKeyLeft:
+    case navKeyRight:
+      if (formP->navFocus == navNoFocus) {
+        FrmNavSetFocus(formP, FrmNavFirst(formP));
+      } else {
+        FrmNavSetFocus(formP, FrmNavStep(formP, (nav == navKeyRight) ? 1 : -1));
+      }
+      return true;
+
+    case navKeySelect:
+      return FrmNavSelect(formP);
+
+    default:
+      return false;
+  }
+}
