+/* ------------------------------------------------------------- the model */
+
+@interface BODObject : NSObject
+@property (nonatomic) NSInteger index;
+@property (nonatomic) NSInteger objId;
+@property (nonatomic, copy) NSString *kind;
+@property (nonatomic) NSInteger flags;
+@property (nonatomic) NSInteger value;
+@property (nonatomic) NSInteger group;
+@property (nonatomic) NSInteger link;
+@property (nonatomic) NSRect frame;
+@property (nonatomic, copy) NSString *text;
+@property (nonatomic, strong) NSMutableArray<NSString *> *items;
+@property (nonatomic) NSInteger selection;
+@property (nonatomic) NSInteger low;
+@property (nonatomic) NSInteger high;
+- (BOOL)visible;
+- (BOOL)enabled;
+- (BOOL)isDefault;
+- (BOOL)hasFocus;
+@end
+
+@implementation BODObject
+- (BOOL)visible { return (self.flags & BOD_VISIBLE) != 0; }
+- (BOOL)enabled { return (self.flags & BOD_ENABLED) != 0; }
+- (BOOL)isDefault { return (self.flags & BOD_DEFAULT) != 0; }
+- (BOOL)hasFocus { return (self.flags & BOD_FOCUS) != 0; }
+@end
+
+@interface BODFormState : NSObject
+@property (nonatomic) NSInteger formId;
+@property (nonatomic) BOOL modal;
+@property (nonatomic) NSSize size;
+@property (nonatomic, copy) NSString *title;
+@property (nonatomic) NSInteger defaultIndex;
+@property (nonatomic, strong) NSMutableArray<BODObject *> *objects;
+@property (nonatomic, copy) NSString *signature;
+@end
+
+@implementation BODFormState
+@end
+
+/* One line, "obj 7 push 20 3 0 1 0 39 16 28 12 Mute": the columns are
+ * fixed and the text is the rest of the line, so it may hold spaces. */
+static BODObject *parse_object(NSArray<NSString *> *words, NSString *line) {
+  BODObject *o;
+  NSRange rest;
+  NSInteger i;
+
+  if (words.count < 12) return nil;
+
+  o = [[BODObject alloc] init];
+  o.index = words[1].integerValue;
+  o.kind = words[2];
+  o.objId = words[3].integerValue;
+  o.flags = words[4].integerValue;
+  o.value = words[5].integerValue;
+  o.group = words[6].integerValue;
+  o.link = words[7].integerValue;
+  o.frame = NSMakeRect(words[8].doubleValue, words[9].doubleValue, words[10].doubleValue, words[11].doubleValue);
+  o.items = [NSMutableArray array];
+  o.selection = -1;
+
+  /* the text is whatever follows the twelfth word */
+  rest.location = 0;
+  for (i = 0; i < 12; i++) {
+    NSRange space = [line rangeOfString:@" " options:0 range:NSMakeRange(rest.location, line.length - rest.location)];
+    if (space.location == NSNotFound) { rest.location = line.length; break; }
+    rest.location = space.location + 1;
+  }
+  o.text = rest.location < line.length ? [line substringFromIndex:rest.location] : @"";
+
+  return o;
+}
+
+static BODFormState *parse_form(NSString *text) {
+  NSArray<NSString *> *lines = [text componentsSeparatedByString:@"\n"];
+  NSMutableDictionary<NSNumber *, BODObject *> *byIndex = [NSMutableDictionary dictionary];
+  NSMutableString *signature = [NSMutableString string];
+  BODFormState *form = [[BODFormState alloc] init];
+  BODObject *o;
+
+  form.objects = [NSMutableArray array];
+  form.defaultIndex = -1;
+  form.title = @"";
+
+  for (NSString *line in lines) {
+    NSArray<NSString *> *w = [line componentsSeparatedByString:@" "];
+    if (w.count == 0 || line.length == 0) continue;
+
+    if ([w[0] isEqualToString:@"form"]) {
+      form.formId = w.count > 1 ? w[1].integerValue : 0;
+      form.modal = w.count > 2 && w[2].integerValue != 0;
+      form.size = w.count > 4 ? NSMakeSize(w[3].doubleValue, w[4].doubleValue) : NSMakeSize(160, 160);
+      if (form.formId == 0) return form;
+
+    } else if ([w[0] isEqualToString:@"title"]) {
+      form.title = line.length > 6 ? [line substringFromIndex:6] : @"";
+
+    } else if ([w[0] isEqualToString:@"default"] && w.count > 1) {
+      form.defaultIndex = w[1].integerValue;
+
+    } else if ([w[0] isEqualToString:@"obj"]) {
+      if ((o = parse_object(w, line)) != nil) {
+        [form.objects addObject:o];
+        byIndex[@(o.index)] = o;
+        [signature appendFormat:@"%ld:%@:%ld:%ld:%@|", (long)o.index, o.kind, (long)o.objId, (long)(o.flags & (BOD_VISIBLE | BOD_ENABLED)), o.text];
+      }
+
+    } else if ([w[0] isEqualToString:@"slider"] && w.count > 4) {
+      if ((o = byIndex[@(w[1].integerValue)]) != nil) {
+        o.value = w[2].integerValue;
+        o.low = w[3].integerValue;
+        o.high = w[4].integerValue;
+        [signature appendFormat:@"s%ld-%ld|", (long)o.low, (long)o.high];
+      }
+
+    } else if ([w[0] isEqualToString:@"items"] && w.count > 3) {
+      if ((o = byIndex[@(w[1].integerValue)]) != nil) o.selection = w[3].integerValue;
+
+    } else if ([w[0] isEqualToString:@"item"] && w.count > 2) {
+      if ((o = byIndex[@(w[1].integerValue)]) != nil) {
+        NSRange r = [line rangeOfString:@" " options:0 range:NSMakeRange(0, line.length)];
+        r = [line rangeOfString:@" " options:0 range:NSMakeRange(r.location + 1, line.length - r.location - 1)];
+        r = [line rangeOfString:@" " options:0 range:NSMakeRange(r.location + 1, line.length - r.location - 1)];
+        [o.items addObject:r.location == NSNotFound ? @"" : [line substringFromIndex:r.location + 1]];
+        [signature appendFormat:@"i%ld|", (long)o.items.count];
+      }
+    }
+  }
+
+  form.signature = [NSString stringWithFormat:@"%ld/%@/%@", (long)form.formId, form.title, signature];
+
+  return form;
+}
+
+/* ------------------------------------------------------------- the sheet */
+
+/* The game's menu bar as it published it, for the pause menu. */
+static NSString *ui_menubar_text;
+
+/* What pressing a button with one of these labels does is leave the dialog
+ * alone -- which decides, if the dialog closes, whether the pause menu it was
+ * opened from comes back. */
+static BOOL ui_way_out(NSString *label) {
+  static NSSet<NSString *> *ways;
+  if (ways == nil) ways = [NSSet setWithArray:@[ @"cancel", @"close", @"done", @"ok", @"no", @"back" ]];
+  return [ways containsObject:[label stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceCharacterSet].lowercaseString];
+}
+
+@interface BODFormSheet : NSObject <NSTableViewDataSource, NSTableViewDelegate, NSTextFieldDelegate, NSMenuItemValidation, BODKeyTarget>
+- (void)attachTo:(NSWindow *)window;
+- (BOOL)wantsKeys;
+- (BOOL)shown;
+- (void)expect;
+@end
+
+@implementation BODFormSheet {
+  __weak NSWindow *_window;
+
+  BODKeyPanel *_sheet;
+  NSTextField *_heading;
+  NSStackView *_body;
+  NSStackView *_footer;
+  NSScrollView *_scroll;
+
+  BODFormState *_form;
+  NSString *_shown;                                  /* the signature on screen */
+  NSMutableDictionary<NSNumber *, NSView *> *_views; /* object index -> its control */
+  NSMutableDictionary<NSNumber *, NSTableView *> *_tables;
+  NSMutableArray<NSMenuItem *> *_menuItems;
+
+  NSTimer *_poll;
+  uint32_t _seq;
+  BOOL _menusBuilt;
+
+  /* Since when the game has had this form up, so that one it puts up and
+   * answers itself is never shown. */
+  NSDate *_settlingSince;
+
+  NSLayoutConstraint *_widthConstraint;
+  NSLayoutConstraint *_heightConstraint;
+  CGFloat _bodyHeight;
+
+  /* what each field last had, so giving one back unchanged says nothing */
+  NSMutableDictionary<NSNumber *, NSString *> *_fieldText;
+
+  /* where the keyboard is */
+  __weak NSView *_focus;
+
+  NSDate *_expectedAt;   /* a dialog asked for on purpose, shown as soon as it is up */
+  NSDate *_closedAt;     /* when the sheet last came down */
+  BOOL _chain;           /* a dialog opened over the pause menu is up, or on its way to the next */
+  BOOL _dismissed;       /* what last left a dialog was a way out of it */
+  BOOL _syncing;         /* a list's selection is being put back, not chosen */
+}
+
+- (void)attachTo:(NSWindow *)window {
+  _window = window;
+  _views = [NSMutableDictionary dictionary];
+  _tables = [NSMutableDictionary dictionary];
+  _menuItems = [NSMutableArray array];
+  _fieldText = [NSMutableDictionary dictionary];
+  _seq = 0xFFFFFFFF;
+  [self schedulePoll:POLL_IDLE];
+}
+
+- (BOOL)wantsKeys {
+  return _sheet != nil && (_sheet.sheetParent != nil || _sheet.isVisible);
+}
+
+- (BOOL)shown {
+  return _shown != nil;
+}
+
+- (void)expect {
+  _expectedAt = [NSDate date];
+}
+
+- (void)schedulePoll:(NSTimeInterval)interval {
+  if (_poll && _poll.timeInterval == interval) return;
+  [_poll invalidate];
+  _poll = [NSTimer timerWithTimeInterval:interval target:self selector:@selector(tick:) userInfo:nil repeats:YES];
+  _poll.tolerance = interval / 4;
+  [[NSRunLoop mainRunLoop] addTimer:_poll forMode:NSRunLoopCommonModes];
+}
+
+/* --------------------------------------------------- the game's menu bar */
+
+/* The menus the game has, in its own order, as the menu bar's own menus.
+ * Picking one is "pick <menu> <item>": the game has two menus called
+ * "Control" and three called "Hall of Fame", so an item is named by where
+ * it is rather than by what it says. */
+- (void)buildMenus:(NSString *)text {
+  NSMenu *bar = NSApp.mainMenu, *menu = nil;
+
+  ui_menubar_text = [text copy];
+  NSMenuItem *top = nil;
+  NSInteger at, menus = 0, items = 0;
+
+  if (bar == nil || text.length == 0) return;
+
+  at = NSApp.windowsMenu ? [bar indexOfItemWithSubmenu:NSApp.windowsMenu] : -1;
+  if (at < 0) at = bar.numberOfItems;
+
+  for (NSString *line in [text componentsSeparatedByString:@"\n"]) {
+    NSArray<NSString *> *w = [line componentsSeparatedByString:@" "];
+    if (w.count < 2) continue;
+
+    if ([w[0] isEqualToString:@"menu"]) {
+      NSString *title = line.length > 7 ? [line substringFromIndex:7] : @"";
+      menu = [[NSMenu alloc] initWithTitle:title];
+      menu.autoenablesItems = NO;
+      top = [[NSMenuItem alloc] initWithTitle:title action:NULL keyEquivalent:@""];
+      top.submenu = menu;
+      [bar insertItem:top atIndex:at++];
+      menus++;
+
+    } else if ([w[0] isEqualToString:@"mitem"] && w.count >= 4 && menu != nil) {
+      NSRange r = NSMakeRange(0, line.length);
+      NSString *label;
+      NSMenuItem *item;
+      NSInteger i;
+
+      for (i = 0; i < 4; i++) {
+        NSRange space = [line rangeOfString:@" " options:0 range:r];
+        if (space.location == NSNotFound) { r.location = line.length; break; }
+        r = NSMakeRange(space.location + 1, line.length - space.location - 1);
+      }
+      label = r.location < line.length ? [line substringFromIndex:r.location] : @"";
+
+      if ([label hasPrefix:@"-"]) {
+        [menu addItem:[NSMenuItem separatorItem]];
+        continue;
+      }
+
+      item = [[NSMenuItem alloc] initWithTitle:label action:@selector(pickMenu:) keyEquivalent:@""];
+      item.target = self;
+      item.tag = w[1].integerValue * 100 + w[2].integerValue;
+      [menu addItem:item];
+      [_menuItems addObject:item];
+      items++;
+    }
+  }
+
+  _menusBuilt = YES;
+  form_log(@"menu bar: %ld of the game's menus, %ld items", (long)menus, (long)items);
+}
+
+- (IBAction)pickMenu:(NSMenuItem *)sender {
+  ui_send([NSString stringWithFormat:@"pick %ld %ld", (long)(sender.tag / 100), (long)(sender.tag % 100)]);
+}
+
+/* The game takes a menu item only when it has the screen itself, and the
+ * level controls' own sheet is a dialog like any other. */
+- (BOOL)validateMenuItem:(NSMenuItem *)item {
+  return ![self wantsKeys] && !liblsdl2_mac_pack_busy();
+}
+
+/* ------------------------------------------------------------ the polling */
+
+- (void)tick:(NSTimer *)timer {
+  BODFormState *form;
+  NSString *text;
+  uint32_t seq = 0;
+
+  if (!ui_ready()) return;
+
+  if (!_menusBuilt && ui_menubar && ui_menubar_seq) {
+    if ((text = ui_read(ui_menubar, ui_menubar_seq, NULL)) != nil && text.length) [self buildMenus:text];
+  }
+
+  /* Reading is cheap; parsing is not, so that is done only when the game has
+   * published something new. What to do about it is decided every time --
+   * a dialog that comes up and then says nothing more still has to be shown
+   * once it has stood still long enough. */
+  if ((text = ui_read(ui_state, ui_seq, &seq)) == nil) return;
+  if (seq != _seq) {
+    _seq = seq;
+    form = parse_form(text);
+    if (form.formId != _form.formId) _settlingSince = [NSDate date];
+    _form = form;
+  }
+
+  [self reconcile];
+}
+
+/* What the window should be showing, given what the game has up. */
+- (void)reconcile {
+  BODFormState *form = _form;
+
+  if (form == nil) return;
+
+  /* The level pack sheet drives the game's own level and pack lists from the
+   * outside; while it is doing that, those dialogs are its business. */
+  if (liblsdl2_mac_pack_busy()) {
+    if (_shown != nil) [self close];
+    return;
+  }
+
+  if (form.formId == 0) {
+    [self close];
+    /* A dialog opened from the pause menu is over once the game has had the
+     * screen back for a moment: one dialog can close on the way to the next,
+     * and that is not the end of it. */
+    if (_chain && _closedAt != nil && -[_closedAt timeIntervalSinceNow] > CHAIN_END) {
+      _chain = NO;
+      liblsdl2_mac_pause_dialog_closed(_dismissed);
+    }
+    return;
+  }
+
+  /* A form already on screen follows the game at once: what it says has
+   * changed because something was pressed on it. */
+  if (_shown != nil) {
+    if (![form.signature isEqualToString:_shown]) [self present:form];
+    else [self update:form];
+    return;
+  }
+
+  /* One that has only just come up waits a moment first. Some of the game's
+   * dialogs are answered on the way in and are gone again in a fraction of a
+   * second -- the registration dialog is answered by Form.c before anyone
+   * sees it -- and a sheet that appeared for those would be a flash of a
+   * dialog nobody asked for, over a game that had not started yet. */
+  if ([[NSDate date] timeIntervalSinceDate:_settlingSince] < SETTLE &&
+      (_expectedAt == nil || -[_expectedAt timeIntervalSinceNow] > EXPECTED)) return;
+
+  [self present:form];
+}
+
+/* -------------------------------------------------------- building a row */
+
+/* The objects that are worth drawing, top to bottom and left to right --
+ * which on a Palm form is reading order. */
+- (NSArray<BODObject *> *)layoutObjects:(BODFormState *)form {
+  NSMutableArray<BODObject *> *out = [NSMutableArray array];
+
+  for (BODObject *o in form.objects) {
+    NSString *text = [o.text stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceCharacterSet];
+
+    if (![o visible]) continue;
+    if ([o.kind isEqualToString:@"title"]) continue;          /* the heading */
+    if ([o.kind isEqualToString:@"bitmap"]) continue;
+    if ([o.kind isEqualToString:@"gadget"]) continue;
+    if ([o.kind isEqualToString:@"scroll"]) continue;
+    if ([o.kind isEqualToString:@"other"]) continue;
+    if ([o.kind isEqualToString:@"list"] && o.link != 0) continue;   /* a popup's */
+    if ([o.kind isEqualToString:@"label"] && text.length == 0) continue;
+    if (([o.kind isEqualToString:@"button"] || [o.kind isEqualToString:@"push"]) && text.length == 0) continue;
+
+    /* Parked off the side of the form: Palm dialogs keep the controls of
+     * the page they are not showing out there rather than hiding them. */
+    if (NSMinX(o.frame) >= form.size.width || NSMinY(o.frame) >= form.size.height) continue;
+
+    [out addObject:o];
+  }
+
+  [out sortUsingComparator:^NSComparisonResult(BODObject *a, BODObject *b) {
+    if (fabs(NSMinY(a.frame) - NSMinY(b.frame)) > 5) return NSMinY(a.frame) < NSMinY(b.frame) ? NSOrderedAscending : NSOrderedDescending;
+    if (NSMinX(a.frame) != NSMinX(b.frame)) return NSMinX(a.frame) < NSMinX(b.frame) ? NSOrderedAscending : NSOrderedDescending;
+    return NSOrderedSame;
+  }];
+
+  return out;
+}
+
+- (NSFont *)labelFont {
+  return [NSFont systemFontOfSize:NSFont.systemFontSize];
+}
+
+- (BODObject *)listForTrigger:(BODObject *)trigger in:(BODFormState *)form {
+  for (BODObject *o in form.objects) {
+    if ([o.kind isEqualToString:@"list"] && o.objId == trigger.link) return o;
+  }
+
+  return nil;
+}
+
+/* A control for one object, or for a whole group of push buttons. */
+- (NSView *)viewFor:(BODObject *)o in:(BODFormState *)form group:(NSArray<BODObject *> *)group {
+  if ([o.kind isEqualToString:@"label"]) {
+    NSTextField *label = [NSTextField wrappingLabelWithString:o.text];
+    label.font = [self labelFont];
+    label.textColor = NSColor.labelColor;
+    label.selectable = NO;
+    return label;
+  }
+
+  if ([o.kind isEqualToString:@"check"]) {
+    NSButton *check = [NSButton checkboxWithTitle:o.text target:self action:@selector(hit:)];
+    check.tag = o.index;
+    check.state = o.value ? NSControlStateValueOn : NSControlStateValueOff;
+    check.enabled = [o enabled];
+    return check;
+  }
+
+  if ([o.kind isEqualToString:@"push"] && group.count > 1) {
+    NSSegmentedControl *seg = [[NSSegmentedControl alloc] init];
+    NSInteger i;
+
+    seg.segmentCount = group.count;
+    seg.trackingMode = NSSegmentSwitchTrackingSelectOne;
+    seg.segmentStyle = NSSegmentStyleRounded;
+    for (i = 0; i < (NSInteger)group.count; i++) {
+      [seg setLabel:group[i].text forSegment:i];
+      [seg setTag:group[i].index forSegment:i];
+      if (group[i].value) seg.selectedSegment = i;
+    }
+    seg.target = self;
+    seg.action = @selector(hitSegment:);
+    seg.enabled = [o enabled];
+    return seg;
+  }
+
+  if ([o.kind isEqualToString:@"push"]) {
+    NSButton *push = [NSButton buttonWithTitle:o.text target:self action:@selector(hit:)];
+    push.tag = o.index;
+    push.bezelStyle = NSBezelStyleRounded;
+    [push setButtonType:NSButtonTypePushOnPushOff];
+    push.state = o.value ? NSControlStateValueOn : NSControlStateValueOff;
+    push.enabled = [o enabled];
+    return push;
+  }
+
+  if ([o.kind isEqualToString:@"popup"] || [o.kind isEqualToString:@"selector"]) {
+    BODObject *list = [self listForTrigger:o in:form];
+    NSPopUpButton *popup = [[NSPopUpButton alloc] initWithFrame:NSZeroRect pullsDown:NO];
+
+    if (list) {
+      [popup addItemsWithTitles:list.items.count ? list.items : @[ o.text.length ? o.text : @"—" ]];
+      if (list.selection >= 0 && list.selection < (NSInteger)popup.numberOfItems) [popup selectItemAtIndex:list.selection];
+      popup.tag = list.index;
+    } else {
+      /* A trigger with no list of its own: the game fills its label in and
+       * opens something else when it is pressed. */
+      [popup addItemWithTitle:o.text.length ? o.text : @"…"];
+      popup.tag = -1;
+    }
+    popup.target = self;
+    popup.action = @selector(hitPopup:);
+    popup.enabled = [o enabled];
+    [popup setContentCompressionResistancePriority:NSLayoutPriorityDefaultLow forOrientation:NSLayoutConstraintOrientationHorizontal];
+    return popup;
+  }
+
+  if ([o.kind isEqualToString:@"field"] && ![o enabled]) {
+    /* A field the game writes and nobody types into: what it says, as text. */
+    NSTextField *label = [NSTextField wrappingLabelWithString:o.text];
+    label.font = [self labelFont];
+    label.textColor = NSColor.labelColor;
+    label.selectable = YES;
+    return label;
+  }
+
+  if ([o.kind isEqualToString:@"field"]) {
+    NSTextField *field = [NSTextField textFieldWithString:o.text];
+    field.tag = o.index;
+    _fieldText[@(o.index)] = o.text;
+    field.delegate = self;
+    field.target = self;
+    field.action = @selector(hitField:);
+    [field.widthAnchor constraintGreaterThanOrEqualToConstant:MAX(120, o.frame.size.width * 1.6)].active = YES;
+    return field;
+  }
+
+  if ([o.kind isEqualToString:@"slider"]) {
+    NSSlider *slider = [NSSlider sliderWithValue:o.value minValue:o.low maxValue:o.high > o.low ? o.high : o.low + 1
+                                          target:self action:@selector(hitSlider:)];
+    slider.tag = o.index;
+    slider.enabled = [o enabled];
+    /* One event when it is let go of, not one per pixel: the game answers a
+     * slider by redrawing the form it is on. */
+    slider.continuous = NO;
+    [slider.widthAnchor constraintGreaterThanOrEqualToConstant:160].active = YES;
+    return slider;
+  }
+
+  if ([o.kind isEqualToString:@"list"] || [o.kind isEqualToString:@"table"]) {
+    NSTableColumn *column = [[NSTableColumn alloc] initWithIdentifier:@"item"];
+    NSTableView *table = [[NSTableView alloc] initWithFrame:NSZeroRect];
+    NSScrollView *scroll = [[NSScrollView alloc] init];
+
+    column.resizingMask = NSTableColumnAutoresizingMask;
+    [table addTableColumn:column];
+    table.headerView = nil;
+    table.columnAutoresizingStyle = NSTableViewLastColumnOnlyAutoresizingStyle;
+    table.style = NSTableViewStyleFullWidth;
+    table.rowHeight = 20;
+    table.tag = o.index;
+    table.dataSource = self;
+    table.delegate = self;
+    table.target = self;
+    table.doubleAction = @selector(hitTableTwice:);
+    if (o.selection >= 0 && o.selection < (NSInteger)o.items.count) {
+      [table selectRowIndexes:[NSIndexSet indexSetWithIndex:o.selection] byExtendingSelection:NO];
+    }
+    _tables[@(o.index)] = table;
+
+    scroll.documentView = table;
+    scroll.hasVerticalScroller = YES;
+    scroll.autohidesScrollers = YES;
+    scroll.borderType = NSBezelBorder;
+    [scroll.heightAnchor constraintEqualToConstant:MIN(260, MAX(80, o.items.count * 20 + 8))].active = YES;
+    return scroll;
+  }
+
+  /* button, repeat, and anything else with a label */
+  {
+    NSButton *button = [NSButton buttonWithTitle:o.text target:self action:@selector(hit:)];
+    button.tag = o.index;
+    button.enabled = [o enabled];
+    if ([o isDefault]) button.keyEquivalent = @"\r";
+    return button;
+  }
+}
+
+/* The bottom row of a Palm dialog is its buttons; here they belong under the
+ * sheet, where a Mac keeps them. */
+- (BOOL)isActionRow:(NSArray<BODObject *> *)row of:(NSArray<BODObject *> *)all {
+  CGFloat bottom = 0;
+
+  if (row.count == 0) return NO;
+  for (BODObject *o in all) bottom = MAX(bottom, NSMinY(o.frame));
+  if (NSMinY(row.firstObject.frame) < bottom - 5) return NO;
+
+  for (BODObject *o in row) {
+    if (![o.kind isEqualToString:@"button"]) return NO;
+  }
+
+  return YES;
+}
+
+- (void)buildBody:(BODFormState *)form {
+  NSArray<BODObject *> *objects = [self layoutObjects:form];
+
+  _bodyHeight = 0;
+  NSMutableArray<BODObject *> *row = [NSMutableArray array];
+  NSMutableArray<NSArray<BODObject *> *> *rows = [NSMutableArray array];
+  CGFloat y = -1000;
+
+  [_views removeAllObjects];
+  [_tables removeAllObjects];
+  for (NSView *view in _body.views.copy) [_body removeView:view];
+  for (NSView *view in _footer.views.copy) [_footer removeView:view];
+
+  for (BODObject *o in objects) {
+    if (NSMinY(o.frame) > y + 5 && row.count) {
+      [rows addObject:row.copy];
+      [row removeAllObjects];
+    }
+    if (row.count == 0) y = NSMinY(o.frame);
+    [row addObject:o];
+  }
+  if (row.count) [rows addObject:row.copy];
+
+  for (NSArray<BODObject *> *line in rows) {
+    NSStackView *stack = [[NSStackView alloc] init];
+    BOOL action = [self isActionRow:line of:objects];
+    NSMutableSet<NSNumber *> *done = [NSMutableSet set];
+
+    stack.orientation = NSUserInterfaceLayoutOrientationHorizontal;
+    stack.alignment = NSLayoutAttributeCenterY;
+    stack.spacing = 8;
+    stack.distribution = NSStackViewDistributionFill;
+
+    for (BODObject *o in line) {
+      NSMutableArray<BODObject *> *group = [NSMutableArray array];
+      NSView *view;
+
+      if ([done containsObject:@(o.index)]) continue;
+
+      /* push buttons of one group are one control, wherever they sit */
+      if ([o.kind isEqualToString:@"push"] && o.group) {
+        for (BODObject *g in objects) {
+          if ([g.kind isEqualToString:@"push"] && g.group == o.group && [g visible]) {
+            [group addObject:g];
+            [done addObject:@(g.index)];
+          }
+        }
+      } else {
+        [done addObject:@(o.index)];
+      }
+
+      view = [self viewFor:o in:form group:group];
+      if (view == nil) continue;
+      _views[@(o.index)] = view;
+      for (BODObject *g in group) _views[@(g.index)] = view;
+      [stack addView:view inGravity:action ? NSStackViewGravityTrailing : NSStackViewGravityLeading];
+    }
+
+      if (stack.views.count == 0) continue;
+    if (action) {
+      for (NSView *view in stack.views.copy) {
+        [stack removeView:view];
+        [_footer addView:view inGravity:NSStackViewGravityTrailing];
+      }
+    } else {
+      [_body addView:stack inGravity:NSStackViewGravityTop];
+      [stack.widthAnchor constraintLessThanOrEqualToAnchor:_body.widthAnchor].active = YES;
+      _bodyHeight += MAX(stack.fittingSize.height, 22) + _body.spacing;
+    }
+  }
+
+  /* Every dialog needs a way out, even one whose buttons the game has taken
+   * away while it thinks. */
+  if (_footer.views.count == 0) {
+    NSButton *close = [NSButton buttonWithTitle:@"Close" target:self action:@selector(closeForm:)];
+    close.keyEquivalent = @"\033";
+    [_footer addView:close inGravity:NSStackViewGravityTrailing];
+  }
+}
+
+- (void)buildSheet {
+  NSStackView *content;
+
+  if (_sheet) return;
+
+  _sheet = [[BODKeyPanel alloc] initWithContentRect:NSMakeRect(0, 0, 460, 420)
+                                          styleMask:NSWindowStyleMaskTitled
+                                            backing:NSBackingStoreBuffered
+                                              defer:YES];
+  _sheet.releasedWhenClosed = NO;
+  _sheet.keyTarget = self;
+
+  _heading = [NSTextField labelWithString:@""];
+  _heading.font = [NSFont boldSystemFontOfSize:NSFont.systemFontSize + 2];
+
+  _body = [[NSStackView alloc] init];
+  _body.orientation = NSUserInterfaceLayoutOrientationVertical;
+  _body.alignment = NSLayoutAttributeLeading;
+  _body.spacing = 10;
+  /* room for the keyboard's ring round a control at the edge */
+  _body.edgeInsets = NSEdgeInsetsMake(4, 5, 4, 5);
+  _body.translatesAutoresizingMaskIntoConstraints = NO;
+  [_body setHuggingPriority:NSLayoutPriorityDefaultHigh forOrientation:NSLayoutConstraintOrientationVertical];
+
+  /* A form longer than the window scrolls rather than being cut off. The
+   * stack is the scroll view's document, which means pinning it to the clip
+   * view: its width is the clip's, and its height is its own, which is what
+   * gives the scroller something to scroll. */
+  _scroll = [[NSScrollView alloc] init];
+  _scroll.documentView = _body;
+  _scroll.hasVerticalScroller = YES;
+  _scroll.autohidesScrollers = YES;
+  _scroll.drawsBackground = NO;
+  _scroll.borderType = NSNoBorder;
+  [NSLayoutConstraint activateConstraints:@[
+    [_body.leadingAnchor constraintEqualToAnchor:_scroll.contentView.leadingAnchor],
+    [_body.trailingAnchor constraintEqualToAnchor:_scroll.contentView.trailingAnchor],
+    [_body.topAnchor constraintEqualToAnchor:_scroll.contentView.topAnchor] ]];
+
+  _footer = [[NSStackView alloc] init];
+  _footer.orientation = NSUserInterfaceLayoutOrientationHorizontal;
+  _footer.spacing = 10;
+
+  content = [NSStackView stackViewWithViews:@[ _heading, _scroll, _footer ]];
+  content.orientation = NSUserInterfaceLayoutOrientationVertical;
+  content.alignment = NSLayoutAttributeLeading;
+  content.spacing = 12;
+  content.edgeInsets = NSEdgeInsetsMake(18, 20, 18, 20);
+  _sheet.contentView = content;
+
+  for (NSView *view in @[ _scroll, _footer ]) {
+    [view.widthAnchor constraintEqualToAnchor:content.widthAnchor constant:-40].active = YES;
+  }
+  /* The sheet is as wide as it is told and no wider: left to work it out for
+   * itself it takes the width of the widest control, which for a dialog of
+   * buttons is nothing like a window. */
+  _widthConstraint = [content.widthAnchor constraintEqualToConstant:460];
+  _heightConstraint = [_scroll.heightAnchor constraintEqualToConstant:240];
+  _widthConstraint.active = YES;
+  _heightConstraint.active = YES;
+}
+
+- (void)present:(BODFormState *)form {
+  NSSize content;
+  CGFloat width, height;
+  NSString *keep = [self focusKey];
+
+  if (_window == nil) return;
+
+  /* Over the pause menu, if it is up: a window has one sheet at a time, so the
+   * menu makes way, and comes back when this is over. */
+  if (liblsdl2_mac_pause_session()) {
+    liblsdl2_mac_pause_step_aside();
+    _chain = YES;
+  }
+  _expectedAt = nil;
+
+  [self buildSheet];
+  _heading.stringValue = form.title.length ? form.title : @"Bike or Die";
+  [self buildBody:form];
+  _shown = form.signature;
+
+  content = _window.contentView.frame.size;
+  width = MAX(340, MIN(560, content.width - 80));
+  _widthConstraint.constant = width;
+
+  /* Long explanations wrap rather than making the sheet as wide as they are. */
+  for (NSView *view in _views.allValues) {
+    if ([view isKindOfClass:NSTextField.class]) ((NSTextField *)view).preferredMaxLayoutWidth = width - 60;
+  }
+  [_sheet.contentView layoutSubtreeIfNeeded];
+  height = MIN(content.height - 140, MAX(40, _bodyHeight + 4));
+  _heightConstraint.constant = height;
+  [_sheet.contentView layoutSubtreeIfNeeded];
+  form_log(@"dialog: form %ld (%@), %.0fx%.0f", (long)form.formId, form.title, width, height);
+
+  if (_sheet.sheetParent == nil) [_window beginSheet:_sheet completionHandler:nil];
+  [self schedulePoll:POLL_FAST];
+  [self startFocus:keep];
+}
+
+/* -------------------------------------------------------------- the keys */
+
+/* What the keyboard is on, in a form that survives the sheet being built
+ * again: the kind of control and the object it stands for. */
+- (NSString *)focusKey {
+  NSView *view = _focus;
+
+  if (view == nil || view.window != _sheet) return nil;
+  return [NSString stringWithFormat:@"%@/%ld", NSStringFromClass(view.class), (long)view.tag];
+}
+
+- (void)focus:(NSView *)view {
+  NSView *old = _focus;
+
+  if (old != view) bod_keys_mark(old, NO);
+  _focus = view;
+  if (view == nil) return;
+
+  if ([view isKindOfClass:NSTextField.class]) {
+    /* Somewhere to type has the real focus, and the system's own ring. */
+    [_sheet makeFirstResponder:view];
+  } else {
+    if ([view isKindOfClass:NSTableView.class]) [_sheet makeFirstResponder:view];
+    else [_sheet makeFirstResponder:nil];
+    bod_keys_mark(view, YES);
+  }
+  [view scrollRectToVisible:view.bounds];
+}
+
+/* Where the keyboard starts on a dialog just shown: on the control it was on,
+ * if the dialog was only built again; where the game has the caret, or
+ * anywhere that can be typed into -- the name on the dialog that finishing a
+ * level puts up; the chosen item of a list; or the first control, rather than
+ * the default button, which is Cancel as often as not, and Escape anyway. */
+- (void)startFocus:(NSString *)keep {
+  NSArray<NSView *> *controls = bod_keys_controls(_sheet.contentView);
+  NSView *field = nil, *table = nil;
+
+  _focus = nil;
+  if (keep != nil) {
+    for (NSView *view in controls) {
+      if ([[NSString stringWithFormat:@"%@/%ld", NSStringFromClass(view.class), (long)view.tag] isEqualToString:keep]) {
+        [self focus:view];
+        return;
+      }
+    }
+  }
+
+  for (BODObject *o in _form.objects) {
+    NSView *view = _views[@(o.index)];
+
+    if (![o.kind isEqualToString:@"field"] || ![o enabled] || ![view isKindOfClass:NSTextField.class]) continue;
+    if ([o hasFocus]) { field = view; break; }
+    if (field == nil) field = view;
+  }
+  if (field) { [self focus:field]; return; }
+
+  for (NSTableView *view in _tables.allValues) {
+    if (view.selectedRow >= 0) { table = view; break; }
+  }
+  if (table) { [self focus:table]; return; }
+
+  [self focus:controls.firstObject];
+}
+
+/* The first button under the dialog that is not a way out of it: what acts on
+ * a choice made in a list -- Play this level. */
+- (NSButton *)affirmative {
+  for (NSView *view in _footer.views) {
+    if ([view isKindOfClass:NSButton.class] && ((NSButton *)view).isEnabled && !ui_way_out(((NSButton *)view).title)) {
+      return (NSButton *)view;
+    }
+  }
+
+  return nil;
+}
+
+- (BOOL)panelKeyDown:(NSEvent *)event {
+  NSView *focus = _focus;
+  unsigned short code = event.keyCode;
+  NSInteger direction = bod_keys_direction(code);
+  BOOL typing = [focus isKindOfClass:NSTextField.class];
+  NSArray<NSView *> *controls;
+  NSView *next;
+
+  if (code == BODKeyEscape) {
+    if (!event.isARepeat) [self closeForm:nil];
+    return YES;
+  }
+
+  if (code == BODKeyTab) {
+    controls = bod_keys_controls(_sheet.contentView);
+    if (controls.count) {
+      NSInteger i = focus ? (NSInteger)[controls indexOfObject:focus] : NSNotFound;
+      NSInteger step = (event.modifierFlags & NSEventModifierFlagShift) ? -1 : 1, n = (NSInteger)controls.count;
+      if (i == NSNotFound) i = step > 0 ? -1 : 0;
+      [self focus:controls[(NSUInteger)((i + step + n) % n)]];
+    }
+    return YES;
+  }
+
+  if (focus == nil || focus.window != _sheet) {
+    /* Nothing chosen yet: an arrow chooses where to start, and Return is the
+     * default button's, as it always was. */
+    if (direction < 0) return NO;
+    [self startFocus:nil];
+    return YES;
+  }
+
+  if (direction == BODDirectionLeft || direction == BODDirectionRight) {
+    NSInteger step = direction == BODDirectionRight ? 1 : -1;
+
+    if (typing) return NO;
+    if ([focus isKindOfClass:NSPopUpButton.class]) {
+      NSPopUpButton *popup = (NSPopUpButton *)focus;
+      NSInteger i = popup.indexOfSelectedItem + step;
+      if (popup.tag >= 0 && i >= 0 && i < popup.numberOfItems) {
+        [popup selectItemAtIndex:i];
+        [self hitPopup:popup];
+      }
+      return YES;
+    }
+    if ([focus isKindOfClass:NSSegmentedControl.class]) {
+      NSSegmentedControl *seg = (NSSegmentedControl *)focus;
+      NSInteger i = seg.selectedSegment + step;
+      while (i >= 0 && i < seg.segmentCount && ![seg isEnabledForSegment:i]) i += step;
+      if (i >= 0 && i < seg.segmentCount) {
+        seg.selectedSegment = i;
+        [self hitSegment:seg];
+      }
+      return YES;
+    }
+    if ([focus isKindOfClass:NSSlider.class]) {
+      NSSlider *slider = (NSSlider *)focus;
+      double stepBy = MAX(1, round((slider.maxValue - slider.minValue) / 10));
+      slider.doubleValue = MIN(slider.maxValue, MAX(slider.minValue, slider.doubleValue + step * stepBy));
+      [self hitSlider:slider];
+      return YES;
+    }
+  }
+
+  if (direction == BODDirectionUp || direction == BODDirectionDown) {
+    /* A list takes up and down for itself until they would leave it. */
+    if ([focus isKindOfClass:NSTableView.class]) {
+      NSTableView *table = (NSTableView *)focus;
+      NSInteger row = table.selectedRow + (direction == BODDirectionDown ? 1 : -1);
+      if (row >= 0 && row < table.numberOfRows) {
+        [table selectRowIndexes:[NSIndexSet indexSetWithIndex:(NSUInteger)row] byExtendingSelection:NO];
+        [table scrollRowToVisible:row];
+        return YES;
+      }
+    }
+  }
+
+  if (direction >= 0) {
+    controls = bod_keys_controls(_sheet.contentView);
+    next = bod_keys_toward(controls, focus, (BODDirection)direction);
+    if (next == nil && (direction == BODDirectionUp || direction == BODDirectionDown) && controls.count > 1) {
+      next = direction == BODDirectionDown ? controls.firstObject : controls.lastObject;
+    }
+    if (next) [self focus:next];
+    return YES;
+  }
+
+  if (code == BODKeyReturn || code == BODKeyEnter) {
+    if (event.isARepeat) return YES;
+    if (typing) {
+      /* What was typed, and then the button Return would press. */
+      [self hitField:(NSTextField *)focus];
+      [self pressDefault];
+      return YES;
+    }
+    if ([focus isKindOfClass:NSTableView.class]) {
+      [self choose:(NSTableView *)focus row:((NSTableView *)focus).selectedRow twice:NO];
+      return YES;
+    }
+    if ([focus isKindOfClass:NSSegmentedControl.class]) {
+      [self hitSegment:(NSSegmentedControl *)focus];
+      return YES;
+    }
+    if ([focus isKindOfClass:NSButton.class]) {
+      [(NSButton *)focus performClick:nil];
+      return YES;
+    }
+    return NO;
+  }
+
+  if (code == BODKeySpace) {
+    if (typing || event.isARepeat) return typing ? NO : YES;
+    if ([focus isKindOfClass:NSButton.class]) {
+      [(NSButton *)focus performClick:nil];
+      return YES;
+    }
+    return YES;
+  }
+
+  return NO;
+}
+
+- (void)pressDefault {
+  BODObject *o;
+
+  if (_form.defaultIndex < 0 || (o = [self objectAt:_form.defaultIndex]) == nil) return;
+  _dismissed = ui_way_out(o.text);
+  ui_send([NSString stringWithFormat:@"press %ld", (long)o.index]);
+}
+
+/* Choosing an item of a list. Where the dialog's default button is something
+ * to do with the choice -- Select, OK -- the two go together. Where it is a way
+ * out, as it is on the game's level list, pressing it would throw the choice
+ * away: the item is chosen, and the keyboard goes to the button that acts on it
+ * instead, or a double-click presses that button. */
+- (void)choose:(NSTableView *)table row:(NSInteger)row twice:(BOOL)twice {
+  BODObject *o = _form.defaultIndex >= 0 ? [self objectAt:_form.defaultIndex] : nil;
+  NSButton *go;
+
+  if (row < 0) return;
+  ui_send([NSString stringWithFormat:@"select %ld %ld", (long)table.tag, (long)row]);
+
+  if (o != nil && !ui_way_out(o.text)) {
+    [self pressDefault];
+  } else if ((go = [self affirmative]) != nil) {
+    if (twice) [go performClick:nil];
+    else [self focus:go];
+  }
+}
+
+/* The same form again, with something on it changed: the values move, the
+ * controls stay where they are, so what is being typed is not disturbed. */
+- (void)update:(BODFormState *)form {
+  for (BODObject *o in form.objects) {
+    NSView *view = _views[@(o.index)];
+
+    if (view == nil) continue;
+
+    if ([o.kind isEqualToString:@"check"] && [view isKindOfClass:NSButton.class]) {
+      ((NSButton *)view).state = o.value ? NSControlStateValueOn : NSControlStateValueOff;
+
+    } else if ([o.kind isEqualToString:@"push"] && [view isKindOfClass:NSSegmentedControl.class]) {
+      NSSegmentedControl *seg = (NSSegmentedControl *)view;
+      NSInteger i;
+      for (i = 0; i < seg.segmentCount; i++) {
+        if ([seg tagForSegment:i] == o.index && o.value) seg.selectedSegment = i;
+      }
+
+    } else if ([o.kind isEqualToString:@"push"] && [view isKindOfClass:NSButton.class]) {
+      ((NSButton *)view).state = o.value ? NSControlStateValueOn : NSControlStateValueOff;
+
+    } else if (([o.kind isEqualToString:@"popup"] || [o.kind isEqualToString:@"selector"]) &&
+               [view isKindOfClass:NSPopUpButton.class]) {
+      /* A pop-up is drawn for its trigger and shows its list's choice. */
+      NSPopUpButton *popup = (NSPopUpButton *)view;
+      BODObject *list = [self listForTrigger:o in:form];
+      if (list && list.selection >= 0 && list.selection < popup.numberOfItems && popup.indexOfSelectedItem != list.selection) {
+        [popup selectItemAtIndex:list.selection];
+      }
+
+    } else if ([o.kind isEqualToString:@"slider"] && [view isKindOfClass:NSSlider.class]) {
+      ((NSSlider *)view).doubleValue = o.value;
+
+    } else if ([o.kind isEqualToString:@"field"] && ![o enabled] && [view isKindOfClass:NSTextField.class]) {
+      ((NSTextField *)view).stringValue = o.text;
+
+    } else if ([o.kind isEqualToString:@"field"] && [view isKindOfClass:NSTextField.class]) {
+      NSTextField *field = (NSTextField *)view;
+      if (_sheet.firstResponder != field.currentEditor && ![field.stringValue isEqualToString:o.text]) {
+        field.stringValue = o.text;
+        _fieldText[@(o.index)] = o.text;
+      }
+    }
+  }
+
+  _form = form;
+
+  /* Reloading a list lets go of its selection, and the game publishes the form
+   * again for every choice made on it -- so the choice would last only until
+   * the game had heard it. It is put back, quietly: the list's own while there
+   * is one, the game's otherwise. */
+  _syncing = YES;
+  for (NSNumber *index in _tables) {
+    NSTableView *table = _tables[index];
+    BODObject *o = [self objectAt:index.integerValue];
+    NSInteger keep = table.selectedRow;
+
+    [table reloadData];
+    if (keep < 0 && o != nil) keep = o.selection;
+    if (keep >= 0 && keep < table.numberOfRows && table.selectedRow != keep) {
+      [table selectRowIndexes:[NSIndexSet indexSetWithIndex:(NSUInteger)keep] byExtendingSelection:NO];
+    }
+  }
+  _syncing = NO;
+}
+
+- (void)close {
+  NSWindow *parent = _sheet.sheetParent;
+
+  if (_sheet == nil) return;
+  if (_shown != nil) _closedAt = [NSDate date];
+  if (parent || _sheet.isVisible) liblsdl2_mac_sheet_closed();
+  bod_keys_mark(_focus, NO);
+  _focus = nil;
+  if (parent) [parent endSheet:_sheet];
+  [_sheet orderOut:nil];
+  _shown = nil;
+  [_views removeAllObjects];
+  [_tables removeAllObjects];
+  [self schedulePoll:POLL_IDLE];
+}
+
+/* ------------------------------------------------------------ the actions */
+
+- (BODObject *)objectAt:(NSInteger)index {
+  for (BODObject *o in _form.objects) {
+    if (o.index == index) return o;
+  }
+
+  return nil;
+}
+
+- (IBAction)hit:(NSControl *)sender {
+  BODObject *o = [self objectAt:sender.tag];
+
+  /* A button that closes the dialog either dismisses it or does something;
+   * a checkbox or a toggle does neither. */
+  if ([o.kind isEqualToString:@"button"] || [o.kind isEqualToString:@"repeat"] || [o.kind isEqualToString:@"popup"] ||
+      [o.kind isEqualToString:@"selector"]) {
+    _dismissed = ui_way_out(o.text);
+  }
+  if ([sender isKindOfClass:NSView.class] && ((NSView *)sender).window == _sheet &&
+      ![sender isKindOfClass:NSTextField.class] && sender != _focus) {
+    [self focus:sender];
+  }
+  ui_send([NSString stringWithFormat:@"press %ld", (long)sender.tag]);
+}
+
+- (IBAction)hitSegment:(NSSegmentedControl *)sender {
+  if (sender.selectedSegment < 0) return;
+  ui_send([NSString stringWithFormat:@"press %ld", (long)[sender tagForSegment:sender.selectedSegment]]);
+}
+
+- (IBAction)hitPopup:(NSPopUpButton *)sender {
+  if (sender.tag < 0) return;
+  ui_send([NSString stringWithFormat:@"select %ld %ld", (long)sender.tag, (long)sender.indexOfSelectedItem]);
+}
+
+- (IBAction)hitSlider:(NSSlider *)sender {
+  ui_send([NSString stringWithFormat:@"slider %ld %ld", (long)sender.tag, (long)llround(sender.doubleValue)]);
+}
+
+/* Only when it has really changed: the field is given the focus when the
+ * sheet opens, and ending that editing must not type the game's own text
+ * back into its form. */
+- (IBAction)hitField:(NSTextField *)sender {
+  NSString *was = _fieldText[@(sender.tag)];
+
+  if (was != nil && [was isEqualToString:sender.stringValue]) return;
+  _fieldText[@(sender.tag)] = sender.stringValue;
+  ui_send([NSString stringWithFormat:@"text %ld %@", (long)sender.tag, sender.stringValue]);
+}
+
+/* A double-click is the choice made, and acted on. */
+- (IBAction)hitTableTwice:(NSTableView *)sender {
+  if (sender.clickedRow < 0) return;
+  [self choose:sender row:sender.clickedRow twice:YES];
+}
+
+- (IBAction)closeForm:(id)sender {
+  _dismissed = YES;
+  ui_send(@"close");
+}
+
+- (void)controlTextDidEndEditing:(NSNotification *)notification {
+  NSTextField *field = notification.object;
+
+  if ([field isKindOfClass:NSTextField.class] && field.tag >= 0) [self hitField:field];
+}
+
+- (NSInteger)numberOfRowsInTableView:(NSTableView *)tableView {
+  BODObject *o = [self objectAt:tableView.tag];
+
+  return o ? (NSInteger)o.items.count : 0;
+}
+
+- (NSView *)tableView:(NSTableView *)tableView viewForTableColumn:(NSTableColumn *)column row:(NSInteger)row {
+  NSTableCellView *cell = [tableView makeViewWithIdentifier:@"item" owner:self];
+  BODObject *o = [self objectAt:tableView.tag];
+  NSTextField *label;
+
+  if (cell == nil) {
+    cell = [[NSTableCellView alloc] initWithFrame:NSMakeRect(0, 0, 100, 20)];
+    cell.identifier = @"item";
+    label = [NSTextField labelWithString:@""];
+    label.lineBreakMode = NSLineBreakByTruncatingTail;
+    label.translatesAutoresizingMaskIntoConstraints = NO;
+    [cell addSubview:label];
+    cell.textField = label;
+    [NSLayoutConstraint activateConstraints:@[
+      [label.leadingAnchor constraintEqualToAnchor:cell.leadingAnchor constant:6],
+      [label.trailingAnchor constraintEqualToAnchor:cell.trailingAnchor constant:-6],
+      [label.centerYAnchor constraintEqualToAnchor:cell.centerYAnchor] ]];
+  }
+
+  cell.textField.stringValue = (o && row >= 0 && row < (NSInteger)o.items.count) ? o.items[row] : @"";
+
+  return cell;
+}
+
+- (void)tableViewSelectionDidChange:(NSNotification *)notification {
+  NSTableView *table = notification.object;
+
+  if (!_syncing && table.selectedRow >= 0) {
+    ui_send([NSString stringWithFormat:@"select %ld %ld", (long)table.tag, (long)table.selectedRow]);
+  }
+}
+
+@end
+
+/* -------------------------------------------------------------- the C side */
+
+static BODFormSheet *sheet;
+
+void liblsdl2_mac_form_attach(void *nswindow) {
+  NSWindow *window = (__bridge NSWindow *)nswindow;
+
+  if (sheet != nil || window == nil) return;
+
+  @autoreleasepool {
+    sheet = [[BODFormSheet alloc] init];
+    [sheet attachTo:window];
+  }
+}
+
+int liblsdl2_mac_form_wants_keys(void) {
+  return sheet != nil && [sheet wantsKeys];
+}
+
+int liblsdl2_mac_form_shown(void) {
+  return sheet != nil && [sheet shown];
+}
+
+void liblsdl2_mac_form_expect(void) {
+  [sheet expect];
+}
+
+void liblsdl2_mac_ui_send(const char *cmd) {
+  if (cmd) ui_send([NSString stringWithUTF8String:cmd]);
+}
+
+/* Not queued: a pause goes at once, and never takes a command's place. */
+void liblsdl2_mac_ui_pause(int on) {
+  if (!ui_ready()) return;
+  form_log(@"dialog: pause %d", on ? 1 : 0);
+  ui_command(on ? "pause 1" : "pause 0");
+}
+
+const char *liblsdl2_mac_ui_menubar(void) {
+  return ui_menubar_text ? ui_menubar_text.UTF8String : "";
+}
diff --git a/src/liblsdl2/liblsdl2_mac_keys.h b/src/liblsdl2/liblsdl2_mac_keys.h
new file mode 100644
index 0000000..f834b70
--- /dev/null
+++ b/src/liblsdl2/liblsdl2_mac_keys.h
@@ -0,0 +1,55 @@
+#ifndef LIBLSDL2_MAC_KEYS_H
+#define LIBLSDL2_MAC_KEYS_H
+
+/* Walking a sheet with the keyboard, whatever is on it (liblsdl2_mac_keys.m).
+ * Shared by the pause menu and the sheet that draws the game's dialogs. */
+
+#import <Cocoa/Cocoa.h>
+
+/* A sheet that offers every key press to its owner before anything on it
+ * sees it, so that the arrow keys can walk from control to control without
+ * the system's own keyboard navigation turning on. */
+@protocol BODKeyTarget <NSObject>
+- (BOOL)panelKeyDown:(NSEvent *)event;
+@end
+
+@interface BODKeyPanel : NSPanel
+@property (nonatomic, weak) id<BODKeyTarget> keyTarget;
+@end
+
+typedef NS_ENUM(NSInteger, BODDirection) {
+  BODDirectionUp,
+  BODDirectionDown,
+  BODDirectionLeft,
+  BODDirectionRight
+};
+
+/* The key codes these care about. */
+enum {
+  BODKeyReturn = 36, BODKeyTab = 48, BODKeySpace = 49, BODKeyDelete = 51,
+  BODKeyEscape = 53, BODKeyEnter = 76, BODKeyForwardDelete = 117,
+  BODKeyLeft = 123, BODKeyRight = 124, BODKeyDown = 125, BODKeyUp = 126
+};
+
+/* The arrow a key code is, or -1. */
+NSInteger bod_keys_direction(unsigned short keyCode);
+
+/* The controls under `root` that the keyboard can stop at, in reading order. */
+NSArray<NSView *> *bod_keys_controls(NSView *root);
+
+/* The nearest of `items` in `direction` from `from`: for up and down the
+ * nearest row that way and the control in it closest across, for left and
+ * right the nearest on the same line. nil if there is none. */
+NSView *bod_keys_toward(NSArray<NSView *> *items, NSView *from, BODDirection direction);
+
+/* Draws, or takes away, the ring that says where the keyboard is. */
+void bod_keys_mark(NSView *view, BOOL on);
+
+/* A symbol of libpumpkin's, which is loaded after this library. */
+void *liblsdl2_mac_symbol(const char *name);
+
+/* Runs `block` on the main thread after `delay` seconds, from inside SDL's
+ * event pump like everything else here. */
+void bod_keys_after(NSTimeInterval delay, void (^block)(void));
+
+#endif
diff --git a/src/liblsdl2/liblsdl2_mac_keys.m b/src/liblsdl2/liblsdl2_mac_keys.m
new file mode 100644
index 0000000..3529bc9
--- /dev/null
+++ b/src/liblsdl2/liblsdl2_mac_keys.m
@@ -0,0 +1,257 @@
+/* Walking a sheet with the keyboard, whatever is on it.
+ *
+ * The pause menu and the sheet that draws the game's dialogs are both walked
+ * the same way as their counterparts in the browser: the arrow keys move to
+ * the control that is that way on the screen, Return or Space presses it, and
+ * Escape goes back. macOS will only move the keyboard between buttons at all
+ * if Keyboard navigation is turned on in System Settings, and then only with
+ * Tab, so none of this is the system's: the sheet hands each key press to its
+ * owner before anything on it sees one (BODKeyPanel), and the owner decides
+ * where the keyboard is and draws the ring that says so.
+ *
+ * Where the controls are is where they are drawn, so a dialog nobody laid out
+ * by hand is walked the same way as the menu.
+ */
+
+#import <Cocoa/Cocoa.h>
+
+#include <dlfcn.h>
+#include <mach-o/dyld.h>
+#include <string.h>
+
+#include "liblsdl2_mac_keys.h"
+
+/* ------------------------------------------------------------ the panel */
+
+@implementation BODKeyPanel {
+  NSMutableSet<NSNumber *> *_down;   /* keys pressed since this panel had the keyboard */
+}
+
+- (BOOL)canBecomeKeyWindow {
+  return YES;
+}
+
+- (void)becomeKeyWindow {
+  [_down removeAllObjects];
+  [super becomeKeyWindow];
+}
+
+- (void)sendEvent:(NSEvent *)event {
+  if (event.type == NSEventTypeKeyUp) {
+    [_down removeObject:@(event.keyCode)];
+
+  } else if (event.type == NSEventTypeKeyDown) {
+    if (_down == nil) _down = [NSMutableSet set];
+    if (!event.isARepeat) {
+      [_down addObject:@(event.keyCode)];
+    } else if (![_down containsObject:@(event.keyCode)]) {
+      /* Held from before this sheet came up -- pedalling as a level ends and
+       * the game asks for a name. Those repeats were meant for the bike. */
+      return;
+    }
+
+    /* A Command chord is the menu bar's. */
+    if ((event.modifierFlags & NSEventModifierFlagCommand) == 0 &&
+        self.keyTarget != nil && [self.keyTarget panelKeyDown:event]) {
+      return;
+    }
+  }
+
+  [super sendEvent:event];
+}
+
+@end
+
+/* ----------------------------------------------------------- the controls */
+
+NSInteger bod_keys_direction(unsigned short keyCode) {
+  switch (keyCode) {
+    case BODKeyUp:    return BODDirectionUp;
+    case BODKeyDown:  return BODDirectionDown;
+    case BODKeyLeft:  return BODDirectionLeft;
+    case BODKeyRight: return BODDirectionRight;
+  }
+
+  return -1;
+}
+
+static BOOL bod_keys_stop(NSView *view) {
+  if (view.isHiddenOrHasHiddenAncestor || NSIsEmptyRect(view.bounds)) return NO;
+
+  if ([view isKindOfClass:NSTableView.class]) return YES;
+  if ([view isKindOfClass:NSTextField.class]) {
+    NSTextField *field = (NSTextField *)view;
+    return field.isEditable && field.isEnabled;
+  }
+  if ([view isKindOfClass:NSButton.class] || [view isKindOfClass:NSSegmentedControl.class] ||
+      [view isKindOfClass:NSSlider.class]) {
+    return ((NSControl *)view).isEnabled;
+  }
+  if ([view respondsToSelector:@selector(bodKeyStop)]) {
+    return ((BOOL (*)(id, SEL))[view methodForSelector:@selector(bodKeyStop)])(view, @selector(bodKeyStop));
+  }
+
+  return NO;
+}
+
+/* Where a view is, top-down, in its window. */
+typedef struct { CGFloat left, right, top, bottom; } bod_box;
+
+static bod_box bod_keys_box(NSView *view) {
+  NSRect r = [view convertRect:view.bounds toView:nil];
+  bod_box b = { NSMinX(r), NSMaxX(r), -NSMaxY(r), -NSMinY(r) };
+
+  return b;
+}
+
+static void bod_keys_collect(NSView *view, NSMutableArray<NSView *> *out) {
+  if (view.isHidden) return;
+  if (bod_keys_stop(view)) {
+    [out addObject:view];
+    return;
+  }
+  /* A control is one stop, and so is a table, not the cells in it. */
+  if ([view isKindOfClass:NSControl.class] || [view isKindOfClass:NSTableView.class]) return;
+
+  for (NSView *sub in view.subviews) bod_keys_collect(sub, out);
+}
+
+NSArray<NSView *> *bod_keys_controls(NSView *root) {
+  NSMutableArray<NSView *> *out = [NSMutableArray array];
+
+  if (root == nil) return out;
+  for (NSView *sub in root.subviews) bod_keys_collect(sub, out);
+
+  [out sortWithOptions:NSSortStable usingComparator:^NSComparisonResult(NSView *a, NSView *b) {
+    bod_box x = bod_keys_box(a), y = bod_keys_box(b);
+    if (fabs(x.top - y.top) > 4) return x.top < y.top ? NSOrderedAscending : NSOrderedDescending;
+    if (x.left != y.left) return x.left < y.left ? NSOrderedAscending : NSOrderedDescending;
+    return NSOrderedSame;
+  }];
+
+  return out;
+}
+
+NSView *bod_keys_toward(NSArray<NSView *> *items, NSView *from, BODDirection direction) {
+  BOOL vertical = direction == BODDirectionUp || direction == BODDirectionDown;
+  BOOL forward = direction == BODDirectionDown || direction == BODDirectionRight;
+  bod_box a = bod_keys_box(from), r;
+  CGFloat acx = (a.left + a.right) / 2, acy = (a.top + a.bottom) / 2;
+  CGFloat cx, cy, edge, across, score, bestEdge = 0, bestScore = CGFLOAT_MAX;
+  BOOL haveEdge = NO;
+  NSView *best = nil;
+
+  for (NSView *view in items) {
+    if (view == from) continue;
+    r = bod_keys_box(view);
+    cx = (r.left + r.right) / 2;
+    cy = (r.top + r.bottom) / 2;
+
+    if (vertical) {
+      if (forward ? !(cy > acy + 2 && r.top > a.top + 2) : !(cy < acy - 2 && r.bottom < a.bottom - 2)) continue;
+      edge = forward ? r.top : -r.bottom;
+      if (haveEdge && edge > bestEdge + 4) continue;
+      if (!haveEdge || edge < bestEdge - 4) {
+        bestEdge = edge;
+        haveEdge = YES;
+        bestScore = CGFLOAT_MAX;
+      }
+      across = MAX(0, MAX(r.left - a.right, a.left - r.right)) * 1000 + fabs(cx - acx);
+      if (across < bestScore) {
+        bestScore = across;
+        best = view;
+      }
+    } else {
+      if (forward ? !(cx > acx + 2 && r.left > a.left + 2) : !(cx < acx - 2 && r.right < a.right - 2)) continue;
+      if (r.bottom <= a.top || r.top >= a.bottom) continue;
+      score = (forward ? r.left - a.right : a.left - r.right) + fabs(cy - acy) * 4;
+      if (score < bestScore) {
+        bestScore = score;
+        best = view;
+      }
+    }
+  }
+
+  return best;
+}
+
+/* The ring is a view of its own, laid over the control just outside it, rather
+ * than a border on the control: a checkbox's box sits right at its edge, and a
+ * border drawn inside would cover it. It lets every click through. */
+@interface BODFocusRing : NSView
+@property (nonatomic, weak) NSView *target;
+@end
+
+@implementation BODFocusRing
+
+- (NSView *)hitTest:(NSPoint)point {
+  return nil;
+}
+
+- (void)drawRect:(NSRect)dirty {
+  NSBezierPath *path = [NSBezierPath bezierPathWithRoundedRect:NSInsetRect(self.bounds, 1.5, 1.5) xRadius:6 yRadius:6];
+
+  path.lineWidth = 3;
+  [[NSColor.controlAccentColor colorWithAlphaComponent:0.85] setStroke];
+  [path stroke];
+}
+
+@end
+
+void bod_keys_mark(NSView *view, BOOL on) {
+  static BODFocusRing *ring;
+  NSView *target = view;
+
+  if (view == nil) return;
+  if ([view isKindOfClass:NSTableView.class] && view.enclosingScrollView != nil) target = view.enclosingScrollView;
+  if (ring == nil) ring = [[BODFocusRing alloc] initWithFrame:NSZeroRect];
+
+  if (!on) {
+    if (ring.target == target) {
+      [ring removeFromSuperview];
+      ring.target = nil;
+    }
+    return;
+  }
+
+  if (target.superview == nil) return;
+  [target.superview layoutSubtreeIfNeeded];
+  ring.target = target;
+  ring.frame = NSInsetRect(target.frame, -4, -4);
+  [target.superview addSubview:ring positioned:NSWindowAbove relativeTo:target];
+  ring.needsDisplay = YES;
+}
+
+/* ------------------------------------------------------------- plumbing */
+
+/* libpumpkin is loaded after this library, by libos, and not necessarily into
+ * the global namespace; if the plain lookup misses, find it among the loaded
+ * images by name and ask it directly. */
+void *liblsdl2_mac_symbol(const char *name) {
+  static const char suffix[] = "/libpumpkin.dylib";
+  const char *image;
+  void *sym, *handle;
+  size_t n, m = sizeof(suffix) - 1;
+  uint32_t i;
+
+  if ((sym = dlsym(RTLD_DEFAULT, name)) != NULL) return sym;
+
+  for (i = 0; i < _dyld_image_count(); i++) {
+    image = _dyld_get_image_name(i);
+    n = image ? strlen(image) : 0;
+    if (n < m || strcmp(image + n - m, suffix) != 0) continue;
+    if ((handle = dlopen(image, RTLD_LAZY | RTLD_NOLOAD)) != NULL) {
+      sym = dlsym(handle, name);
+      dlclose(handle);
+      if (sym) return sym;
+    }
+  }
+
+  return NULL;
+}
+
+void bod_keys_after(NSTimeInterval delay, void (^block)(void)) {
+  NSTimer *timer = [NSTimer timerWithTimeInterval:delay repeats:NO block:^(NSTimer *t) { block(); }];
+
+  [[NSRunLoop mainRunLoop] addTimer:timer forMode:NSRunLoopCommonModes];
+}
diff --git a/src/liblsdl2/liblsdl2_mac_pause.m b/src/liblsdl2/liblsdl2_mac_pause.m
new file mode 100644
index 0000000..e2ee349
--- /dev/null
+++ b/src/liblsdl2/liblsdl2_mac_pause.m
@@ -0,0 +1,1013 @@
+/* The pause menu, in the macOS window.
+ *
+ * Escape, the Pause button in the title bar, or putting the window away, and
+ * the game stops -- really stops: the runtime holds the game's thread and
+ * leaves the time out of its clock ("pause 1", bodui.c), so it carries on from
+ * the moment it stopped. A sheet comes down over it with everything that is
+ * not riding in it, the same as the browser build's pause menu:
+ *
+ *     Resume, Restart / Next / Previous level
+ *     Choose a level...         the game's own level list
+ *     Level packs...            the level pack sheet (liblsdl2_mac.m)
+ *     Controls                  the key each riding action answers to
+ *     Settings                  Screen, and the game's Options menu
+ *     Profiles & records        the rest of the game's Game and Rec menus
+ *     Help                      the game's Help menu
+ *
+ * It is walked with the keyboard: up and down move, left and right change a
+ * row of choices, Return or Space picks, Escape goes back a page and then
+ * resumes. The mouse works too.
+ *
+ * The game's dialogs open from here the way they open from its menu, with the
+ * game still held, drawn by the dialog sheet (liblsdl2_mac_form.m). A window
+ * has one sheet at a time, so this one steps aside for the dialog's and comes
+ * back when the dialog is dismissed -- Escape, Cancel, OK, Close, Done. A
+ * dialog left some other way, Play this level or a replay, ends the pause,
+ * since that is what was asked for. The level pack sheet is the same: back
+ * here without a choice, and riding with one.
+ *
+ * The keys chosen on the Controls page go to the runtime through
+ * pumpkin_set_ride_keys() and are kept in the user defaults, like the Screen
+ * setting; BOD_KEYS, when it is set, is what a run starts with instead.
+ *
+ * Everything here runs on the main thread, inside SDL's event pump.
+ */
+
+#import <Cocoa/Cocoa.h>
+
+#include <stdint.h>
+#include <stdlib.h>
+
+#include <SDL2/SDL.h>
+
+#include "liblsdl2_mac.h"
+#include "liblsdl2_mac_keys.h"
+#include "liblsdl2_screen.h"
+
+#define SHEET_WIDTH      440.0
+#define SHEET_INSET      16.0
+#define ROW_HEIGHT       26.0
+#define WAIT_FOR_DIALOG  1.2    /* how long a game item has to put a dialog up */
+
+static NSString *const kDefaultsSuite = @"local.bikeordie2";
+static NSString *const kKeysKey = @"Keys";
+static NSString *const kDefaultKeys = @"forward=w brake=s left=a right=d flip=space";
+
+static void pause_log(NSString *format, ...) NS_FORMAT_FUNCTION(1, 2);
+
+static void pause_log(NSString *format, ...) {
+  NSString *text;
+  va_list args;
+
+  va_start(args, format);
+  text = [[NSString alloc] initWithFormat:format arguments:args];
+  va_end(args);
+  liblsdl2_log(text.UTF8String);
+}
+
+/* ------------------------------------------------------------- the keys */
+
+static NSUserDefaults *pause_defaults(void) {
+  return [[NSUserDefaults alloc] initWithSuiteName:kDefaultsSuite];
+}
+
+/* The riding keys as the runtime has them, the way BOD_KEYS writes them. */
+static NSString *keys_spec(void) {
+  char *(*get)(void) = liblsdl2_mac_symbol("pumpkin_get_ride_keys");
+  const char *spec = get ? get() : NULL;
+
+  return spec ? [NSString stringWithUTF8String:spec] : kDefaultKeys;
+}
+
+static BOOL keys_set(NSString *spec) {
+  void (*set)(const char *) = liblsdl2_mac_symbol("pumpkin_set_ride_keys");
+
+  if (set == NULL) return NO;
+  set(spec.UTF8String);
+  [pause_defaults() setObject:keys_spec() forKey:kKeysKey];
+  return YES;
+}
+
+/* The first key `action` answers to, as BOD_KEYS names it; "" for none. */
+static NSString *keys_first(NSString *spec, NSString *action) {
+  NSString *prefix = [action stringByAppendingString:@"="];
+
+  for (NSString *entry in [spec componentsSeparatedByCharactersInSet:NSCharacterSet.whitespaceCharacterSet]) {
+    if ([entry hasPrefix:prefix]) {
+      return [[entry substringFromIndex:prefix.length] componentsSeparatedByString:@","].firstObject ?: @"";
+    }
+  }
+
+  return @"";
+}
+
+static NSString *keys_printed(NSString *name) {
+  static NSDictionary<NSString *, NSString *> *named;
+
+  if (named == nil) {
+    named = @{ @"space": @"Space", @"enter": @"Return", @"tab": @"Tab", @"esc": @"Esc",
+               @"backspace": @"⌫", @"up": @"↑", @"down": @"↓", @"left": @"←", @"right": @"→",
+               @"pgup": @"Page Up", @"pgdown": @"Page Down", @"home": @"Home", @"end": @"End",
+               @"ins": @"Ins", @"del": @"⌦" };
+  }
+  if (name.length == 0) return @"—";
+
+  return named[name] ?: name.uppercaseString;
+}
+
+/* What BOD_KEYS calls the key an event is, or nil for one it has no name for. */
+static NSString *keys_name(NSEvent *event) {
+  NSString *c;
+  unichar ch;
+
+  switch (event.keyCode) {
+    case BODKeySpace: return @"space";
+    case BODKeyReturn:
+    case BODKeyEnter: return @"enter";
+    case BODKeyTab:   return @"tab";
+    case 116: return @"pgup";
+    case 121: return @"pgdown";
+    case 115: return @"home";
+    case 119: return @"end";
+    case 114: return @"ins";
+    case 122: return @"f1";
+    case 120: return @"f2";
+    case 99:  return @"f3";
+    case 118: return @"f4";
+    case 96:  return @"f5";
+    case 97:  return @"f6";
+    case 98:  return @"f7";
+    case 100: return @"f8";
+    case 101: return @"f9";
+    case 109: return @"f10";
+    case 103: return @"f11";
+    case 111: return @"f12";
+  }
+
+  c = event.charactersIgnoringModifiers.lowercaseString;
+  if (c.length != 1) return nil;
+  ch = [c characterAtIndex:0];
+
+  return ch > ' ' && ch < 127 ? c : nil;
+}
+
+/* --------------------------------------------------------------- a row */
+
+typedef NS_ENUM(NSInteger, BODRowKind) {
+  BODRowAction,     /* does something */
+  BODRowPage,       /* opens a page of the menu */
+  BODRowChoice,     /* one of a few, changed with left and right */
+  BODRowBinding,    /* a riding action and its key */
+  BODRowHeading,
+  BODRowRule,
+  BODRowNote
+};
+
+@class BODPauseMenu;
+
+@interface BODMenuRow : NSView
+@property (nonatomic) BODRowKind kind;
+@property (nonatomic, copy) NSString *key;       /* what it is remembered by */
+@property (nonatomic, copy) NSString *title;
+@property (nonatomic, copy) NSString *detail;    /* a shortcut, a key, the alternative */
+@property (nonatomic, copy) NSArray<NSString *> *choices;
+@property (nonatomic) NSInteger chosen;
+@property (nonatomic) BOOL focused;
+@property (nonatomic) BOOL listening;
+@property (nonatomic, weak) BODPauseMenu *owner;
+- (BOOL)bodKeyStop;
+@end
+
+@interface BODPauseMenu : NSObject <BODKeyTarget>
+- (void)attachTo:(NSWindow *)window;
+- (BOOL)open;
+- (void)resume;
+- (BOOL)wantsKeys;
+- (BOOL)session;
+- (void)stepAside;
+- (void)dialogClosed:(BOOL)dismissed;
+- (void)hideForPacks;
+- (void)backFromPacks;
+- (void)rowClicked:(BODMenuRow *)row;
+- (void)row:(BODMenuRow *)row choose:(NSInteger)index;
+@end
+
+@implementation BODMenuRow {
+  NSMutableArray<NSValue *> *_segments;   /* where each choice was drawn, for a click */
+}
+
+- (BOOL)isFlipped {
+  return YES;
+}
+
+- (BOOL)acceptsFirstMouse:(NSEvent *)event {
+  return YES;
+}
+
+- (BOOL)bodKeyStop {
+  return self.kind == BODRowAction || self.kind == BODRowPage || self.kind == BODRowChoice || self.kind == BODRowBinding;
+}
+
++ (NSDictionary *)noteAttributes {
+  NSMutableParagraphStyle *style = [[NSMutableParagraphStyle alloc] init];
+
+  style.lineBreakMode = NSLineBreakByWordWrapping;
+  return @{ NSFontAttributeName: [NSFont systemFontOfSize:NSFont.smallSystemFontSize],
+            NSForegroundColorAttributeName: NSColor.secondaryLabelColor,
+            NSParagraphStyleAttributeName: style };
+}
+
+- (NSSize)intrinsicContentSize {
+  NSRect r;
+
+  switch (self.kind) {
+    case BODRowRule:    return NSMakeSize(NSViewNoIntrinsicMetric, 11);
+    case BODRowHeading: return NSMakeSize(NSViewNoIntrinsicMetric, 26);
+    case BODRowNote:
+      r = [self.title boundingRectWithSize:NSMakeSize(SHEET_WIDTH - 2 * SHEET_INSET - 20, 1000)
+                                   options:NSStringDrawingUsesLineFragmentOrigin
+                                attributes:[BODMenuRow noteAttributes]];
+      return NSMakeSize(NSViewNoIntrinsicMetric, ceil(NSHeight(r)) + 8);
+    default:
+      return NSMakeSize(NSViewNoIntrinsicMetric, ROW_HEIGHT);
+  }
+}
+
+- (void)setFocused:(BOOL)focused {
+  _focused = focused;
+  self.needsDisplay = YES;
+}
+
+- (void)setListening:(BOOL)listening {
+  _listening = listening;
+  self.needsDisplay = YES;
+}
+
+- (void)setChosen:(NSInteger)chosen {
+  _chosen = chosen;
+  self.needsDisplay = YES;
+}
+
+- (void)setDetail:(NSString *)detail {
+  _detail = [detail copy];
+  self.needsDisplay = YES;
+}
+
+- (void)drawText:(NSString *)text at:(CGFloat)x font:(NSFont *)font color:(NSColor *)color {
+  NSDictionary *attributes = @{ NSFontAttributeName: font, NSForegroundColorAttributeName: color };
+  NSSize size = [text sizeWithAttributes:attributes];
+
+  [text drawAtPoint:NSMakePoint(x, floor((NSHeight(self.bounds) - size.height) / 2)) withAttributes:attributes];
+}
+
+- (void)drawRect:(NSRect)dirty {
+  NSRect b = self.bounds, cap;
+  NSFont *font = [NSFont systemFontOfSize:NSFont.systemFontSize];
+  NSFont *small = [NSFont systemFontOfSize:NSFont.smallSystemFontSize];
+  NSColor *text = NSColor.labelColor, *soft = NSColor.secondaryLabelColor;
+  NSDictionary *attributes;
+  NSString *label;
+  CGFloat x, w;
+  NSInteger i;
+
+  switch (self.kind) {
+    case BODRowRule:
+      [NSColor.separatorColor setFill];
+      NSRectFill(NSMakeRect(10, floor(NSMidY(b)), NSWidth(b) - 20, 1));
+      return;
+
+    case BODRowHeading:
+      attributes = @{ NSFontAttributeName: [NSFont systemFontOfSize:11 weight:NSFontWeightSemibold],
+                      NSForegroundColorAttributeName: NSColor.tertiaryLabelColor };
+      [self.title.uppercaseString drawAtPoint:NSMakePoint(10, 9) withAttributes:attributes];
+      return;
+
+    case BODRowNote:
+      [self.title drawWithRect:NSMakeRect(10, 3, NSWidth(b) - 20, NSHeight(b) - 6)
+                       options:NSStringDrawingUsesLineFragmentOrigin
+                    attributes:[BODMenuRow noteAttributes]];
+      return;
+
+    default:
+      break;
+  }
+
+  if (self.focused) {
+    [NSColor.controlAccentColor setFill];
+    [[NSBezierPath bezierPathWithRoundedRect:NSInsetRect(b, 2, 1) xRadius:5 yRadius:5] fill];
+    text = NSColor.alternateSelectedControlTextColor;
+    soft = [NSColor.alternateSelectedControlTextColor colorWithAlphaComponent:0.75];
+  }
+
+  [self drawText:self.title at:10 font:font color:text];
+
+  switch (self.kind) {
+    case BODRowPage:
+      label = @"›";
+      attributes = @{ NSFontAttributeName: [NSFont systemFontOfSize:16], NSForegroundColorAttributeName: soft };
+      [self drawText:label at:NSWidth(b) - 10 - [label sizeWithAttributes:attributes].width
+                font:[NSFont systemFontOfSize:16] color:soft];
+      break;
+
+    case BODRowAction:
+      if (self.detail.length) {
+        attributes = @{ NSFontAttributeName: small };
+        [self drawText:self.detail at:NSWidth(b) - 10 - [self.detail sizeWithAttributes:attributes].width font:small color:soft];
+      }
+      break;
+
+    case BODRowBinding:
+      /* The key, in a cap; what else does the same, on the right. */
+      label = self.listening ? @"Press a key" : self.detail;
+      attributes = @{ NSFontAttributeName: [NSFont monospacedSystemFontOfSize:NSFont.smallSystemFontSize weight:NSFontWeightMedium] };
+      w = MAX(64, [label sizeWithAttributes:attributes].width + 16);
+      cap = NSMakeRect(130, floor((NSHeight(b) - 18) / 2), w, 18);
+      if (self.listening) {
+        [(self.focused ? NSColor.alternateSelectedControlTextColor : NSColor.controlAccentColor) setFill];
+        [[NSBezierPath bezierPathWithRoundedRect:cap xRadius:4 yRadius:4] fill];
+      } else {
+        [soft setStroke];
+        [[NSBezierPath bezierPathWithRoundedRect:NSInsetRect(cap, 0.5, 0.5) xRadius:4 yRadius:4] stroke];
+      }
+      attributes = @{ NSFontAttributeName: attributes[NSFontAttributeName],
+                      NSForegroundColorAttributeName: self.listening ? (self.focused ? NSColor.controlAccentColor : NSColor.alternateSelectedControlTextColor) : text };
+      [label drawAtPoint:NSMakePoint(NSMidX(cap) - [label sizeWithAttributes:attributes].width / 2,
+                                     NSMinY(cap) + (18 - [label sizeWithAttributes:attributes].height) / 2)
+          withAttributes:attributes];
+      label = [@"or " stringByAppendingString:self.choices.firstObject ?: @""];
+      [self drawText:label at:NSWidth(b) - 10 - [label sizeWithAttributes:@{ NSFontAttributeName: small }].width font:small color:soft];
+      break;
+
+    case BODRowChoice:
+      /* The choices, right-aligned, the chosen one filled in. */
+      _segments = [NSMutableArray array];
+      x = NSWidth(b) - 8;
+      for (i = (NSInteger)self.choices.count - 1; i >= 0; i--) {
+        attributes = @{ NSFontAttributeName: small };
+        w = [self.choices[i] sizeWithAttributes:attributes].width + 18;
+        x -= w;
+        [_segments insertObject:[NSValue valueWithRect:NSMakeRect(x, 0, w, NSHeight(b))] atIndex:0];
+        cap = NSMakeRect(x, floor((NSHeight(b) - 18) / 2), w - 2, 18);
+        if (i == self.chosen) {
+          [(self.focused ? NSColor.alternateSelectedControlTextColor : NSColor.controlAccentColor) setFill];
+          [[NSBezierPath bezierPathWithRoundedRect:cap xRadius:4 yRadius:4] fill];
+        }
+        [self.choices[i] drawAtPoint:NSMakePoint(NSMinX(cap) + 8, NSMinY(cap) + (18 - [self.choices[i] sizeWithAttributes:attributes].height) / 2)
+                      withAttributes:@{ NSFontAttributeName: small,
+                                        NSForegroundColorAttributeName: i == self.chosen ?
+                                          (self.focused ? NSColor.controlAccentColor : NSColor.alternateSelectedControlTextColor) : soft }];
+      }
+      break;
+
+    default:
+      break;
+  }
+}
+
+- (void)mouseDown:(NSEvent *)event {
+  NSPoint p = [self convertPoint:event.locationInWindow fromView:nil];
+  NSInteger i;
+
+  if (![self bodKeyStop]) return;
+
+  if (self.kind == BODRowChoice) {
+    for (i = 0; i < (NSInteger)_segments.count; i++) {
+      if (NSPointInRect(p, _segments[i].rectValue)) {
+        [self.owner row:self choose:i];
+        return;
+      }
+    }
+  }
+  [self.owner rowClicked:self];
+}
+
+@end
+
+/* ------------------------------------------------------------- the menu */
+
+@implementation BODPauseMenu {
+  __weak NSWindow *_window;
+
+  BODKeyPanel *_sheet;
+  NSTextField *_heading;
+  NSTextField *_where;
+  NSScrollView *_scroll;
+  NSStackView *_rows;
+  NSLayoutConstraint *_scrollHeight;
+  BODMenuRow *_screenNote;
+
+  NSString *_page;
+  NSMutableDictionary<NSString *, NSString *> *_memo;   /* the row last chosen on each page */
+  NSDictionary<NSString *, NSString *> *_returnTo;      /* where a dialog comes back to */
+  BOOL _session;                                        /* the game is held */
+  BODMenuRow *_focus;
+  BODMenuRow *_listening;
+  BOOL _waiting;                                        /* for a game item's dialog */
+  NSUInteger _waitToken;
+  NSTimer *_keysTimer;
+}
+
+- (void)attachTo:(NSWindow *)window {
+  _window = window;
+  _page = @"main";
+  _memo = [NSMutableDictionary dictionary];
+
+  /* The keys kept from last time go to the runtime once it is there to take
+   * them -- libpumpkin is loaded after this library. */
+  _keysTimer = [NSTimer timerWithTimeInterval:0.5 target:self selector:@selector(applyKeptKeys:) userInfo:nil repeats:YES];
+  [[NSRunLoop mainRunLoop] addTimer:_keysTimer forMode:NSRunLoopCommonModes];
+
+  /* A window put away with the bike moving is a game left running with nobody
+   * at it. */
+  [[NSNotificationCenter defaultCenter] addObserver:self selector:@selector(putAway:)
+                                               name:NSWindowWillMiniaturizeNotification object:window];
+  [[NSNotificationCenter defaultCenter] addObserver:self selector:@selector(putAway:)
+                                               name:NSApplicationWillHideNotification object:nil];
+}
+
+- (void)applyKeptKeys:(NSTimer *)timer {
+  const char *env = getenv("BOD_KEYS");
+  NSString *kept = [pause_defaults() stringForKey:kKeysKey];
+  void (*set)(const char *);
+
+  if ((env != NULL && env[0] != 0) || kept.length == 0) {
+    [timer invalidate];
+    return;
+  }
+  if ((set = liblsdl2_mac_symbol("pumpkin_set_ride_keys")) == NULL) return;
+  set(kept.UTF8String);
+  pause_log(@"pause menu: riding keys from last time, %@", kept);
+  [timer invalidate];
+}
+
+- (void)putAway:(NSNotification *)notification {
+  if (!_session && !liblsdl2_mac_wants_keys()) [self open];
+}
+
+- (BOOL)ready {
+  return _window != nil && liblsdl2_mac_symbol("bod_ui_command") != NULL;
+}
+
+- (BOOL)session {
+  return _session;
+}
+
+- (BOOL)wantsKeys {
+  return _sheet != nil && (_sheet.sheetParent != nil || _sheet.isVisible);
+}
+
+- (void)hold:(BOOL)on {
+  if (_session == on) return;
+  _session = on;
+  liblsdl2_mac_ui_pause(on);
+  liblsdl2_mac_pause_changed(on);
+  pause_log(@"pause menu: game %@", on ? @"held" : @"let go");
+}
+
+- (BOOL)open {
+  BOOL fresh = !_session;
+
+  if (![self ready]) return NO;
+  /* A dialog of the game's, or the pack sheet, has the window: the game is
+   * stopped under it already, and a sheet cannot go over a sheet. */
+  if (_window.attachedSheet != nil && _window.attachedSheet != _sheet) return NO;
+  [self hold:YES];
+  /* A new pause starts on Resume, so that Escape twice is always there and back. */
+  [self show:@"main" focus:fresh ? @"resume" : nil];
+
+  return YES;
+}
+
+- (void)resume {
+  _waitToken++;
+  _waiting = NO;
+  _returnTo = nil;
+  [self stopListening];
+  [self endSheet];
+  [self hold:NO];
+}
+
+- (void)back {
+  if ([_page isEqualToString:@"main"]) [self resume];
+  else [self show:@"main" focus:[@"page:" stringByAppendingString:_page]];
+}
+
+/* --------------------------------------------------------- the sheet */
+
+- (void)buildSheet {
+  NSStackView *content, *head;
+  NSTextField *hint;
+
+  if (_sheet) return;
+
+  _sheet = [[BODKeyPanel alloc] initWithContentRect:NSMakeRect(0, 0, SHEET_WIDTH, 420)
+                                          styleMask:NSWindowStyleMaskTitled
+                                            backing:NSBackingStoreBuffered
+                                              defer:YES];
+  _sheet.releasedWhenClosed = NO;
+  _sheet.keyTarget = self;
+
+  _heading = [NSTextField labelWithString:@"Paused"];
+  _heading.font = [NSFont boldSystemFontOfSize:NSFont.systemFontSize + 2];
+  _where = [NSTextField labelWithString:@""];
+  _where.textColor = NSColor.secondaryLabelColor;
+  _where.lineBreakMode = NSLineBreakByTruncatingTail;
+  [_where setContentCompressionResistancePriority:NSLayoutPriorityDefaultLow forOrientation:NSLayoutConstraintOrientationHorizontal];
+  head = [NSStackView stackViewWithViews:@[ _heading, _where ]];
+  head.orientation = NSUserInterfaceLayoutOrientationHorizontal;
+  head.alignment = NSLayoutAttributeFirstBaseline;
+  head.spacing = 10;
+
+  _rows = [[NSStackView alloc] init];
+  _rows.orientation = NSUserInterfaceLayoutOrientationVertical;
+  _rows.alignment = NSLayoutAttributeLeading;
+  _rows.spacing = 0;
+  _rows.translatesAutoresizingMaskIntoConstraints = NO;
+
+  _scroll = [[NSScrollView alloc] init];
+  _scroll.documentView = _rows;
+  _scroll.hasVerticalScroller = YES;
+  _scroll.autohidesScrollers = YES;
+  _scroll.drawsBackground = NO;
+  _scroll.borderType = NSNoBorder;
+  [NSLayoutConstraint activateConstraints:@[
+    [_rows.leadingAnchor constraintEqualToAnchor:_scroll.contentView.leadingAnchor],
+    [_rows.trailingAnchor constraintEqualToAnchor:_scroll.contentView.trailingAnchor],
+    [_rows.topAnchor constraintEqualToAnchor:_scroll.contentView.topAnchor] ]];
+
+  hint = [NSTextField labelWithString:@"↑ ↓ choose    ← → change    Return select    Esc back"];
+  hint.font = [NSFont systemFontOfSize:NSFont.smallSystemFontSize];
+  hint.textColor = NSColor.tertiaryLabelColor;
+
+  content = [NSStackView stackViewWithViews:@[ head, _scroll, hint ]];
+  content.orientation = NSUserInterfaceLayoutOrientationVertical;
+  content.alignment = NSLayoutAttributeLeading;
+  content.spacing = 10;
+  content.edgeInsets = NSEdgeInsetsMake(SHEET_INSET, SHEET_INSET, 14, SHEET_INSET);
+  _sheet.contentView = content;
+
+  for (NSView *view in @[ head, _scroll, hint ]) {
+    [view.widthAnchor constraintEqualToAnchor:content.widthAnchor constant:-2 * SHEET_INSET].active = YES;
+  }
+  [content.widthAnchor constraintEqualToConstant:SHEET_WIDTH].active = YES;
+  _scrollHeight = [_scroll.heightAnchor constraintEqualToConstant:300];
+  _scrollHeight.active = YES;
+}
+
+- (void)endSheet {
+  NSWindow *parent = _sheet.sheetParent;
+
+  if (_sheet == nil) return;
+  [self stopListening];
+  if (parent || _sheet.isVisible) liblsdl2_mac_sheet_closed();
+  if (parent) [parent endSheet:_sheet];
+  [_sheet orderOut:nil];
+}
+
+- (void)show:(NSString *)page focus:(NSString *)key {
+  static NSDictionary<NSString *, NSString *> *titles;
+  NSWindow *window = _window;
+  BODMenuRow *target = nil;
+  CGFloat height = 0;
+
+  if (window == nil) return;
+  if (titles == nil) {
+    titles = @{ @"main": @"Paused", @"controls": @"Controls", @"settings": @"Settings",
+                @"records": @"Profiles & records", @"help": @"Help" };
+  }
+  if (titles[page] == nil) page = @"main";
+
+  [self buildSheet];
+  [self stopListening];
+  _waitToken++;
+  _waiting = NO;
+  _rows.alphaValue = 1;
+  _page = page;
+  _heading.stringValue = titles[page];
+  _where.stringValue = [page isEqualToString:@"main"] ? [NSString stringWithUTF8String:liblsdl2_mac_pack_title()] : @"";
+
+  [self buildRows];
+  for (NSView *row in _rows.arrangedSubviews) height += row.intrinsicContentSize.height;
+  _scrollHeight.constant = MIN(height, MAX(160, NSHeight(window.contentView.frame) - 150));
+  [_sheet.contentView layoutSubtreeIfNeeded];
+
+  if (_sheet.sheetParent == nil) [window beginSheet:_sheet completionHandler:nil];
+  [_sheet makeFirstResponder:nil];
+
+  if (key == nil) key = _memo[page];
+  for (BODMenuRow *row in _rows.arrangedSubviews) {
+    if (key && [row.key isEqualToString:key] && [row bodKeyStop]) { target = row; break; }
+  }
+  [self focusRow:target ?: [self stops].firstObject];
+  [_scroll.contentView scrollToPoint:NSZeroPoint];
+  if (_focus) [_focus scrollRectToVisible:_focus.bounds];
+}
+
+/* ------------------------------------------------------------ the pages */
+
+- (BODMenuRow *)add:(BODRowKind)kind key:(NSString *)key title:(NSString *)title detail:(NSString *)detail {
+  BODMenuRow *row = [[BODMenuRow alloc] initWithFrame:NSMakeRect(0, 0, SHEET_WIDTH - 2 * SHEET_INSET, ROW_HEIGHT)];
+
+  row.kind = kind;
+  row.key = key;
+  row.title = title ?: @"";
+  row.detail = detail;
+  row.owner = self;
+  row.translatesAutoresizingMaskIntoConstraints = NO;
+  [_rows addArrangedSubview:row];
+  [row.widthAnchor constraintEqualToAnchor:_rows.widthAnchor].active = YES;
+
+  return row;
+}
+
+- (void)rule {
+  [self add:BODRowRule key:nil title:nil detail:nil];
+}
+
+- (void)buildRows {
+  for (NSView *view in _rows.arrangedSubviews.copy) {
+    [_rows removeArrangedSubview:view];
+    [view removeFromSuperview];
+  }
+  _focus = nil;
+  _screenNote = nil;
+
+  if ([_page isEqualToString:@"main"]) {
+    [self add:BODRowAction key:@"resume" title:@"Resume" detail:@"Esc"];
+    [self add:BODRowAction key:@"restart" title:@"Restart level" detail:@"⌘R"];
+    [self add:BODRowAction key:@"next" title:@"Next level" detail:@"⌘]"];
+    [self add:BODRowAction key:@"prev" title:@"Previous level" detail:@"⌘["];
+    [self rule];
+    [self add:BODRowAction key:@"levels" title:@"Choose a level…" detail:@"⇧⌘L"];
+    [self add:BODRowAction key:@"packs" title:@"Level packs…" detail:@"⌘L"];
+    [self rule];
+    [self add:BODRowPage key:@"page:controls" title:@"Controls" detail:nil];
+    [self add:BODRowPage key:@"page:settings" title:@"Settings" detail:nil];
+    [self add:BODRowPage key:@"page:records" title:@"Profiles & records" detail:nil];
+    [self add:BODRowPage key:@"page:help" title:@"Help" detail:nil];
+
+  } else if ([_page isEqualToString:@"controls"]) {
+    NSString *spec = keys_spec();
+    NSArray<NSArray<NSString *> *> *actions = @[ @[ @"forward", @"Forward", @"↑" ], @[ @"brake", @"Brake", @"↓" ],
+                                                 @[ @"left", @"Balance left", @"←" ], @[ @"right", @"Balance right", @"→" ],
+                                                 @[ @"flip", @"Flip", @"F9" ] ];
+    for (NSArray<NSString *> *a in actions) {
+      BODMenuRow *row = [self add:BODRowBinding key:[@"bind:" stringByAppendingString:a[0]] title:a[1]
+                           detail:keys_printed(keys_first(spec, a[0]))];
+      row.choices = @[ a[2] ];
+    }
+    [self add:BODRowNote key:nil title:@"Choose one and press the key you want. Delete takes it away and Esc leaves it as it was. The arrow keys always ride too." detail:nil];
+    [self rule];
+    [self add:BODRowAction key:@"default-keys" title:@"Default keys" detail:nil];
+    [self add:BODRowAction key:@"game-controls" title:@"The game’s own control options…" detail:nil];
+    [self rule];
+    [self add:BODRowAction key:@"back" title:@"Back" detail:nil];
+
+  } else if ([_page isEqualToString:@"settings"]) {
+    BODMenuRow *screen = [self add:BODRowChoice key:@"screen" title:@"Screen" detail:nil];
+    screen.choices = @[ @"Pixels", @"Smooth", @"xBR" ];
+    screen.chosen = liblsdl2_screen_get();
+    _screenNote = [self add:BODRowNote key:nil title:[self screenNote:screen.chosen] detail:nil];
+    [self gameMenus:@"options"];
+    [self rule];
+    [self add:BODRowAction key:@"back" title:@"Back" detail:nil];
+
+  } else {
+    [self gameMenus:_page];
+    [self rule];
+    [self add:BODRowAction key:@"back" title:@"Back" detail:nil];
+  }
+}
+
+- (NSString *)screenNote:(NSInteger)mode {
+  switch (mode) {
+    case SCREEN_PIXELS: return @"The game’s own 320×320 pixels, each drawn as a square, the way a Palm showed them.";
+    case SCREEN_SMOOTH: return @"Blended between pixels: no stair-steps, and softer everywhere.";
+    default:            return @"Upscaled with xBR to this display’s resolution: edges, wheels and lettering are redrawn as smooth lines, and textures keep their detail.";
+  }
+}
+
+/* The rest of a line after `n` spaces: a label may hold spaces of its own. */
+static NSString *rest_of(NSString *line, NSInteger n) {
+  NSRange r = NSMakeRange(0, line.length);
+  NSInteger i;
+
+  for (i = 0; i < n; i++) {
+    NSRange space = [line rangeOfString:@" " options:0 range:r];
+    if (space.location == NSNotFound) return @"";
+    r = NSMakeRange(space.location + 1, line.length - space.location - 1);
+  }
+
+  return [line substringFromIndex:r.location];
+}
+
+/* The game's own menu, spread over the pages it belongs on: its Options under
+ * Settings, its Help under Help, and the rest -- profiles, statistics,
+ * recordings -- on a page of their own. What is left out has a place already
+ * or none: the level items are on the first page, the game's own Pause is
+ * this, Quit is the application's, and beaming the game to another Palm has
+ * nowhere to go. */
+- (void)gameMenus:(NSString *)page {
+  static NSSet<NSNumber *> *skip;
+  NSString *text = [NSString stringWithUTF8String:liblsdl2_mac_ui_menubar()];
+  NSString *title = nil, *into = nil;
+  NSInteger menu = -1, count = 0;
+  BOOL gap = NO;
+
+  if (skip == nil) skip = [NSSet setWithArray:@[ @100, @101, @102, @110, @120, @198, @199 ]];
+
+  for (NSString *line in [text componentsSeparatedByString:@"\n"]) {
+    NSArray<NSString *> *w = [line componentsSeparatedByString:@" "];
+    NSString *label;
+
+    if (w.count >= 2 && [w[0] isEqualToString:@"menu"]) {
+      menu = w[1].integerValue;
+      title = rest_of(line, 2);
+      into = [title caseInsensitiveCompare:@"Options"] == NSOrderedSame ? @"options" :
+             [title caseInsensitiveCompare:@"Help"] == NSOrderedSame ? @"help" : @"records";
+      count = 0;
+      gap = NO;
+      continue;
+    }
+    if (w.count < 4 || ![w[0] isEqualToString:@"mitem"] || ![into isEqualToString:page]) continue;
+
+    label = rest_of(line, 4);
+    if ([label hasPrefix:@"-"]) { gap = count > 0; continue; }
+    if ([skip containsObject:@(w[3].integerValue)]) continue;
+
+    if (count == 0 && ![page isEqualToString:@"help"]) {
+      [self add:BODRowHeading key:nil
+          title:[title isEqualToString:@"Options"] ? @"The game’s options" : [title isEqualToString:@"Rec"] ? @"Recordings" : title
+         detail:nil];
+    } else if (gap) {
+      [self rule];
+    }
+    gap = NO;
+    [self add:BODRowAction key:[NSString stringWithFormat:@"menu:%ld %@", (long)menu, w[2]] title:label detail:nil];
+    count++;
+  }
+
+  if (text.length == 0) {
+    [self add:BODRowNote key:nil title:@"The game has not put its menu up yet." detail:nil];
+  }
+}
+
+/* The game item with this id, as "menu item" for a pick. */
+- (NSString *)menuItem:(NSInteger)itemId {
+  NSString *text = [NSString stringWithUTF8String:liblsdl2_mac_ui_menubar()];
+
+  for (NSString *line in [text componentsSeparatedByString:@"\n"]) {
+    NSArray<NSString *> *w = [line componentsSeparatedByString:@" "];
+    if (w.count >= 4 && [w[0] isEqualToString:@"mitem"] && w[3].integerValue == itemId) {
+      return [NSString stringWithFormat:@"%@ %@", w[1], w[2]];
+    }
+  }
+
+  return nil;
+}
+
+/* ------------------------------------------------------------- the keys */
+
+- (NSArray<BODMenuRow *> *)stops {
+  NSMutableArray<BODMenuRow *> *out = [NSMutableArray array];
+
+  for (BODMenuRow *row in _rows.arrangedSubviews) {
+    if ([row bodKeyStop]) [out addObject:row];
+  }
+
+  return out;
+}
+
+- (void)focusRow:(BODMenuRow *)row {
+  if (_focus == row) return;
+  _focus.focused = NO;
+  _focus = row;
+  row.focused = YES;
+  if (row) [row scrollRectToVisible:row.bounds];
+}
+
+- (void)moveBy:(NSInteger)step {
+  NSArray<BODMenuRow *> *stops = [self stops];
+  NSInteger n = (NSInteger)stops.count, i;
+
+  if (n == 0) return;
+  i = _focus ? (NSInteger)[stops indexOfObject:_focus] : NSNotFound;
+  if (i == NSNotFound) i = step > 0 ? -1 : 0;
+  [self focusRow:stops[(NSUInteger)((i + step + n) % n)]];
+}
+
+- (BOOL)panelKeyDown:(NSEvent *)event {
+  unsigned short code = event.keyCode;
+  NSInteger direction;
+
+  if (_listening) return [self listenTo:event];
+
+  if (code == BODKeyEscape) {
+    if (!event.isARepeat) [self back];
+    return YES;
+  }
+  if (code == BODKeyTab) {
+    [self moveBy:(event.modifierFlags & NSEventModifierFlagShift) ? -1 : 1];
+    return YES;
+  }
+  if ((direction = bod_keys_direction(code)) >= 0) {
+    if (direction == BODDirectionUp) [self moveBy:-1];
+    else if (direction == BODDirectionDown) [self moveBy:1];
+    else if (_focus.kind == BODRowChoice) [self row:_focus choose:_focus.chosen + (direction == BODDirectionRight ? 1 : -1)];
+    return YES;
+  }
+  if (code == BODKeyReturn || code == BODKeyEnter || code == BODKeySpace) {
+    if (!event.isARepeat && _focus) [self activate:_focus];
+    return YES;
+  }
+
+  /* Nothing else on the menu wants a key, and none of them is the game's. */
+  return YES;
+}
+
+/* -------------------------------------------------------- the bindings */
+
+- (void)listen:(BODMenuRow *)row {
+  [self stopListening];
+  _listening = row;
+  row.listening = YES;
+}
+
+- (void)stopListening {
+  _listening.listening = NO;
+  _listening = nil;
+}
+
+- (BOOL)listenTo:(NSEvent *)event {
+  unsigned short code = event.keyCode;
+  BODMenuRow *row = _listening;
+  NSString *name, *action;
+
+  if (event.isARepeat) return YES;
+  /* The arrows ride whatever is bound, so they are not a binding; they and
+   * Escape leave this one as it was. */
+  if (code == BODKeyEscape || bod_keys_direction(code) >= 0) {
+    [self stopListening];
+    return YES;
+  }
+  if (code == BODKeyDelete || code == BODKeyForwardDelete) name = @"";
+  else if ((name = keys_name(event)) == nil) return YES;
+
+  action = [row.key substringFromIndex:5];
+  if (keys_set([NSString stringWithFormat:@"%@=%@", action, name])) {
+    pause_log(@"pause menu: %@ is %@", action, name.length ? name : @"nothing");
+  }
+  [self stopListening];
+  row.detail = keys_printed(keys_first(keys_spec(), action));
+
+  return YES;
+}
+
+/* ---------------------------------------------------------- the choices */
+
+- (void)rowClicked:(BODMenuRow *)row {
+  [self focusRow:row];
+  [self activate:row];
+}
+
+- (void)row:(BODMenuRow *)row choose:(NSInteger)index {
+  [self focusRow:row];
+  if (index < 0 || index >= (NSInteger)row.choices.count || index == row.chosen) return;
+
+  if ([row.key isEqualToString:@"screen"]) {
+    liblsdl2_mac_screen_choose((int)index);
+    row.chosen = liblsdl2_screen_get();
+    if (_screenNote) {
+      _screenNote.title = [self screenNote:row.chosen];
+      [_screenNote invalidateIntrinsicContentSize];
+      _screenNote.needsDisplay = YES;
+    }
+  }
+}
+
+- (void)activate:(BODMenuRow *)row {
+  NSString *key = row.key, *item;
+
+  if (_waiting) return;
+  if (key.length) _memo[_page] = key;
+
+  switch (row.kind) {
+    case BODRowPage:
+      [self show:[key substringFromIndex:5] focus:nil];
+      return;
+    case BODRowBinding:
+      [self listen:row];
+      return;
+    case BODRowChoice:
+      [self row:row choose:(row.chosen + 1) % (NSInteger)row.choices.count];
+      return;
+    default:
+      break;
+  }
+
+  if ([key isEqualToString:@"resume"]) {
+    [self resume];
+  } else if ([key isEqualToString:@"restart"] || [key isEqualToString:@"next"] || [key isEqualToString:@"prev"]) {
+    [self resume];
+    liblsdl2_mac_game_menu([key isEqualToString:@"restart"] ? "Restart Level" :
+                           [key isEqualToString:@"next"] ? "Next Level" : "Previous Level");
+  } else if ([key isEqualToString:@"levels"]) {
+    [self dialog:^{ liblsdl2_mac_game_menu("Select Level"); }];
+  } else if ([key isEqualToString:@"packs"]) {
+    [self hideForPacks];
+    liblsdl2_mac_open_packs();
+  } else if ([key isEqualToString:@"default-keys"]) {
+    keys_set(kDefaultKeys);
+    [self show:_page focus:key];
+  } else if ([key isEqualToString:@"game-controls"]) {
+    if ((item = [self menuItem:301]) != nil) {      /* Options -> Control */
+      [self dialog:^{ liblsdl2_mac_ui_send([@"pick " stringByAppendingString:item].UTF8String); }];
+    }
+  } else if ([key hasPrefix:@"menu:"]) {
+    item = [key substringFromIndex:5];
+    [self dialog:^{ liblsdl2_mac_ui_send([@"pick " stringByAppendingString:item].UTF8String); }];
+  } else if ([key isEqualToString:@"back"]) {
+    [self back];
+  }
+}
+
+/* ----------------------------------------------------- the game's dialogs */
+
+/* One of the game's dialogs, opened from here. The menu stays up until the
+ * dialog does, so there is never a moment with nothing to press; an item that
+ * opens nothing -- a toggle, a replay -- leaves it where it is. */
+- (void)dialog:(void (^)(void))send {
+  __weak BODPauseMenu *weakSelf = self;
+  NSUInteger token = ++_waitToken;
+
+  _returnTo = @{ @"page": _page, @"key": _memo[_page] ?: @"" };
+  _waiting = YES;
+  _rows.alphaValue = 0.55;
+  liblsdl2_mac_form_expect();
+  send();
+
+  bod_keys_after(WAIT_FOR_DIALOG, ^{
+    BODPauseMenu *me = weakSelf;
+    if (me == nil || token != me->_waitToken) return;
+    me->_waiting = NO;
+    me->_rows.alphaValue = 1;
+    if (!liblsdl2_mac_form_shown()) me->_returnTo = nil;
+  });
+}
+
+- (void)stepAside {
+  _waitToken++;
+  _waiting = NO;
+  _rows.alphaValue = 1;
+  if (!_session) return;
+  if (_returnTo == nil) _returnTo = @{ @"page": _page, @"key": _memo[_page] ?: @"" };
+  [self endSheet];
+}
+
+- (void)dialogClosed:(BOOL)dismissed {
+  NSDictionary<NSString *, NSString *> *r = _returnTo;
+
+  _returnTo = nil;
+  if (r == nil || !_session) return;
+  if (dismissed) [self show:r[@"page"] focus:r[@"key"]];
+  else [self resume];
+}
+
+- (void)hideForPacks {
+  _waitToken++;
+  _waiting = NO;
+  [self endSheet];
+}
+
+- (void)backFromPacks {
+  if (_session) [self show:@"main" focus:@"packs"];
+}
+
+@end
+
+/* ------------------------------------------------------------ the C side */
+
+static BODPauseMenu *menu;
+
+void liblsdl2_mac_pause_attach(void *nswindow) {
+  NSWindow *window = (__bridge NSWindow *)nswindow;
+
+  if (menu != nil || window == nil) return;
+  menu = [[BODPauseMenu alloc] init];
+  [menu attachTo:window];
+}
+
+int liblsdl2_mac_pause_wants_keys(void)  { return menu != nil && [menu wantsKeys]; }
+int liblsdl2_mac_pause_session(void)     { return menu != nil && [menu session]; }
+void liblsdl2_mac_pause_open(void)       { [menu open]; }
+void liblsdl2_mac_pause_resume(void)     { [menu resume]; }
+void liblsdl2_mac_pause_step_aside(void) { [menu stepAside]; }
+void liblsdl2_mac_pause_dialog_closed(int dismissed) { [menu dialogClosed:dismissed != 0]; }
+void liblsdl2_mac_pause_hide_for_packs(void)  { [menu hideForPacks]; }
+void liblsdl2_mac_pause_back_from_packs(void) { [menu backFromPacks]; }
+
+int liblsdl2_mac_escape(void) {
+  if (menu == nil || liblsdl2_mac_wants_keys() || liblsdl2_mac_pack_busy()) return 0;
+
+  return [menu open] ? 1 : 0;
+}
diff --git a/src/liblsdl2/liblsdl2_screen.c b/src/liblsdl2/liblsdl2_screen.c
new file mode 100644
index 0000000..7750aef
--- /dev/null
+++ b/src/liblsdl2/liblsdl2_screen.c
@@ -0,0 +1,444 @@
+/* The native window's screen.
+ *
+ * The game draws 320x320, and the window shows it three times that size in
+ * points -- which on a Retina display is six times that size in pixels. How
+ * the difference is made up is the Screen setting in the View menu, the same
+ * three choices the browser build has:
+ *
+ *   pixels  every one of the game's pixels a square, as a Palm showed it.
+ *   smooth  bilinear.
+ *   xbr     Hyllian's xBR (level 2). Each pixel's corners are redrawn from the
+ *           edges that run through its 5x5 neighbourhood, so lettering,
+ *           wheels and the outlines of hills come out as smooth lines at the
+ *           display's own resolution, while flat colour and texture are left
+ *           as they were.
+ *
+ * SDL's renderer draws each window's texture straight into its back buffer,
+ * rectangle by rectangle, so there was never a picture of the whole screen to
+ * upscale. The frame is composited here instead, on the CPU, the way the
+ * browser build already does it (liblsdl2_web.c): the textures keep their
+ * pixels, and drawing one copies it into this frame. The window gets the
+ * frame once per render, upscaled.
+ *
+ * The browser draws xBR with a fragment shader. SDL's renderer offers no way
+ * to run one, so here it is the same arithmetic on the CPU, and the same
+ * picture to the last bit. Most of a frame has no edge near it and is a copy;
+ * a whole frame at six times the size -- 3.7 million pixels -- takes about a
+ * millisecond on one core of an M-series Mac. Spread over all of them it took
+ * a quarter of that and a third more CPU in all, and in the running game the
+ * threads waking for every frame cost most of a core, so it is not.
+ */
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+
+#include "liblsdl2_screen.h"
+
+static const char *names[] = { "pixels", "smooth", "xbr" };
+
+int screen_mode_named(const char *name) {
+  int i;
+
+  if (name == NULL) return -1;
+  for (i = 0; i < 3; i++) {
+    if (strcmp(name, names[i]) == 0) return i;
+  }
+
+  return -1;
+}
+
+const char *screen_mode_name(int mode) {
+  return (mode >= 0 && mode < 3) ? names[mode] : "";
+}
+
+/* ------------------------------------------------------------ the frame -- */
+
+static uint32_t *frame;
+static int frame_width, frame_height;
+
+int screen_init(int width, int height) {
+  if (width <= 0 || height <= 0) return -1;
+  screen_finish();
+  if ((frame = calloc((size_t)width * height, sizeof(uint32_t))) == NULL) return -1;
+  frame_width = width;
+  frame_height = height;
+  screen_fill(0xFF000000);
+
+  return 0;
+}
+
+void screen_finish(void) {
+  free(frame);
+  frame = NULL;
+  frame_width = frame_height = 0;
+}
+
+uint32_t *screen_frame(int *width, int *height) {
+  if (width) *width = frame_width;
+  if (height) *height = frame_height;
+  return frame;
+}
+
+void screen_fill(uint32_t argb) {
+  size_t i, n = (size_t)frame_width * frame_height;
+
+  if (frame == NULL) return;
+  for (i = 0; i < n; i++) frame[i] = argb;
+}
+
+/* One rectangle (sx,sy,w,h) of a src_width x src_height ARGB8888 texture,
+ * landing at (dx,dy) of the frame. Clipped against both, as SDL_RenderCopy
+ * would have: the window manager hands down rectangles that are not inside
+ * either, the borders it draws around a task window among them. */
+void screen_blit(uint32_t *src, int src_width, int src_height, int sx, int sy, int w, int h, int dx, int dy) {
+  int i;
+
+  if (frame == NULL || src == NULL) return;
+
+  if (sx < 0) { w += sx; dx -= sx; sx = 0; }
+  if (sy < 0) { h += sy; dy -= sy; sy = 0; }
+  if (dx < 0) { w += dx; sx -= dx; dx = 0; }
+  if (dy < 0) { h += dy; sy -= dy; dy = 0; }
+  if (w > src_width  - sx) w = src_width  - sx;
+  if (h > src_height - sy) h = src_height - sy;
+  if (w > frame_width  - dx) w = frame_width  - dx;
+  if (h > frame_height - dy) h = frame_height - dy;
+  if (w <= 0 || h <= 0) return;
+
+  for (i = 0; i < h; i++) {
+    memcpy(frame + (dy + i) * frame_width + dx, src + (sy + i) * src_width + sx, w * sizeof(uint32_t));
+  }
+}
+
+/* ------------------------------------------------------------ upscaling -- */
+
+typedef struct {
+  const uint32_t *src;
+  int width, height;
+  uint32_t *dst;
+  int stride, n;
+} job_t;
+
+static void nearest_band(job_t *job, int y0, int y1) {
+  const uint32_t *s;
+  uint32_t *d, v;
+  int x, y, i, j, n = job->n;
+
+  for (y = y0; y < y1; y++) {
+    s = job->src + y * job->width;
+    d = job->dst + (size_t)y * n * job->stride;
+    for (x = 0; x < job->width; x++) {
+      v = s[x];
+      for (i = 0; i < n; i++) d[x * n + i] = v;
+    }
+    for (j = 1; j < n; j++) {
+      memcpy(d + (size_t)j * job->stride, d, (size_t)job->width * n * sizeof(uint32_t));
+    }
+  }
+}
+
+void screen_nearest(const uint32_t *src, int width, int height, uint32_t *dst, int dst_stride, int n) {
+  job_t job = { src, width, height, dst, dst_stride, n };
+
+  if (n < 1) job.n = 1;
+  nearest_band(&job, 0, height);
+}
+
+/* xBR-lv2, after Hyllian's (MIT licence), with corner type C -- the shader in
+ * src/emscripten/bod-pre.js, line for line where it can be, and pixel for
+ * pixel the same picture. There, every quantity is a vec4 holding the four
+ * corners of the pixel E at once; here it is an array of four, in the same
+ * order: bottom right, top right, top left, bottom left. The neighbourhood:
+ *
+ *        A1 B1 C1
+ *     A0  A  B  C C4
+ *     D0  D  E  F F4
+ *     G0  G  H  I I4
+ *        G5 H5 I5
+ *
+ * The comparisons are of luma, scaled to 0-48 as the shader's are. What they
+ * decide depends only on the source. How far into each corner's blend an
+ * output pixel is depends only on its place in the block, so that is a table
+ * per factor -- and so is which places a corner's blend reaches at all, which
+ * is what lets the rest of the block be a copy of E. */
+
+static const float Ao[4] = {  1.0f, -1.0f, -1.0f,  1.0f }, Bo[4] = {  1.0f,  1.0f, -1.0f, -1.0f }, Co[4] = {  1.5f,  0.5f, -0.5f,  0.5f };
+static const float Ax[4] = {  1.0f, -1.0f, -1.0f,  1.0f }, Bx[4] = {  0.5f,  2.0f, -0.5f, -2.0f }, Cx[4] = {  1.0f,  1.0f, -0.5f,  0.0f };
+static const float Ay[4] = {  1.0f, -1.0f, -1.0f,  1.0f }, By[4] = {  2.0f,  0.5f, -2.0f, -0.5f }, Cy[4] = {  2.0f,  0.0f, -1.0f,  0.5f };
+
+/* What a corner's edge is: none, or the 45-degree line with neither, the
+ * shallow, the steep or both of the longer ones beside it. */
+#define EDGE_NONE    0
+#define EDGE_45      1
+#define EDGE_30      2
+#define EDGE_60      3
+#define EDGE_30_60   4
+#define EDGES        5
+
+/* For factor n: weight[c][edge][j * n + i] is how far output pixel (i,j) of
+ * the block is blended towards corner c's colour -- m in the shader -- and
+ * reach[c][edge] has bit j * n + i set where that is more than nothing. */
+static float weight[4][EDGES][SCREEN_MAX_FACTOR * SCREEN_MAX_FACTOR];
+static uint64_t reach[4][EDGES];
+static int tables_n;
+
+static float clamp01(float v) {
+  return v < 0.0f ? 0.0f : v > 1.0f ? 1.0f : v;
+}
+
+static void make_tables(int n) {
+  float dl = 1.0f / (float)n, fpx, fpy, delta_l, delta_u, fx45, fx30, fx60, *w;
+  int c, e, i, j, t;
+
+  if (n == tables_n) return;
+
+  for (c = 0; c < 4; c++) {
+    delta_l = ((c & 1) ? 1.0f : 0.5f) * dl;    /* vec4(0.5, 1.0, 0.5, 1.0) * dl */
+    delta_u = ((c & 1) ? 0.5f : 1.0f) * dl;    /* its .yxwz */
+    for (e = 0; e < EDGES; e++) reach[c][e] = 0;
+
+    for (j = 0; j < n; j++) {
+      fpy = ((float)j + 0.5f) / (float)n;
+      for (i = 0; i < n; i++) {
+        fpx = ((float)i + 0.5f) / (float)n;
+        t = j * n + i;
+        fx45 = clamp01((Ao[c] * fpy + Bo[c] * fpx + dl - Co[c]) / (2.0f * dl));
+        fx30 = clamp01((Ax[c] * fpy + Bx[c] * fpx + delta_l - Cx[c]) / (2.0f * delta_l));
+        fx60 = clamp01((Ay[c] * fpy + By[c] * fpx + delta_u - Cy[c]) / (2.0f * delta_u));
+
+        w = weight[c][EDGE_NONE];  w[t] = 0.0f;
+        w = weight[c][EDGE_45];    w[t] = fx45;
+        w = weight[c][EDGE_30];    w[t] = fx30 > fx45 ? fx30 : fx45;
+        w = weight[c][EDGE_60];    w[t] = fx60 > fx45 ? fx60 : fx45;
+        w = weight[c][EDGE_30_60]; w[t] = fx30 > fx45 ? fx30 : fx45;
+                                   if (fx60 > w[t]) w[t] = fx60;
+        for (e = 0; e < EDGES; e++) {
+          if (weight[c][e][t] > 0.0f) reach[c][e] |= (uint64_t)1 << t;
+        }
+      }
+    }
+  }
+  tables_n = n;
+}
+
+/* The source with two pixels of its own edge repeated around it, as a
+ * texture clamped to its edge samples, and the luma of every pixel of that:
+ * the neighbourhood of any pixel is then at fixed offsets from it. */
+static uint32_t *padded;
+static float *padded_luma;
+static int padded_w, padded_h;
+static float luma_r[256], luma_g[256], luma_b[256];
+
+static int pad(const uint32_t *src, int w, int h) {
+  int x, y, sx, sy, pw = w + 4, ph = h + 4;
+  uint32_t p;
+
+  if (pw != padded_w || ph != padded_h) {
+    free(padded);
+    free(padded_luma);
+    padded = malloc((size_t)pw * ph * sizeof(uint32_t));
+    padded_luma = malloc((size_t)pw * ph * sizeof(float));
+    padded_w = padded_h = 0;
+    if (padded == NULL || padded_luma == NULL) return -1;
+    padded_w = pw;
+    padded_h = ph;
+    for (x = 0; x < 256; x++) {
+      luma_r[x] = (float)x / 255.0f * 14.352f;
+      luma_g[x] = (float)x / 255.0f * 28.176f;
+      luma_b[x] = (float)x / 255.0f *  5.472f;
+    }
+  }
+
+  for (y = 0; y < ph; y++) {
+    sy = y < 2 ? 0 : y - 2 >= h ? h - 1 : y - 2;
+    for (x = 0; x < pw; x++) {
+      sx = x < 2 ? 0 : x - 2 >= w ? w - 1 : x - 2;
+      p = src[sy * w + sx];
+      padded[y * pw + x] = p;
+      padded_luma[y * pw + x] = luma_r[(p >> 16) & 0xFF] + luma_g[(p >> 8) & 0xFF] + luma_b[p & 0xFF];
+    }
+  }
+
+  return 0;
+}
+
+typedef struct { float r, g, b; } rgb_t;
+
+static inline rgb_t rgb(uint32_t p) {
+  rgb_t c = { (float)((p >> 16) & 0xFF), (float)((p >> 8) & 0xFF), (float)(p & 0xFF) };
+  return c;
+}
+
+static inline rgb_t mix(rgb_t a, rgb_t b, float t) {
+  rgb_t c = { a.r + (b.r - a.r) * t, a.g + (b.g - a.g) * t, a.b + (b.b - a.b) * t };
+  return c;
+}
+
+static inline float cdf(rgb_t a, rgb_t b) {
+  return fabsf(a.r - b.r) + fabsf(a.g - b.g) + fabsf(a.b - b.b);
+}
+
+static inline uint32_t argb(rgb_t c) {
+  return 0xFF000000 | ((uint32_t)(c.r + 0.5f) << 16) | ((uint32_t)(c.g + 0.5f) << 8) | (uint32_t)(c.b + 0.5f);
+}
+
+#define EQ(a, b)  (fabsf((a) - (b)) <= 15.0f)
+#define NEQ(a, b) (!EQ(a, b))
+
+static void xbr_band(job_t *job, int y0, int y1) {
+  int w = job->width, n = job->n, stride = job->stride, pw = w + 4;
+  int x, y, c, i, j, t, edge[4], px;
+  const uint32_t *P;
+  const float *L;
+  uint32_t *d, pe, blend[4];
+  uint64_t bits;
+  float e, b[4], k[4], dd[4], f[4], hh[4], g[4], ii[4], i4[4], i5[4], h5[4], f4[4];
+  float wd1, wd2, m[4];
+  rgb_t ce, pc[4], r1, r2;
+
+/* Neighbours of E, as offsets in the padded frame. */
+#define A1 (-2 * pw - 1)
+#define B1 (-2 * pw)
+#define C1 (-2 * pw + 1)
+#define A0 (-pw - 2)
+#define A  (-pw - 1)
+#define B  (-pw)
+#define C  (-pw + 1)
+#define C4 (-pw + 2)
+#define D0 (-2)
+#define D  (-1)
+#define F  (1)
+#define F4 (2)
+#define G0 (pw - 2)
+#define G  (pw - 1)
+#define H  (pw)
+#define I  (pw + 1)
+#define I4 (pw + 2)
+#define G5 (2 * pw - 1)
+#define H5 (2 * pw)
+#define I5 (2 * pw + 1)
+
+  for (y = y0; y < y1; y++) {
+    P = padded + (y + 2) * pw + 2;
+    L = padded_luma + (y + 2) * pw + 2;
+    d = job->dst + (size_t)y * n * stride;
+
+    for (x = 0; x < w; x++, P++, L++, d += n) {
+      pe = P[0];
+      e = L[0];
+      bits = 0;
+
+      /* A corner can only have an edge across it if E differs from both of
+       * the neighbours either side of it (irlv0 in the shader). Where that
+       * is so for none of the four, which is most of any frame, the block is
+       * all E. */
+      if ((EQ(e, L[F]) || EQ(e, L[H])) && (EQ(e, L[B]) || EQ(e, L[F])) &&
+          (EQ(e, L[D]) || EQ(e, L[B])) && (EQ(e, L[H]) || EQ(e, L[D]))) {
+        for (j = 0; j < n; j++) {
+          for (i = 0; i < n; i++) d[j * stride + i] = pe;
+        }
+        continue;
+      }
+
+      b[0]  = L[B];  b[1]  = L[D];  b[2]  = L[H];  b[3]  = L[F];     /* (B, D, H, F) */
+      k[0]  = L[C];  k[1]  = L[A];  k[2]  = L[G];  k[3]  = L[I];     /* (C, A, G, I), c in the shader */
+      i4[0] = L[I4]; i4[1] = L[C1]; i4[2] = L[A0]; i4[3] = L[G5];
+      i5[0] = L[I5]; i5[1] = L[C4]; i5[2] = L[A1]; i5[3] = L[G0];
+      h5[0] = L[H5]; h5[1] = L[F4]; h5[2] = L[B1]; h5[3] = L[D0];
+
+      for (c = 0; c < 4; c++) {
+        dd[c] = b[(c + 1) & 3];     /* b.yzwx */
+        f[c]  = b[(c + 3) & 3];     /* b.wxyz */
+        hh[c] = b[(c + 2) & 3];     /* b.zwxy */
+        g[c]  = k[(c + 2) & 3];     /* c.zwxy */
+        ii[c] = k[(c + 3) & 3];     /* c.wxyz */
+        f4[c] = h5[(c + 1) & 3];    /* h5.yzwx */
+
+        /* Whether an edge runs across the corner at all, and whether it is
+         * shallow or steep enough to take the longer line. */
+        edge[c] = EDGE_NONE;
+        if (NEQ(e, f[c]) && NEQ(e, hh[c]) &&
+            ((NEQ(f[c], b[c]) && NEQ(f[c], k[c])) || (NEQ(hh[c], dd[c]) && NEQ(hh[c], g[c])) ||
+             (EQ(e, ii[c]) && ((NEQ(f[c], f4[c]) && NEQ(f[c], i4[c])) || (NEQ(hh[c], h5[c]) && NEQ(hh[c], i5[c])))) ||
+             EQ(e, g[c]) || EQ(e, k[c]))) {
+          wd1 = fabsf(e - k[c]) + fabsf(e - g[c]) + fabsf(ii[c] - h5[c]) + fabsf(ii[c] - f4[c]) + 4.0f * fabsf(hh[c] - f[c]);
+          wd2 = fabsf(hh[c] - dd[c]) + fabsf(hh[c] - i5[c]) + fabsf(f[c] - i4[c]) + fabsf(f[c] - b[c]) + 4.0f * fabsf(e - ii[c]);
+          if (wd2 >= wd1 + 0.1f) {
+            int shallow = fabsf(hh[c] - k[c]) >= 2.0f * fabsf(f[c] - g[c]) && NEQ(e, g[c]) && NEQ(dd[c], g[c]);
+            int steep   = fabsf(f[c] - g[c]) >= 2.0f * fabsf(hh[c] - k[c]) && NEQ(e, k[c]) && NEQ(b[c], k[c]);
+            edge[c] = shallow ? (steep ? EDGE_30_60 : EDGE_30) : steep ? EDGE_60 : EDGE_45;
+            bits |= reach[c][edge[c]];
+          }
+        }
+      }
+
+      for (j = 0; j < n; j++) {
+        for (i = 0; i < n; i++) d[j * stride + i] = pe;
+      }
+      if (bits == 0) continue;
+
+      /* mix(H, F, px.x), mix(F, B, px.y), mix(B, D, px.z), mix(D, H, px.w) */
+      for (c = 0; c < 4; c++) {
+        px = fabsf(e - hh[c]) >= fabsf(e - f[c]);
+        switch (c) {
+          case 0: blend[0] = px ? P[F] : P[H]; break;
+          case 1: blend[1] = px ? P[B] : P[F]; break;
+          case 2: blend[2] = px ? P[D] : P[B]; break;
+          default: blend[3] = px ? P[H] : P[D]; break;
+        }
+        pc[c] = rgb(blend[c]);
+      }
+      ce = rgb(pe);
+
+      /* Only the places some corner's blend reaches; the rest are E. */
+      while (bits) {
+        t = __builtin_ctzll(bits);
+        bits &= bits - 1;
+        for (c = 0; c < 4; c++) m[c] = weight[c][edge[c]][t];
+        /* Opposite corners are blended in pairs, and the pair that moved E
+         * the further wins. */
+        r1 = mix(ce, pc[0], m[0]);
+        r1 = mix(r1, pc[2], m[2]);
+        r2 = mix(ce, pc[1], m[1]);
+        r2 = mix(r2, pc[3], m[3]);
+        d[(t / n) * stride + t % n] = argb(cdf(ce, r2) >= cdf(ce, r1) ? r2 : r1);
+      }
+    }
+  }
+
+#undef A1
+#undef B1
+#undef C1
+#undef A0
+#undef A
+#undef B
+#undef C
+#undef C4
+#undef D0
+#undef D
+#undef F
+#undef F4
+#undef G0
+#undef G
+#undef H
+#undef I
+#undef I4
+#undef G5
+#undef H5
+#undef I5
+}
+
+void screen_xbr(const uint32_t *src, int width, int height, uint32_t *dst, int dst_stride, int n) {
+  job_t job = { src, width, height, dst, dst_stride, n };
+
+  if (n < 1) n = job.n = 1;
+  if (n > SCREEN_MAX_FACTOR) n = job.n = SCREEN_MAX_FACTOR;
+  if (pad(src, width, height) != 0) {
+    screen_nearest(src, width, height, dst, dst_stride, n);
+    return;
+  }
+  make_tables(n);
+  xbr_band(&job, 0, height);
+}
