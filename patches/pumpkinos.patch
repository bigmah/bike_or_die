+#ifndef NAVKEYS_H
+#define NAVKEYS_H
+
+/* The host keyboard standing in for a Palm 5-way navigator.
+ *
+ * Event.c reports the arrow keys the way a Palm OS 5 device does -- vchrPageUp
+ * and vchrPageDown for up/down, vchrNavChange for left/right/select, all with
+ * the navigator bits in keyCode -- and adds the keys a Palm has no equivalent
+ * for: Enter and space select, Escape backs out. Everything that wants to be
+ * driven from the keyboard (forms, the menu bar, popup lists) asks here rather
+ * than picking those apart itself.
+ *
+ * A release is reported as the same character with the "still held" bit clear,
+ * so only presses are turned into actions: acting on both would move twice.
+ */
+
+typedef enum {
+  navKeyNone = 0,
+  navKeyUp,
+  navKeyDown,
+  navKeyLeft,
+  navKeyRight,
+  navKeySelect,
+  navKeyCancel
+} NavKeyType;
+
+NavKeyType NavKeyAction(const EventType *eventP);
+
+/* Whoever is on top gets first refusal on a navigator key: a visible menu,
+ * else the active form when it is a dialog. Both return true when they took
+ * it, and then it is not the application's to see.
+ *
+ * `quiet` says the keyboard had been still for a moment before this press, so
+ * it was meant for whatever is on screen now. A menu or dialog that came up
+ * under a player's hands -- the one that appears when a level ends -- waits
+ * for that before it will take the navigator keys, or the taps still in flight
+ * from riding walk a focus ring around it. */
+Boolean MenuNavHandleKey(EventType *eventP, Boolean quiet);
+Boolean FrmNavHandleKey(FormType *formP, const EventType *eventP, Boolean quiet);
+
+/* Releases the pen of a tap the keyboard started, once the application has
+ * worked through everything the press generated. */
+Boolean FrmNavFinishTap(void);
+
+/* Says the next dialog to appear was asked for from the keyboard, so it may
+ * take the navigator keys straight away. */
+void FrmNavFromKeyboard(void);
+
+/* For object drawing routines, which repaint over the focus ring. */
+void FrmNavRingHide(void);
+void FrmNavRingShow(void);
+
+#endif
