+      S->r[8], S->r[9], S->r[10], S->r[11], S->r[12], S->r[13], S->r[14],
+      S->nf, S->zf, S->cf, S->vf);
+    sys_write(fd, (uint8_t *)buf, n);
+  }
+  sys_close(fd);
+  debug(DEBUG_ERROR, "ARM", "ring of %u entries written to /tmp/bod_ring.txt", rarm_ring_n - start);
+}
+
+void rarm_trace(rarm_state *S) {
+  char buf[220];
+  int n;
+  rarm_ring[rarm_ring_n % RARM_RING] = *S;
+  rarm_ring_n++;
+  if (rarm_trace_fd < 0 || rarm_trace_n >= rarm_trace_max) return;
+  rarm_trace_n++;
+  n = sys_snprintf(buf, sizeof(buf) - 1,
+    "%08X %08X %08X %08X %08X %08X %08X %08X %08X %08X %08X %08X %08X %08X %08X %08X %u%u%u%u\n",
+    S->r[15], S->r[0], S->r[1], S->r[2], S->r[3], S->r[4], S->r[5], S->r[6], S->r[7],
+    S->r[8], S->r[9], S->r[10], S->r[11], S->r[12], S->r[13], S->r[14],
+    S->nf, S->zf, S->cf, S->vf);
+  sys_write(rarm_trace_fd, (uint8_t *)buf, n);
+}
+
+void rarm_badaddr(uint32_t addr, uint32_t size, int write) {
+  /* Out-of-range accesses are clamped away (the read yields 0, the write is
+   * dropped) so a translation bug degrades into a glitch instead of a crash.
+   * BOD_ARM_STRICT=1 turns them back into a hard error. */
+  static uint32_t n = 0;
+  static int strict = 0;
+  char buf[200];
+
+  if (!strict) { char *e = sys_getenv("BOD_ARM_STRICT"); strict = (e && e[0] && e[0] != '0') ? 1 : -1; }
+  n++;
+  if (n <= 20 || (n % 10000) == 0) {
+    sys_snprintf(buf, sizeof(buf) - 1,
+                 "recomp(arm): bad %s of %u bytes at 0x%08X from pc 0x%08X (#%u)",
+                 write ? "write" : "read", size, addr, rarm_cur_pc, n);
+    debug(DEBUG_ERROR, "ARM", "%s", buf);
+    if (n == 1 && rarm_ring_n) rarm_ring_dump();
+    if (strict > 0) emupalmos_panic(buf, EMUPALMOS_INVALID_ADDRESS);
+  }
+}
+
+int rarm_blob_recompiled(int n) {
+  /* BOD_ARM_BLOBS is a bitmask over armc 1..4; bit 0 = armc 1. Default: all. */
+  static int mask = -1;
+  if (mask < 0) {
+    char *e = sys_getenv("BOD_ARM_BLOBS");
+    mask = (e && e[0]) ? sys_atoi(e) : 0xF;
+    debug(DEBUG_INFO, "ARM", "recompiled blob mask 0x%X", mask);
+  }
+  return (mask >> (n - 1)) & 1;
+}
+
+/* A sub-range of one blob can be forced to the interpreter, to bisect a
+ * translation bug down to a function:
+ *   BOD_ARM_IBLOB=<n> BOD_ARM_ILO=<hex off> BOD_ARM_IHI=<hex off>  */
+int rarm_pc_recompiled(int n, uint32_t off) {
+  static int iblob = -2;
+  static uint32_t ilo, ihi;
+
+  if (!rarm_blob_recompiled(n)) return 0;
+  if (iblob == -2) {
+    char *b = sys_getenv("BOD_ARM_IBLOB");
+    char *l = sys_getenv("BOD_ARM_ILO");
+    char *h = sys_getenv("BOD_ARM_IHI");
+    iblob = (b && b[0]) ? sys_atoi(b) : -1;
+    ilo = (l && l[0]) ? (uint32_t)sys_strtol(l, NULL, 16) : 0;
+    ihi = (h && h[0]) ? (uint32_t)sys_strtol(h, NULL, 16) : 0;
+    if (iblob > 0) debug(DEBUG_INFO, "ARM", "interpreting armc %d [0x%X,0x%X)", iblob, ilo, ihi);
+  }
+  if (iblob == n && off >= ilo && off < ihi) return 0;
+  return 1;
+}
+
+static void rarm_to_uarm(emu_state_t *state, rarm_state *S) {
+  int i;
+  uint32_t cpsr;
+  for (i = 0; i < 16; i++) state->armp->armSetReg(state->arm, i, S->r[i]);
+  cpsr = state->armp->armGetReg(state->arm, 16) & 0x0FFFFFFFu;   /* keep the mode bits */
+  cpsr |= (S->nf << 31) | (S->zf << 30) | (S->cf << 29) | (S->vf << 28);
+  state->armp->armSetReg(state->arm, 16, cpsr);
+}
+
+static void rarm_from_uarm(emu_state_t *state, rarm_state *S) {
+  int i;
+  uint32_t cpsr;
+  for (i = 0; i < 16; i++) S->r[i] = state->armp->armGetReg(state->arm, i);
+  cpsr = state->armp->armGetReg(state->arm, 16);
+  S->nf = (cpsr >> 31) & 1; S->zf = (cpsr >> 30) & 1;
+  S->cf = (cpsr >> 29) & 1; S->vf = (cpsr >> 28) & 1;
+}
+
+static uint32_t rarm_batch(void) {
+  static uint32_t n = 0;
+  if (!n) { char *e = sys_getenv("BOD_ARM_BATCH"); n = (e && e[0]) ? (uint32_t)sys_atoi(e) : 400; if (!n) n = 1; }
+  return n;
+}
+
+int rarm_lockstep_blob(void) {
+  static int b = -2;
+  if (b == -2) {
+    char *e = sys_getenv("BOD_ARM_LOCKSTEP");
+    b = (e && e[0]) ? sys_atoi(e) : -1;
+    if (b > 0) debug(DEBUG_INFO, "ARM", "lockstep checking armc %d", b);
+  }
+  return b;
+}
+
+/* Execute one instruction under the interpreter (authoritative) and the same
+ * instruction under the recompiled single-stepper, from the same input state,
+ * and report the first register-level disagreement. */
+int rarm_lockstep(rarm_state *S) {
+  emu_state_t *state = pumpkin_get_local_storage(emu_key);
+  static uint32_t reported = 0;
+  rarm_state before = *S, mine;
+  uint32_t pc = S->r[15];
+  int i, bad = -1;
+
+  rarm_to_uarm(state, S);
+  if (state->armp->armRun(state->arm, 1, rarm_call_addr, call68K_func, rarm_ret_addr)) {
+    rarm_from_uarm(state, S);
+    S->halt = 1;
+    S->result = S->r[0];
+    return 1;
+  }
+  rarm_from_uarm(state, S);          /* S is now the reference result */
+
+  mine = before;
+  {
+    rarm_step_fn step = rarm_stepper(rarm_lockstep_blob());
+    if (step == NULL) {
+      rarm_panic(S, pc, "no single-step core for this blob: recomparm.py --stepper <n>");
+      return 1;
+    }
+    step(&mine);
+  }
+
+  for (i = 0; i < 16; i++) if (mine.r[i] != S->r[i]) { bad = i; break; }
+  if (bad < 0) {
+    if (mine.nf != S->nf) bad = 16;
+    else if (mine.zf != S->zf) bad = 17;
+    else if (mine.cf != S->cf) bad = 18;
+    else if (mine.vf != S->vf) bad = 19;
+  }
+  if (bad >= 0 && reported < 12) {
+    static const char *nm[] = {"r0","r1","r2","r3","r4","r5","r6","r7","r8","r9",
+                               "r10","r11","r12","sp","lr","pc","N","Z","C","V"};
+    reported++;
+    debug(DEBUG_ERROR, "ARM", "LOCKSTEP #%u pc=0x%08X %s: recomp=0x%08X interp=0x%08X",
+          reported, pc, nm[bad],
+          bad < 16 ? mine.r[bad] : (bad==16?mine.nf:bad==17?mine.zf:bad==18?mine.cf:mine.vf),
+          bad < 16 ? S->r[bad]  : (bad==16?S->nf  :bad==17?S->zf  :bad==18?S->cf  :S->vf));
+    debug(DEBUG_ERROR, "ARM", "  in : r0=%08X r1=%08X r2=%08X r3=%08X r4=%08X r5=%08X r6=%08X r7=%08X",
+          before.r[0], before.r[1], before.r[2], before.r[3], before.r[4], before.r[5], before.r[6], before.r[7]);
+    debug(DEBUG_ERROR, "ARM", "  in : r8=%08X r9=%08X r10=%08X r11=%08X r12=%08X sp=%08X lr=%08X nzcv=%u%u%u%u",
+          before.r[8], before.r[9], before.r[10], before.r[11], before.r[12], before.r[13], before.r[14],
+          before.nf, before.zf, before.cf, before.vf);
+  }
+  return 0;
+}
+
+int rarm_interp(rarm_state *S) {
+  emu_state_t *state = pumpkin_get_local_storage(emu_key);
+  uint32_t pc;
+  int guard = 0, n;
+
+  rarm_to_uarm(state, S);
+  for (;;) {
+    /* Batch size trades handoff cost against how far execution overshoots the
+     * interpreted region. Overshooting is harmless for correctness (uARM runs
+     * recompiled regions fine) but blurs range bisection, so BOD_ARM_BATCH=1
+     * gives exact range semantics. */
+    if (state->armp->armRun(state->arm, rarm_batch(), rarm_call_addr, call68K_func, rarm_ret_addr)) {
+      rarm_from_uarm(state, S);
+      S->halt = 1;
+      S->result = S->r[0];
+      return 1;
+    }
+    pc = state->armp->armGetReg(state->arm, 15);
+    for (n = 1; n < 5; n++) {
+      if (rarm_segsize[n] && pc >= rarm_segbase[n] && pc < rarm_segbase[n] + rarm_segsize[n] &&
+          rarm_blob_recompiled(n)) {
+        rarm_from_uarm(state, S);
+        return 0;
+      }
+    }
+    if (emupalmos_finished()) { rarm_from_uarm(state, S); S->halt = 1; return 1; }
+    if (++guard > 200000) {
+      rarm_panic(S, pc, "interpreter did not return to recompiled code");
+      return 1;
+    }
+  }
+}
+
+int rarm_resolve(uint32_t pc) {
+  uint8_t *ram = pumpkin_heap_base();
+  MemHandle h;
+  uint8_t *p;
+  int n;
+
+  for (n = 1; n < 5; n++) {
+    if (rarm_segsize[n]) continue;
+    if ((h = DmGet1Resource('armc', n)) == NULL) continue;
+    if ((p = MemHandleLock(h)) != NULL) {
+      rarm_segbase[n] = (uint32_t)(p - ram);
+      rarm_segsize[n] = MemHandleSize(h);
+      debug(DEBUG_INFO, "ARM", "recomp: armc %d at 0x%08X size 0x%X",
+            n, rarm_segbase[n], rarm_segsize[n]);
+    }
+  }
+  for (n = 1; n < 5; n++)
+    if (rarm_segsize[n] && pc >= rarm_segbase[n] && pc < rarm_segbase[n] + rarm_segsize[n])
+      return 0;
+  return -1;
+}
+
+int rarm_escape(rarm_state *S, uint32_t target) {
+  mw_regs = S;
+  if (target >= 0x04000000) {
+    /* PACE syscall: the address encodes the group and function number. */
+    uint32_t group = (target & 0x00F00000) >> 20;
+    uint32_t function = target & 0xFFFF;
+    uint32_t lr = S->r[14];
+    S->r[0] = emupalmos_arm_syscall(group, function, S->r[0], S->r[1], S->r[2], S->r[3], S->r[13]);
+    S->r[14] = lr;
+    S->r[15] = lr;
+    return emupalmos_finished() ? 1 : 0;
+  }
+  if (target == rarm_ret_addr) {
+    S->halt = 1;
+    S->result = S->r[0];
+    return 1;
+  }
+  if (target == rarm_call_addr) {
+    S->r[0] = call68K_func(S->r[0], S->r[1], S->r[2], S->r[3]);
+    S->r[15] = S->r[14];
+    return emupalmos_finished() ? 1 : 0;
+  }
+  rarm_panic(S, target, "branch outside the recompiled armc blobs");
+  return 1;
+}
+
+/* Tracing mode. Restoring the Palm heap between two in-process replays is not
+ * sound (PumpkinOS keeps host-side state alongside it), so instead each engine
+ * is traced in its own process run and the traces are diffed offline:
+ *   BOD_ARM_ENGINE=interp|recomp   which core executes PceNativeCall
+ *   BOD_ARM_TRACE=<n>              trace the first n calls to /tmp/bod_trace_<engine>.txt
+ * BOD_ARM_DETTIME=1 freezes the clock so both runs stay comparable. */
+static int rarm_diff_enabled(void) {
+  static int v = 0;
+  if (!v) { char *e = sys_getenv("BOD_ARM_TRACE"); v = (e && e[0] && e[0] != '0') ? 1 : -1; }
+  return v > 0;
+}
+
+static int rarm_use_interp(void) {
+  static int v = 0;
+  if (!v) {
+    char *e = sys_getenv("BOD_ARM_ENGINE");
+    v = (e && !sys_strcmp(e, "interp")) ? 1 : -1;
+  }
+  return v > 0;
+}
+
+static uint32_t rarm_diff_call(uint32_t code, uint32_t userData) {
+  static uint32_t seq = 0;
+  static int opened = 0;
+  uint32_t max;
+  char *e = sys_getenv("BOD_ARM_TRACE");
+  uint32_t r;
+
+  max = e ? (uint32_t)sys_atoi(e) : 1;
+  seq++;
+  { extern int rarm_deterministic_time;
+    char *d = sys_getenv("BOD_ARM_DETTIME");
+    rarm_deterministic_time = (d && d[0] && d[0] != '0'); }
+
+  if (seq <= max && !opened && sys_getenv("BOD_ARM_TRACEFILE")) {
+    rarm_trace_open(rarm_use_interp() ? "/tmp/bod_trace_interp.txt"
+                                      : "/tmp/bod_trace_recomp.txt", 1500000);
+    opened = 1;
+  }
+  if (seq > max && opened) { rarm_trace_close(); opened = 0; }
+
+  {
+    static int dual = 0;
+    if (!dual) { char *e = sys_getenv("BOD_ARM_DUAL"); dual = (e && e[0] && e[0] != '0') ? 1 : -1; }
+    if (dual > 0) {
+      /* Run the call under both engines from the same entry state and report
+       * disagreement. Both entries set up r0-r2/sp/lr/r9 themselves, so the
+       * inputs are identical; the recompiled pass runs first and the
+       * interpreted result is the one handed back, keeping the game correct. */
+      uint32_t rr = rarm_native_call_pce(code, userData);
+      uint32_t ri = arm_native_call_pce_interp(code, userData);
+      if (rr != ri) {
+        debug(DEBUG_ERROR, "ARM", "DUAL mismatch call #%u code=0x%08X recomp=0x%08X interp=0x%08X",
+              seq, code, rr, ri);
+      }
+      r = ri;
+    } else {
+      r = rarm_use_interp() ? arm_native_call_pce_interp(code, userData)
+                            : rarm_native_call_pce(code, userData);
+    }
+  }
+  debug(DEBUG_INFO, "ARM", "trace call #%u code=0x%08X r0=0x%08X (%s)",
+        seq, code, r, rarm_use_interp() ? "interp" : "recomp");
+  return r;
+}
+
+static uint32_t rarm_native_call_pce(uint32_t code, uint32_t userData) {
+  emu_state_t *state = pumpkin_get_local_storage(emu_key);
+  static int ring_mode = 0;
+  if (!ring_mode) {
+    char *e = sys_getenv("BOD_ARM_RING");
+    ring_mode = (e && e[0] && e[0] != '0') ? 1 : -1;
+    if (ring_mode > 0) rarm_tracing = 1;
+  }
+  uint8_t *ram = pumpkin_heap_base();
+  /* The ARM register file persists between calls, exactly as it does for the
+   * interpreted CPU; only the entry registers are set up each time. */
+  static rarm_state S;
+  uint32_t sysAddr;
+
+  S.halt = 0;
+  rarm_ram = ram;
+  rarm_ramsize = pumpkin_heap_size();
+  rarm_resolve(code);
+  sysAddr = (uint8_t *)state->systable - ram;
+  rarm_ret_addr  = state->armReturnAddr - ram;
+  rarm_call_addr = state->armCall68KAddr - ram;
+
+  S.r[9]  = sysAddr + 16;                       /* PACE syscall master table */
+  S.r[15] = code;
+  S.r[14] = rarm_ret_addr;
+  S.r[13] = (uint32_t)(state->armStack - ram) + stackSize;
+  S.r[0]  = (uint32_t)(state->armEmulState - ram);
+  S.r[1]  = userData;
+  S.r[2]  = rarm_call_addr;
+
+  mw_frame_tick();
+  rarm_run(&S);
+  return S.r[0];
+}
+
+/* The sound mixer is `armc` code too, but the sound layer reaches it through
+ * SndStreamCreate's ARM callback instead of PceNativeCall, so it used to be the
+ * one entry point left on the interpreter. It is called from the application
+ * thread for every buffer the stream needs, and interpreting it cost about a
+ * quarter of that thread: the 44.1 kHz stream ran dry whenever a frame took a
+ * little longer, which is what made the audio choppy. Run it recompiled like
+ * everything else. */
+static uint32_t rarm_call_sub(uint32_t code, uint32_t p0, uint32_t p1, uint32_t p2, uint32_t p3) {
+  emu_state_t *state = pumpkin_get_local_storage(emu_key);
+  uint8_t *ram = pumpkin_heap_base();
+  /* Its own register file, mirroring the separate CPU the interpreter keeps
+   * for this state; only the entry registers are set up on each call. */
+  static rarm_state S;
+  uint32_t saveRet, saveCall, sysAddr;
+
+  rarm_ram = ram;
+  rarm_ramsize = pumpkin_heap_size();
+  sysAddr = (uint8_t *)state->systable - ram;
+  put4l(sysAddr, ram, sysAddr + 16);
+  put4l(sysAddr + 16, ram, sysAddr + 2052);
+
+  /* The return and call-68K stubs belong to this state, not to the one the
+   * application thread runs its PceNativeCalls on. */
+  saveRet = rarm_ret_addr;
+  saveCall = rarm_call_addr;
+  rarm_ret_addr  = state->armReturnAddr - ram;
+  rarm_call_addr = state->armCall68KAddr - ram;
+
+  S.halt  = 0;
+  S.r[9]  = sysAddr + 16;                       /* PACE syscall master table */
+  S.r[15] = code;
+  S.r[14] = rarm_ret_addr;
+  S.r[13] = (uint32_t)(state->armStack - ram) + stackSize;
+  S.r[0]  = p0;
+  S.r[1]  = p1;
+  S.r[2]  = p2;
+  S.r[3]  = p3;
+
+  rarm_run(&S);
+
+  rarm_ret_addr = saveRet;
+  rarm_call_addr = saveCall;
+
+  return S.r[0];
+}
+
+/* ... unless the recompiled cores are switched off, or the callback does not
+ * live in an armc resource, in which case the interpreter still handles it. */
+static int rarm_snd_recompiled(uint32_t code) {
+  static uint32_t reported = 0;
+  int n;
+
+  if (!r68k_enabled() || rarm_use_interp()) return 0;
+  if (rarm_resolve(code) != 0) return 0;
+
+  if (reported != code) {
+    reported = code;
+    for (n = 1; n < 5; n++) {
+      if (rarm_segsize[n] && code >= rarm_segbase[n] && code < rarm_segbase[n] + rarm_segsize[n]) {
+        debug(DEBUG_INFO, "ARM", "recomp: sound callback 0x%08X is armc %d + 0x%X",
+              code, n, code - rarm_segbase[n]);
+        break;
+      }
+    }
+  }
+
+  return 1;
+}
+
 void emupalmos_disasm(int m68k, int arm) {
   emu_state_t *state = pumpkin_get_local_storage(emu_key);
   logtrap_disasm(state->lt, m68k);
diff --git a/src/libpumpkin/navkeys.h b/src/libpumpkin/navkeys.h
new file mode 100644
index 0000000..fcb2faf
--- /dev/null
+++ b/src/libpumpkin/navkeys.h
@@ -0,0 +1,54 @@
+#ifndef NAVKEYS_H
+#define NAVKEYS_H
+
+/* The host keyboard standing in for a Palm 5-way navigator.
+ *
+ * Event.c reports the arrow keys the way a Palm OS 5 device does -- vchrPageUp
+ * and vchrPageDown for up/down, vchrNavChange for left/right/select, all with
+ * the navigator bits in keyCode -- and adds the keys a Palm has no equivalent
+ * for: Enter and space select, Escape backs out. Everything that wants to be
+ * driven from the keyboard (forms, the menu bar, popup lists) asks here rather
+ * than picking those apart itself.
+ *
+ * A release is reported as the same character with the "still held" bit clear,
+ * so only presses are turned into actions: acting on both would move twice.
+ */
+
+typedef enum {
+  navKeyNone = 0,
+  navKeyUp,
+  navKeyDown,
+  navKeyLeft,
+  navKeyRight,
+  navKeySelect,
+  navKeyCancel
+} NavKeyType;
+
+NavKeyType NavKeyAction(const EventType *eventP);
+
+/* Whoever is on top gets first refusal on a navigator key: a visible menu,
+ * else the active form when it is a dialog. Both return true when they took
+ * it, and then it is not the application's to see.
+ *
+ * `quiet` says the keyboard had been still for a moment before this press, so
+ * it was meant for whatever is on screen now. A menu or dialog that came up
+ * under a player's hands -- the one that appears when a level ends -- waits
+ * for that before it will take the navigator keys, or the taps still in flight
+ * from riding walk a focus ring around it. */
+Boolean MenuNavHandleKey(EventType *eventP, Boolean quiet);
+Boolean FrmNavHandleKey(FormType *formP, const EventType *eventP, Boolean quiet);
+
+/* Releases the pen of a tap the keyboard started, once the application has
+ * worked through everything the press generated. */
+Boolean FrmFinishPenUp(void);
+void FrmDeferPenUp(Coord x, Coord y);
+
+/* Says the next dialog to appear was asked for from the keyboard, so it may
+ * take the navigator keys straight away. */
+void FrmNavFromKeyboard(void);
+
+/* For object drawing routines, which repaint over the focus ring. */
+void FrmNavRingHide(void);
+void FrmNavRingShow(void);
+
+#endif
