+ * translation bug down to a function:
+ *   BOD_ARM_IBLOB=<n> BOD_ARM_ILO=<hex off> BOD_ARM_IHI=<hex off>  */
+int rarm_pc_recompiled(int n, uint32_t off) {
+  static int iblob = -2;
+  static uint32_t ilo, ihi;
+
+  if (!rarm_blob_recompiled(n)) return 0;
+  if (iblob == -2) {
+    char *b = sys_getenv("BOD_ARM_IBLOB");
+    char *l = sys_getenv("BOD_ARM_ILO");
+    char *h = sys_getenv("BOD_ARM_IHI");
+    iblob = (b && b[0]) ? sys_atoi(b) : -1;
+    ilo = (l && l[0]) ? (uint32_t)sys_strtol(l, NULL, 16) : 0;
+    ihi = (h && h[0]) ? (uint32_t)sys_strtol(h, NULL, 16) : 0;
+    if (iblob > 0) debug(DEBUG_INFO, "ARM", "interpreting armc %d [0x%X,0x%X)", iblob, ilo, ihi);
+  }
