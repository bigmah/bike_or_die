+
+static void menu_nav_pane(MenuBarType *menuP, int dir) {
+  MenuPullDownType *prev, *pd;
+
+  if (menuP->numMenus < 1) return;
+
+  pumpkin_dirty_region_mode(dirtyRegionBegin);
+  prev = &menuP->menus[menuP->curMenu];
+  menu_show_pd_title(menuP, prev, -1);
+  if (!prev->hidden) {
+    menu_hide_pd(menuP, prev);
+    prev->hidden = 1;
+  }
+  prev->selectedItem = -1;
+
+  menuP->curMenu = (menuP->curMenu + dir + menuP->numMenus) % menuP->numMenus;
+  pd = &menuP->menus[menuP->curMenu];
+  menu_nav_show(menuP, pd);
+  pumpkin_dirty_region_mode(dirtyRegionEnd);
+}
+
+static void menu_nav_item(MenuBarType *menuP, int dir) {
+  MenuPullDownType *pd = &menuP->menus[menuP->curMenu];
+  Int16 cur, i;
+
+  pumpkin_dirty_region_mode(dirtyRegionBegin);
+  menu_nav_show(menuP, pd);
+
+  cur = pd->selectedItem;
+  for (i = 0; i < pd->numItems; i++) {
+    cur = (cur < 0) ? ((dir > 0) ? 0 : pd->numItems - 1)
+                    : (cur + dir + pd->numItems) % pd->numItems;
+    if (menu_item_usable(&pd->items[cur])) break;
+  }
+  if (i == pd->numItems) {
+    pumpkin_dirty_region_mode(dirtyRegionEnd);
+    return;                                   // nothing in here can be picked
+  }
+
+  if (pd->selectedItem != -1 && pd->selectedItem != cur) {
+    menu_draw_item(pd, &pd->items[pd->selectedItem], false);
+  }
+  pd->selectedItem = cur;
+  menu_draw_item(pd, &pd->items[cur], true);
+  pumpkin_dirty_region_mode(dirtyRegionEnd);
+}
+
+static void menu_nav_select(MenuBarType *menuP) {
+  MenuPullDownType *pd = &menuP->menus[menuP->curMenu];
+  EventType ev;
+  UInt16 id;
+
+  if (pd->hidden || pd->selectedItem == -1) {
+    menu_nav_item(menuP, 1);                  // open on the first item instead
+    return;
+  }
+
+  pumpkin_dirty_region_mode(dirtyRegionBegin);
+  id = pd->items[pd->selectedItem].id;
+  menu_draw_item(pd, &pd->items[pd->selectedItem], false);
+  menu_close(menuP);
+  pumpkin_dirty_region_mode(dirtyRegionEnd);
+
+  debug(DEBUG_TRACE, "Menu", "MenuNavHandleKey menuEvent item %d", id);
+  MemSet(&ev, sizeof(EventType), 0);
+  ev.eType = menuEvent;
+  ev.data.menu.itemID = id;
+  EvtAddEventToQueue(&ev);
+}
+
+// Returns true when a visible menu took the key. The menu is on top of
