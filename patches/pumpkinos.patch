+/* ------------------------------------------------------------------ r68k glue
+ * Bridge between the statically recompiled 68k code (tools/recomp68k.py) and
+ * the PalmOS layer. The recompiled code keeps its own register file; it is
+ * published into the Musashi context around traps so the existing trap
+ * handlers -- which read arguments via m68k_get_reg() and the emulated stack --
+ * work unchanged.
+ */
+
+static int r68k_active = 0;
+
+int r68k_enabled(void) {
+  if (!r68k_active) {
+    char *e = sys_getenv("BOD_RECOMP");
+    r68k_active = (e && e[0] && e[0] != '0') ? 1 : -1;
+  }
+  return r68k_active > 0;
+}
+
+static void r68k_to_musashi(r68k_state *S) {
+  int i;
+  for (i = 0; i < 8; i++) m68k_set_reg(M68K_REG_D0 + i, S->d[i]);
+  for (i = 0; i < 8; i++) m68k_set_reg(M68K_REG_A0 + i, S->a[i]);
+  m68k_set_reg(M68K_REG_PC, S->pc);
+  m68k_set_reg(M68K_REG_SP, S->a[7]);
+  {
+    uint32_t sr = m68k_get_reg(NULL, M68K_REG_SR) & ~0x1Fu;
+    sr |= (S->xf << 4) | (S->nf << 3) | (S->zf << 2) | (S->vf << 1) | S->cf;
+    m68k_set_reg(M68K_REG_SR, sr);
+  }
+}
+
+static void r68k_from_musashi(r68k_state *S) {
+  int i;
+  for (i = 0; i < 8; i++) S->d[i] = m68k_get_reg(NULL, M68K_REG_D0 + i);
+  for (i = 0; i < 8; i++) S->a[i] = m68k_get_reg(NULL, M68K_REG_A0 + i);
+  S->pc = m68k_get_reg(NULL, M68K_REG_PC);
+  {
+    uint32_t sr = m68k_get_reg(NULL, M68K_REG_SR);
+    S->cf = sr & 1; S->vf = (sr >> 1) & 1; S->zf = (sr >> 2) & 1;
+    S->nf = (sr >> 3) & 1; S->xf = (sr >> 4) & 1;
+  }
+}
+
+uint32_t r68k_trap(r68k_state *S, uint16_t trap) {
+  static uint32_t n = 0;
+  uint32_t r;
+
+  /* One-shot dump of Bike or Die's physical-key table: the game keeps 11
+   * 32-bit KeyCurrentState masks at globals+0x3E74, indexed by its own key
+   * number (0=Up, 1=Down, 2=Left, 3=Right, 4=Select, 5..8=Button 1..4).
+   * Bit 23 of an entry marks it unavailable. BOD_DUMP_KEYS=1 to enable. */
+  if (trap == 0xA2A2) {
+    static int dumped = 0;
+    if (!dumped) {
+      char *e = sys_getenv("BOD_DUMP_KEYS");
+      dumped = 1;
+      if (e && e[0] && e[0] != '0') {
+        uint32_t globals = rd32(S->a[5] - 0x10A4u);
+        int k;
+        debug(DEBUG_ERROR, "BOD", "key table at globals 0x%08X + 0x3E74", globals);
+        for (k = 0; k < 11; k++) {
+          debug(DEBUG_ERROR, "BOD", "  key[%2d] mask=0x%08X%s", k,
+                rd32(globals + 0x3E74u + k * 4),
+                (rd32(globals + 0x3E74u + k * 4) & 0x00800000u) ? "  (disabled)" : "");
+        }
+      }
+    }
+  }
+
+  r68k_to_musashi(S);
+  r = palmos_systrap(trap);
+  r68k_from_musashi(S);
+
+  if (emupalmos_finished() || thread_must_end()) S->halt = 1;
+
+  /* The interpreter pumps host events between timeslices; do the equivalent
+   * here, since the recompiled code has no timeslice boundary. */
+  if ((++n & 0x3F) == 0) {
+    if (pumpkin_audio_check(-1)) EvtPumpEvents(0);
+  }
+  return r;
+}
+
+void r68k_panic(r68k_state *S, uint32_t pc, const char *why) {
+  char buf[160];
+  sys_snprintf(buf, sizeof(buf) - 1, "recomp: %s at 0x%08X", why, pc);
+  emupalmos_panic(buf, EMUPALMOS_INVALID_INSTRUCTION);
+  S->halt = 1;
+}
+
+int r68k_resolve(uint32_t pc) {
+  uint8_t *ram = pumpkin_heap_base();
+  MemHandle h;
+  uint8_t *p;
+  int n;
+
+  /* Code resources 2..n are loaded and locked by the application itself, so
+   * resolve them lazily -- by the time the PC lands there the app already holds
+   * a lock and DmGet1Resource/MemHandleLock return its address. We keep our own
+   * lock so the address stays valid for the rest of the run. */
+  for (n = 2; n < 4; n++) {
+    if (r68k_segsize[n]) continue;
+    if ((h = DmGet1Resource('code', n)) == NULL) continue;
+    if ((p = MemHandleLock(h)) != NULL) {
+      r68k_segbase[n] = (uint32_t)(p - ram);
+      r68k_segsize[n] = MemHandleSize(h);
+      debug(DEBUG_INFO, "EmuPalmOS", "recomp: code %d at 0x%08X size 0x%X",
+            n, r68k_segbase[n], r68k_segsize[n]);
+    }
+  }
+  for (n = 1; n < 4; n++)
+    if (r68k_segsize[n] && pc >= r68k_segbase[n] && pc < r68k_segbase[n] + r68k_segsize[n])
+      return 0;
+  return -1;
+}
+
+int r68k_interp(r68k_state *S) {
+  emu_state_t *state = pumpkin_get_local_storage(emu_key);
+  uint32_t pc;
+  int guard = 0, n;
+
+  r68k_to_musashi(S);
+  for (;;) {
+    m68k_execute(&state->m68k_state, 32);
+    pc = m68k_get_reg(NULL, M68K_REG_PC);
+    for (n = 1; n < 4; n++)
+      if (r68k_segsize[n] && pc >= r68k_segbase[n] && pc < r68k_segbase[n] + r68k_segsize[n])
+        goto back;
+    if (emupalmos_finished() || thread_must_end()) {
+      S->halt = 1; r68k_from_musashi(S); return 1;
+    }
+    if (++guard > 200000) {
+      r68k_panic(S, pc, "interpreter did not return to recompiled code");
+      return 1;
+    }
+  }
+back:
+  r68k_from_musashi(S);
+  return 0;
+}
+
+static void r68k_main(uint32_t pc, uint32_t a5, uint32_t a7, uint32_t codeStart, uint32_t codeSize) {
+  r68k_state S;
+
+  sys_memset(&S, 0, sizeof(S));
+  r68k_ram = pumpkin_heap_base();
+  sys_memset(r68k_segbase, 0, sizeof(r68k_segbase));
+  sys_memset(r68k_segsize, 0, sizeof(r68k_segsize));
+  /* Segment 1 is already locked by emupalmos_main. */
+  r68k_segbase[1] = codeStart;
+  r68k_segsize[1] = codeSize;
+  S.pc = pc;
+  S.a[5] = a5;
+  S.a[7] = a7;
+  S.ret_sp = 0xFFFFFFFFu;   /* the app is ended by a trap, not by returning */
+  debug(DEBUG_INFO, "EmuPalmOS", "recomp: code 1 at 0x%08X size 0x%X", r68k_segbase[1], r68k_segsize[1]);
+  debug(DEBUG_INFO, "EmuPalmOS", "recomp: starting at 0x%08X a5=0x%08X a7=0x%08X", pc, a5, a7);
+  r68k_run(&S);
+  debug(DEBUG_INFO, "EmuPalmOS", "recomp: finished at 0x%08X", S.pc);
+}
