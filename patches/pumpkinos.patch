diff --git a/src/liblsdl2/liblsdl2_web.c b/src/liblsdl2/liblsdl2_web.c
new file mode 100644
index 0000000..b1efe87
--- /dev/null
+++ b/src/liblsdl2/liblsdl2_web.c
@@ -0,0 +1,260 @@
+/* How a frame reaches the canvas in the browser.
+ *
+ * SDL's software renderer presents with MAIN_THREAD_EM_ASM: the thread that
+ * has the frame stops, the browser's main thread is asked to convert 102,400
+ * pixels in JavaScript and hand them to putImageData, and only when it has
+ * done so does the game go on. That is a synchronous hop to another thread
+ * once a frame, and it costs about eight milliseconds -- which is why raising
+ * the refresh cap to sixty frames a second produced thirty-seven, arriving two
+ * display refreshes apart. The emulation had headroom to spare; the present
+ * did not.
+ *
+ * So the frame does not go through SDL at all here. The game converts it to
+ * RGBA where it already is -- in wasm, off a lookup table, a few hundred
+ * microseconds -- into a buffer in the shared heap, and bumps a counter. The
+ * page reads that buffer in its own requestAnimationFrame and puts it on the
+ * canvas. Nothing blocks: the game never waits for the browser's main thread,
+ * and the main thread never waits for the game.
+ *
+ * The two counters also pace it. The page bumps `vsync` once per refresh, and
+ * the game publishes at most one frame per refresh it has not answered yet, so
+ * a frame is drawn just after a refresh and shown on the next one -- evenly
+ * spaced, rather than beating against the display. If the page stops ticking
+ * (a hidden tab, or no requestAnimationFrame at all) the counter stops moving,
+ * and after a quarter of a second the caller is told to fall back to its own
+ * timer so that nothing depends on the page being there.
+ *
+ * `seq` is the other half: the page reads it, copies the buffer, and reads it
+ * again, so a frame published while it was copying is noticed rather than torn
+ * into the one before it.
+ */
+
+#include <SDL2/SDL.h>
+
+#include "sys.h"
+#include "pwindow.h"
+#include "debug.h"
+#include "liblsdl2_web.h"
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#else
+#define EMSCRIPTEN_KEEPALIVE
+#endif
+
+#define WEB_CANVAS_MAGIC 0x424F4443   /* 'BODC' */
+
+/* How long the page may go without a refresh before the game stops waiting for
+ * one. A hidden tab stops calling requestAnimationFrame entirely. */
+#define WEB_VSYNC_IDLE_US 250000
+
+/* Read by the page as HEAPU32[(ptr>>2) + n], so every field is a uint32 and
+ * the order is part of the interface (see the presenting half of bod-pre.js). */
+typedef struct {
+  uint32_t magic;      /* set last: the page waits for it before reading */
+  uint32_t width;
+  uint32_t height;
+  uint32_t pixels;     /* RGBA8888, width*height, in the shared heap */
+  uint32_t seq;        /* frames published; the page's seqlock */
+  uint32_t vsync;      /* display refreshes, counted by the page */
+  uint32_t tick;       /* when the last one was, in microseconds of the page's
+                        * clock -- which wraps, so only differences are used */
+  uint32_t presented;  /* frames the page has drawn */
+  uint32_t stale;      /* refreshes that found no new frame */
+} web_canvas_t;
+
+static web_canvas_t canvas;
+static uint32_t *fb;
+static uint32_t *lut;            /* RGB565 -> RGBA8888, one entry per value */
+static uint32_t taken;           /* the refresh the last published frame answered */
+static uint32_t taken_tick;      /* and when that refresh was */
+static uint32_t seen;            /* the last value of vsync we looked at */
+static uint32_t seen_tick;       /* and when it says it was */
+static int64_t  seen_at;         /* when we noticed it change, by our own clock */
+static int xfactor, yfactor;
+
+/* Handed to the page, which reads the block above out of the shared heap.
+ * Zero until there is something to read. */
+EMSCRIPTEN_KEEPALIVE
+uint32_t bod_canvas_info(void) {
+  return canvas.magic == WEB_CANVAS_MAGIC ? (uint32_t)(uintptr_t)&canvas : 0;
+}
+
+int web_canvas_wanted(void) {
+#ifdef __EMSCRIPTEN__
+  char *spec = sys_getenv("BOD_PRESENT");
+  return !(spec && sys_strcmp(spec, "sdl") == 0);
+#else
+  return 0;
+#endif
+}
+
+int web_canvas_init(int width, int height, int xf, int yf) {
+  uint32_t i, r, g, b;
+
+  if (width <= 0 || height <= 0) return -1;
+  if (xf < 1) xf = 1;
+  if (yf < 1) yf = 1;
+
+  if ((fb = sys_calloc(width * xf * height * yf, sizeof(uint32_t))) == NULL) return -1;
+  if ((lut = sys_calloc(65536, sizeof(uint32_t))) == NULL) {
+    sys_free(fb);
+    fb = NULL;
+    return -1;
+  }
+
+  /* The canvas takes its bytes in R,G,B,A order, which on a little-endian
+   * machine is what a uint32 of 0xAABBGGRR writes. The low bits of each
+   * channel are filled from its high ones, so that 0x1F comes out 0xFF. */
+  for (i = 0; i < 65536; i++) {
+    r = (i >> 11) & 0x1F;
+    g = (i >>  5) & 0x3F;
+    b =  i        & 0x1F;
+    r = (r << 3) | (r >> 2);
+    g = (g << 2) | (g >> 4);
+    b = (b << 3) | (b >> 2);
+    lut[i] = 0xFF000000 | (b << 16) | (g << 8) | r;
+  }
+
+  xfactor = xf;
+  yfactor = yf;
+  canvas.width  = width * xf;
+  canvas.height = height * yf;
+  canvas.pixels = (uint32_t)(uintptr_t)fb;
+  canvas.seq = 0;
+  canvas.vsync = 0;
+  canvas.tick = 0;
+  seen = 0;
+  seen_tick = 0;
+  taken = 0;
+  taken_tick = 0;
+  seen_at = 0;
+
+  __atomic_store_n(&canvas.magic, WEB_CANVAS_MAGIC, __ATOMIC_RELEASE);
+  debug(DEBUG_INFO, "SDL", "canvas present: %dx%d, the page draws it", canvas.width, canvas.height);
+
+  return 0;
+}
+
+void web_canvas_finish(void) {
+  __atomic_store_n(&canvas.magic, 0, __ATOMIC_RELEASE);
+  if (fb)  { sys_free(fb);  fb = NULL; }
+  if (lut) { sys_free(lut); lut = NULL; }
+}
+
+/* One rectangle of the task's RGB565 surface, converted into the frame the
+ * page will draw. src_width and src_height are the surface's size in pixels;
+ * the rectangle is (sx,sy,w,h) of it, landing at (dx,dy) of the frame.
+ *
+ * The rectangle is clipped to both, which is not a formality: SDL_RenderCopy
+ * clips against the render target, so the rectangles the window manager hands
+ * down have never had to be inside it, and one that is not would otherwise be
+ * written straight past the end of the frame.
+ */
+void web_canvas_blit565(uint8_t *src, int src_width, int src_height,
+                        int sx, int sy, int w, int h, int dx, int dy) {
+  uint16_t *s;
+  uint32_t *d, v;
+  int i, j, k, l, fw, max;
+
+  if (fb == NULL || src == NULL) return;
+
+  if (sx < 0) { w += sx; dx -= sx; sx = 0; }
+  if (sy < 0) { h += sy; dy -= sy; sy = 0; }
+  if (dx < 0) { w += dx; sx -= dx; dx = 0; }
+  if (dy < 0) { h += dy; sy -= dy; dy = 0; }
+
+  if (w > src_width  - sx) w = src_width  - sx;
+  if (h > src_height - sy) h = src_height - sy;
+
+  max = ((int)canvas.width  - dx * xfactor) / xfactor;
+  if (w > max) w = max;
+  max = ((int)canvas.height - dy * yfactor) / yfactor;
+  if (h > max) h = max;
+
+  if (w <= 0 || h <= 0) return;
+
+  fw = canvas.width;
+  s = (uint16_t *)src + (sy * src_width) + sx;
+  d = fb + (dy * yfactor) * fw + (dx * xfactor);
+
+  if (xfactor == 1 && yfactor == 1) {
+    for (i = 0; i < h; i++) {
+      for (j = 0; j < w; j++) d[j] = lut[s[j]];
+      s += src_width;
+      d += fw;
+    }
+  } else {
+    for (i = 0; i < h; i++) {
+      for (j = 0, l = 0; j < w; j++) {
+        v = lut[s[j]];
+        for (k = 0; k < xfactor; k++) d[l++] = v;
+      }
+      for (k = 1; k < yfactor; k++) {
+        sys_memcpy(d + k * fw, d, l * sizeof(uint32_t));
+      }
+      s += src_width;
+      d += fw * yfactor;
+    }
+  }
+}
+
+void web_canvas_fill(uint32_t rgba) {
+  uint32_t i, n;
+
+  if (fb == NULL) return;
+  n = canvas.width * canvas.height;
+  for (i = 0; i < n; i++) fb[i] = rgba;
+}
+
+/* The frame is complete. Answer the refresh it was drawn for and let the page
+ * know there is something new to draw. */
+void web_canvas_publish(void) {
+  if (fb == NULL) return;
+  taken = seen;
+  taken_tick = seen_tick;
+  __atomic_store_n(&canvas.seq, canvas.seq + 1, __ATOMIC_RELEASE);
+}
+
+/* 1 if a refresh is waiting for a frame, 0 if the last one has been answered
+ * or would come sooner than interval, -1 if the page is not refreshing at all
+ * and the caller should use its own timer instead.
+ *
+ * The refreshes are compared by the timestamps the page records for them
+ * rather than by when this happened to notice them: the loop looks in several
+ * times per refresh, and a gap measured from the looking would be short by as
+ * much as one look, which at sixty frames a second is enough to reject a
+ * refresh that is really due.
+ */
+int web_canvas_due(int64_t interval) {
+  uint32_t v, t;
+  int64_t now;
+
+  if (fb == NULL) return -1;
+
+  /* tick is written before vsync and read after it, so the timestamp that
+   * comes back belongs to that refresh or an older one -- never a newer. */
+  v = __atomic_load_n(&canvas.vsync, __ATOMIC_ACQUIRE);
+  t = __atomic_load_n(&canvas.tick, __ATOMIC_RELAXED);
+  now = sys_get_clock();
+
+  if (v != seen) {
+    seen = v;
+    seen_tick = t;
+    seen_at = now;
+  }
+
+  if (seen_at == 0 || (now - seen_at) > WEB_VSYNC_IDLE_US) return -1;
+  if (seen == taken) return 0;
+
+  /* BOD_FPS, as a ceiling on the display's own rate. An eighth of slack, so
+   * that asking for exactly the rate the display already refreshes at is not
+   * refused by a fraction of a millisecond -- while asking for half of it
+   * still lets one refresh through in two. */
+  if (interval > 0 && taken_tick != seen_tick &&
+      (int64_t)(uint32_t)(seen_tick - taken_tick) < interval - interval / 8) {
+    return 0;
+  }
+
+  return 1;
+}
