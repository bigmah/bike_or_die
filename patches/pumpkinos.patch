+/* Write what the application changed in a database it still has open.
+ *
+ * A dirty element is normally written when the database is closed, and an
+ * application keeps its own databases open for as long as it runs -- so
+ * anything it saved into one went with the process. Bike or Die keeps its
+ * registration there, which is why entering a valid code never survived a
+ * restart. */
+static void StoFlushDatabase(storage_t *sto, storage_db_t *db) {
+  storage_handle_t *h;
+  vfs_file_t *f;
+  void *encoded;
+  UInt32 i, size;
+  char buf[VFS_PATH];
+  int n = 0;
+
+  for (i = 0; i < db->numRecs; i++) {
+    if ((h = db->elements[i]) == NULL || !(h->htype & STO_INFLATED)) continue;
+
+    if (db->ftype == STO_TYPE_RES) {
+      if (!(h->d.res.attr & dmRecAttrDirty)) continue;
+      encoded = NULL;
+      if (h->d.res.encoder && h->d.res.decoded) {
+        encoded = h->d.res.encoder(h->d.res.decoded, &size);
+      }
+      storage_name(sto, db->name, STO_FILE_ELEMENT, h->d.res.id, h->d.res.type, 0, 0, buf);
+      if ((f = StoVfsOpen(sto->session, buf, VFS_WRITE | VFS_TRUNC)) != NULL) {
+        if (encoded) {
+          vfs_write(f, encoded, size);
+        } else {
+          vfs_write(f, h->buf, h->size);
+        }
+        vfs_close(f);
+        n++;
+      }
+      if (encoded) sys_free(encoded);
+      h->d.res.attr &= ~dmRecAttrDirty;
+    } else {
+      if (!(h->d.rec.attr & dmRecAttrDirty)) continue;
+      storage_name(sto, db->name, STO_FILE_ELEMENT, 0, 0, h->d.rec.attr & ATTR_MASK, h->d.rec.uniqueID, buf);
+      if ((f = StoVfsOpen(sto->session, buf, VFS_WRITE | VFS_TRUNC)) != NULL) {
+        vfs_write(f, h->buf, h->size);
+        vfs_close(f);
+        n++;
+      }
+      h->d.rec.attr &= ~dmRecAttrDirty;
+    }
+  }
+
+  if (n) {
+    if (db->ftype == STO_TYPE_REC) StoWriteIndex(sto, db);
+    debug(DEBUG_INFO, "STOR", "flushed %d unsaved element%s of \"%s\"", n, n == 1 ? "" : "s", db->name);
+  }
+}
