+/* Bike or Die's levels and level packs, from the macOS window itself, and the
+ * Pause button that brings the pause menu down over the game
+ * (liblsdl2_mac_pause.m).
+ *
+ * The browser build has a row of controls above the screen -- Level pack,
+ * Levels..., Previous / Restart / Next -- that drives the game's own Game menu
+ * and level pack dialogs through bodpack.c. This is that row for the native
+ * window: controls in its title bar, the same commands in a Level menu, and
+ * a sheet over the screen that lists the packs with a field to find one. It
+ * knows nothing about the game. Every control is a command handed to
+ * bod_pack_command(), and the game's answer is the status text read back with
+ * bod_pack_state(); bodpack.c describes both.
+ *
+ * All of it runs on the main thread, which on macOS is the one that owns the
+ * window and pumps SDL's events: the controls' actions and the timer that
+ * polls the status fire from inside that pump. None of it blocks, and the only
+ * calls into PumpkinOS are bod_pack_command(), bod_pack_state() and
+ * bod_pack_seq(), none of which takes a lock.
+ */
+
+#import <Cocoa/Cocoa.h>
+
+#include <dlfcn.h>
+#include <mach-o/dyld.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <SDL2/SDL.h>
+#include <SDL2/SDL_syswm.h>
+
+#include "liblsdl2_mac.h"
+#include "liblsdl2_screen.h"
+
+#define TITLEBAR_BUTTONS 78.0   /* room for close, minimise and zoom */
+#define POLL_BUSY        0.08   /* seconds between looks while a command is under way */
+#define POLL_IDLE        1.5    /* and otherwise, to keep the pack's name current */
+#define COMMAND_TIMEOUT  10.0
+#define NOTICE_TIMEOUT   5.0
+
+static NSString *const kPacksNote = @"Pick one and it starts. These are the game's own packs, in its order.";
+
+/* Where the Screen setting is kept. The process is PumpkinOS's, run from
+ * Application Support rather than from inside the bundle, so it has no
+ * bundle identifier of its own to keep defaults under: this is the bundle's. */
+static NSString *const kDefaultsSuite = @"local.bikeordie2";
+static NSString *const kScreenKey = @"Screen";
+
+static void mac_log(NSString *format, ...) NS_FORMAT_FUNCTION(1, 2);
+
+static void mac_log(NSString *format, ...) {
+  NSString *text;
+  va_list args;
+
+  va_start(args, format);
+  text = [[NSString alloc] initWithFormat:format arguments:args];
+  va_end(args);
+  liblsdl2_log(text.UTF8String);
+}
+
+/* ------------------------------------------------------- reaching bodpack.c */
+
+static void (*pk_command)(const char *cmd);
+static const char *(*pk_state)(void);
+static uint32_t (*pk_seq)(void);
+
+/* libpumpkin is loaded after this library, by libos, and not necessarily into
+ * the global namespace; if the plain lookup misses, find it among the loaded
+ * images by name and ask it directly. */
+static void *pk_symbol(const char *name) {
+  static const char suffix[] = "/libpumpkin.dylib";
+  const char *image;
+  void *sym, *handle;
+  size_t n, m = sizeof(suffix) - 1;
+  uint32_t i;
+
+  if ((sym = dlsym(RTLD_DEFAULT, name)) != NULL) return sym;
+
+  for (i = 0; i < _dyld_image_count(); i++) {
+    image = _dyld_get_image_name(i);
+    n = image ? strlen(image) : 0;
+    if (n < m || strcmp(image + n - m, suffix) != 0) continue;
+    if ((handle = dlopen(image, RTLD_LAZY | RTLD_NOLOAD)) != NULL) {
+      sym = dlsym(handle, name);
+      dlclose(handle);
+      if (sym) return sym;
+    }
+  }
+
+  return NULL;
+}
+
+static BOOL pk_ready(void) {
+  if (pk_command && pk_state && pk_seq) return YES;
+  pk_command = pk_symbol("bod_pack_command");
+  pk_state = pk_symbol("bod_pack_state");
+  pk_seq = pk_symbol("bod_pack_seq");
+
+  return pk_command && pk_state && pk_seq;
+}
+
+@interface BODStatus : NSObject
+@property (nonatomic) uint32_t seq;
+@property (nonatomic, copy) NSString *state;    /* idle, busy, listed, done, error */
+@property (nonatomic, copy) NSString *error;
+@property (nonatomic, copy) NSString *title;    /* of the level list: names the pack */
+@property (nonatomic, copy) NSArray<NSString *> *names;
+@end
+
+@implementation BODStatus
+@end
+
+/* The status, taken whole. Its sequence number is odd while the game's thread
+ * is writing the text and moves on when it is done, so a copy made under a
+ * write is noticed and made again. */
+static BODStatus *pk_read(void) {
+  NSMutableArray<NSString *> *names;
+  NSArray<NSString *> *lines;
+  NSString *text = nil, *first;
+  BODStatus *status;
+  NSRange space;
+  NSUInteger i;
+  uint32_t s1 = 0;
+  int tries;
+
+  if (!pk_ready()) return nil;
+
+  for (tries = 0; tries < 50 && text == nil; tries++) {
+    s1 = pk_seq();
+    if ((s1 & 1) == 0) {
+      text = [NSString stringWithUTF8String:pk_state()];
+      if (pk_seq() != s1) text = nil;
+    }
+    if (text == nil) usleep(100);
+  }
+  if (text == nil) return nil;
+
+  status = [[BODStatus alloc] init];
+  status.seq = s1;
+  lines = [text componentsSeparatedByString:@"\n"];
+  first = lines.count ? lines[0] : @"";
+  space = [first rangeOfString:@" "];
+  status.state = first.length == 0 ? @"idle" : space.location == NSNotFound ? first : [first substringToIndex:space.location];
+  status.error = space.location == NSNotFound ? @"" : [first substringFromIndex:space.location + 1];
+  status.title = (lines.count > 1 && [lines[1] hasPrefix:@"title "]) ? [lines[1] substringFromIndex:6] : @"";
+
+  if ([status.state isEqualToString:@"listed"]) {
+    names = [NSMutableArray array];
+    for (i = 2; i < lines.count; i++) {
+      if (lines[i].length) [names addObject:lines[i]];
+    }
+    status.names = names;
+  }
+
+  return status;
+}
+
+/* ------------------------------------------------------------ the controls */
+
+@interface BODLevelControls : NSObject <NSSearchFieldDelegate, NSTableViewDataSource, NSTableViewDelegate, NSMenuItemValidation>
+- (void)attachTo:(NSWindow *)window;
+- (BOOL)wantsKeys;
+- (BOOL)busy;
+- (IBAction)openPacks:(id)sender;
+- (void)sendGameMenu:(NSString *)label;
+- (NSString *)gameTitle;
+- (void)chooseScreen:(int)mode;
+- (void)pauseChanged:(BOOL)paused;
+@end
+
+@implementation BODLevelControls {
+  __weak NSWindow *_window;
+
+  /* the row under the title bar */
+  NSButton *_pauseButton;
+  NSButton *_packButton;
+  NSButton *_levelsButton;
+  NSSegmentedControl *_stepper;
+  NSTextField *_info;
+  NSString *_title;
+  NSString *_notice;
+  NSTimer *_noticeTimer;
+
+  /* the level pack sheet */
+  NSPanel *_sheet;
+  NSSearchField *_filter;
+  NSTableView *_table;
+  NSTextField *_note;
+  NSButton *_cancel;
+  NSButton *_play;
+  NSArray<NSString *> *_names;
+  NSMutableArray<NSNumber *> *_shown;   /* indexes into _names that pass the filter */
+  NSInteger _current;                   /* the pack the game is on, or -1 */
+  BOOL _listed;                         /* the names are in and the game's pack list is up behind */
+  BOOL _fromPause;                      /* opened from the pause menu, and going back to it */
+
+  /* the command under way */
+  NSTimer *_poll;
+  BOOL _pending;
+  BOOL _walk;
+  BOOL _sawBusy;
+  uint32_t _sentSeq;
+  NSDate *_deadline;
+  void (^_done)(BODStatus *status);
+}
+
+- (void)attachTo:(NSWindow *)window {
+  NSArray<NSArray<NSString *> *> *steps;
+  NSTitlebarAccessoryViewController *accessory;
+  NSSize before, after;
+  CGFloat titlebar, width;
+  NSStackView *stack;
+  NSImage *image;
+  NSView *row;
+  NSInteger i;
+
+  _window = window;
+  _names = @[];
+  _shown = [NSMutableArray array];
+  _current = -1;
+
+  _packButton = [NSButton buttonWithTitle:@"Level Pack…" target:self action:@selector(openPacks:)];
+  _packButton.toolTip = @"Choose a level pack";
+  _levelsButton = [NSButton buttonWithTitle:@"Levels…" target:self action:@selector(levels:)];
+  _levelsButton.toolTip = @"Choose a level in this pack";
+  _pauseButton = [NSButton buttonWithTitle:@"Pause" target:self action:@selector(pause:)];
+  _pauseButton.toolTip = @"Pause: levels, packs, controls and settings (Esc)";
+
+  _info = [NSTextField labelWithString:@""];
+  _info.textColor = NSColor.secondaryLabelColor;
+  _info.lineBreakMode = NSLineBreakByTruncatingTail;
+  [_info setContentHuggingPriority:1 forOrientation:NSLayoutConstraintOrientationHorizontal];
+  [_info setContentCompressionResistancePriority:NSLayoutPriorityDefaultLow forOrientation:NSLayoutConstraintOrientationHorizontal];
+
+  _stepper = [[NSSegmentedControl alloc] init];
+  _stepper.segmentCount = 3;
+  _stepper.trackingMode = NSSegmentSwitchTrackingMomentary;
+  steps = @[ @[ @"chevron.backward",       @"◀", @"Previous level" ],
+             @[ @"arrow.counterclockwise", @"↻", @"Restart level" ],
+             @[ @"chevron.forward",        @"▶", @"Next level" ] ];
+  for (i = 0; i < 3; i++) {
+    image = [NSImage imageWithSystemSymbolName:steps[i][0] accessibilityDescription:steps[i][2]];
+    if (image) [_stepper setImage:image forSegment:i];
+    else [_stepper setLabel:steps[i][1] forSegment:i];
+    [_stepper setToolTip:steps[i][2] forSegment:i];
+    [_stepper setWidth:34 forSegment:i];
+  }
+  _stepper.target = self;
+  _stepper.action = @selector(step:);
+
+  /* The row is for the mouse. Kept out of the key view loop, a button can
+   * never be where Space or Return lands, which ride and pick. */
+  _packButton.refusesFirstResponder = YES;
+  _levelsButton.refusesFirstResponder = YES;
+  _stepper.refusesFirstResponder = YES;
+  _pauseButton.refusesFirstResponder = YES;
+
+  /* The pack's name takes up the slack, which puts Previous / Restart / Next
+   * at the right edge, where the browser's row has them. */
+  for (NSView *view in @[ _packButton, _levelsButton, _stepper, _pauseButton ]) {
+    [view setContentHuggingPriority:NSLayoutPriorityDefaultHigh forOrientation:NSLayoutConstraintOrientationHorizontal];
+    [view setContentCompressionResistancePriority:NSLayoutPriorityDefaultHigh forOrientation:NSLayoutConstraintOrientationHorizontal];
+  }
+  stack = [NSStackView stackViewWithViews:@[ _packButton, _levelsButton, _info, _stepper, _pauseButton ]];
+  stack.orientation = NSUserInterfaceLayoutOrientationHorizontal;
+  stack.distribution = NSStackViewDistributionFill;
+  stack.alignment = NSLayoutAttributeCenterY;
+  stack.spacing = 8;
+  stack.edgeInsets = NSEdgeInsetsMake(0, 4, 0, 10);
+  stack.translatesAutoresizingMaskIntoConstraints = NO;
+
+  /* In the title bar, not in a strip under it. The window is the game's
+   * screen at an exact integer scale plus its title bar, and at the default
+   * zoom that already fills a laptop's screen above the Dock: a strip would
+   * push the bottom of the game under the Dock. The title, "PumpkinOS",
+   * makes way for them. */
+  titlebar = NSHeight(window.frame) - NSHeight([window contentRectForFrameRect:window.frame]);
+  width = NSWidth(window.frame) - TITLEBAR_BUTTONS;
+  if (width < 560) {
+    for (NSControl *control in @[ _packButton, _levelsButton, _stepper, _pauseButton ]) {
+      control.controlSize = NSControlSizeSmall;
+      control.font = [NSFont systemFontOfSize:[NSFont systemFontSizeForControlSize:NSControlSizeSmall]];
+    }
+    _info.font = [NSFont systemFontOfSize:[NSFont systemFontSizeForControlSize:NSControlSizeSmall]];
+  }
+
+  row = [[NSView alloc] initWithFrame:NSMakeRect(0, 0, width, titlebar)];
+  [row addSubview:stack];
+  [NSLayoutConstraint activateConstraints:@[
+    [stack.leadingAnchor constraintEqualToAnchor:row.leadingAnchor],
+    [stack.trailingAnchor constraintEqualToAnchor:row.trailingAnchor],
+    [stack.topAnchor constraintEqualToAnchor:row.topAnchor],
+    [stack.bottomAnchor constraintEqualToAnchor:row.bottomAnchor] ]];
+
+  accessory = [[NSTitlebarAccessoryViewController alloc] init];
+  accessory.layoutAttribute = NSLayoutAttributeRight;
+  accessory.view = row;
+
+  /* A title bar accessory takes nothing from the content, which is the game's
+   * screen at an exact scale; should one ever do, give it back. */
+  before = window.contentView.frame.size;
+  window.titleVisibility = NSWindowTitleHidden;
+  [window addTitlebarAccessoryViewController:accessory];
+  after = window.contentView.frame.size;
+  if (!NSEqualSizes(before, after)) [window setContentSize:before];
+  mac_log(@"level controls: %.0fx%.0f in the title bar; content %.0fx%.0f, %.0fx%.0f with them in, now %.0fx%.0f",
+          width, titlebar, before.width, before.height, after.width, after.height,
+          window.contentView.frame.size.width, window.contentView.frame.size.height);
+
+  [self installMenu];
+  [self showInfo];
+  [self schedulePoll:POLL_IDLE];
+}
+
+- (void)addItem:(NSString *)title action:(SEL)action key:(NSString *)key
+      modifiers:(NSEventModifierFlags)modifiers to:(NSMenu *)menu {
+  NSMenuItem *item = [[NSMenuItem alloc] initWithTitle:title action:action keyEquivalent:key];
+
+  item.keyEquivalentModifierMask = modifiers;
+  item.target = self;
+  [menu addItem:item];
+}
+
+/* The same commands in the menu bar, where they have keys. Command chords
+ * never reach the game (liblsdl2.c), so these cannot ride or type either. */
+- (void)installMenu {
+  NSMenu *bar = NSApp.mainMenu, *menu;
+  NSMenuItem *top;
+  NSInteger at;
+
+  if (bar == nil) return;
+
+  menu = [[NSMenu alloc] initWithTitle:@"Level"];
+  /* Escape is its key, in the window: a menu item that took Escape would take
+   * it from every sheet as well. */
+  [self addItem:@"Pause" action:@selector(pause:) key:@"" modifiers:0 to:menu];
+  [menu addItem:[NSMenuItem separatorItem]];
+  [self addItem:@"Level Pack…" action:@selector(openPacks:) key:@"l" modifiers:NSEventModifierFlagCommand to:menu];
+  [self addItem:@"Levels…" action:@selector(levels:) key:@"l" modifiers:NSEventModifierFlagCommand | NSEventModifierFlagShift to:menu];
+  [menu addItem:[NSMenuItem separatorItem]];
+  [self addItem:@"Previous Level" action:@selector(previousLevel:) key:@"[" modifiers:NSEventModifierFlagCommand to:menu];
+  [self addItem:@"Restart Level" action:@selector(restartLevel:) key:@"r" modifiers:NSEventModifierFlagCommand to:menu];
+  [self addItem:@"Next Level" action:@selector(nextLevel:) key:@"]" modifiers:NSEventModifierFlagCommand to:menu];
+
+  top = [[NSMenuItem alloc] initWithTitle:@"Level" action:NULL keyEquivalent:@""];
+  top.submenu = menu;
+  at = NSApp.windowsMenu ? [bar indexOfItemWithSubmenu:NSApp.windowsMenu] : -1;
+  if (at < 0) at = bar.numberOfItems;
+  [bar insertItem:top atIndex:at];
+
+  [bar insertItem:[self screenMenu] atIndex:at];
+}
+
+/* ------------------------------------------------------------ the screen */
+
+/* View -> Pixels, Smooth, xBR: how the game's 320x320 is made up to the
+ * pixels the window has (liblsdl2_screen.c). The browser build has the same
+ * three under Settings in its pause menu. The choice is kept; BOD_SCREEN,
+ * when it is set, is the choice for that run and is not. */
+- (NSMenuItem *)screenMenu {
+  NSArray<NSArray<NSString *> *> *modes;
+  NSMenuItem *top, *item;
+  NSMenu *menu;
+  NSInteger i;
+  int saved;
+
+  modes = @[ @[ @"Pixels", @"1", @"The game's own pixels, each drawn as a square" ],
+             @[ @"Smooth", @"2", @"Blended between pixels" ],
+             @[ @"xBR",    @"3", @"Edges, wheels and lettering redrawn as smooth lines at the display's resolution" ] ];
+
+  menu = [[NSMenu alloc] initWithTitle:@"View"];
+  if (@available(macOS 14.0, *)) {
+    [menu addItem:[NSMenuItem sectionHeaderWithTitle:@"Screen"]];
+  }
+  for (i = 0; i < (NSInteger)modes.count; i++) {
+    [self addItem:modes[i][0] action:@selector(setScreen:) key:modes[i][1] modifiers:NSEventModifierFlagCommand to:menu];
+    item = menu.itemArray.lastObject;
+    item.tag = i;          /* SCREEN_PIXELS, SCREEN_SMOOTH, SCREEN_XBR */
+    item.toolTip = modes[i][2];
+  }
+
+  if (!liblsdl2_screen_from_env()) {
+    saved = screen_mode_named([[[NSUserDefaults alloc] initWithSuiteName:kDefaultsSuite] stringForKey:kScreenKey].UTF8String);
+    if (saved >= 0) liblsdl2_screen_set(saved);
+  }
+  mac_log(@"screen: %s%s", screen_mode_name(liblsdl2_screen_get()), liblsdl2_screen_from_env() ? " (BOD_SCREEN)" : "");
+
+  top = [[NSMenuItem alloc] initWithTitle:@"View" action:NULL keyEquivalent:@""];
+  top.submenu = menu;
+  return top;
+}
+
+- (void)setScreen:(NSMenuItem *)sender {
+  [self chooseScreen:(int)sender.tag];
+}
+
+/* The View menu's choice and the pause menu's are the same setting, kept. */
+- (void)chooseScreen:(int)mode {
+  liblsdl2_screen_set(mode);
+  [[[NSUserDefaults alloc] initWithSuiteName:kDefaultsSuite] setObject:@(screen_mode_name(mode))
+                                                                 forKey:kScreenKey];
+}
+
+- (BOOL)validateMenuItem:(NSMenuItem *)item {
+  if (item.action == @selector(setScreen:)) {
+    item.state = item.tag == liblsdl2_screen_get() ? NSControlStateValueOn : NSControlStateValueOff;
+    return YES;
+  }
+  return _sheet.sheetParent == nil;
+}
+
+- (BOOL)wantsKeys {
+  return _sheet != nil && (_sheet.sheetParent != nil || _sheet.isVisible);
+}
+
+/* Up, or waiting for the game to answer a command of ours. */
+- (BOOL)busy {
+  return [self wantsKeys] || _pending;
+}
+
+/* ---------------------------------------------------------- the row's text */
+
+/* Normally the pack the game is on; for a few seconds after a command the
+ * game turned down, why. */
+- (void)showInfo {
+  if (_notice) {
+    _info.stringValue = _notice;
+    _info.textColor = NSColor.systemRedColor;
+  } else {
+    _info.stringValue = _title ? _title : @"";
+    _info.textColor = NSColor.secondaryLabelColor;
+  }
+  _info.toolTip = _info.stringValue.length ? _info.stringValue : nil;
+}
+
+- (void)notice:(NSString *)text {
+  if (text.length == 0) return;
+  _notice = [[[text substringToIndex:1] uppercaseString] stringByAppendingString:[text substringFromIndex:1]];
+  [self showInfo];
+  [_noticeTimer invalidate];
+  _noticeTimer = [NSTimer timerWithTimeInterval:NOTICE_TIMEOUT target:self selector:@selector(clearNotice:) userInfo:nil repeats:NO];
+  [[NSRunLoop mainRunLoop] addTimer:_noticeTimer forMode:NSRunLoopCommonModes];
+}
+
+- (void)clearNotice:(NSTimer *)timer {
+  _notice = nil;
+  _noticeTimer = nil;
+  [self showInfo];
+}
+
+- (void)setGameTitle:(NSString *)title {
+  if (title.length == 0 || [title isEqualToString:_title]) return;
+  _title = [title copy];
+  [self showInfo];
+}
+
+/* ------------------------------------------------------------ the commands */
+
+- (void)schedulePoll:(NSTimeInterval)interval {
+  if (_poll && _poll.timeInterval == interval) return;
+  [_poll invalidate];
+  _poll = [NSTimer timerWithTimeInterval:interval target:self selector:@selector(tick:) userInfo:nil repeats:YES];
+  _poll.tolerance = interval / 4;
+  [[NSRunLoop mainRunLoop] addTimer:_poll forMode:NSRunLoopCommonModes];
+}
+
+/* Hands `command` to the game and polls until it has answered. A walk through
+ * the game's dialogs (open, pick) answers "busy" first; a "done" or "idle"
+ * before that is not its answer but a status left over from before, published
+ * again for a new title. */
+- (void)send:(NSString *)command walk:(BOOL)walk done:(void (^)(BODStatus *status))done {
+  BODStatus *before = pk_read();
+
+  if (before == nil) {
+    [self notice:@"the game is still starting"];
+    if (done) done(nil);
+    return;
+  }
+
+  _pending = YES;
+  _walk = walk;
+  _sawBusy = NO;
+  _sentSeq = before.seq;
+  _deadline = [NSDate dateWithTimeIntervalSinceNow:COMMAND_TIMEOUT];
+  _done = [done copy];
+  pk_command(command.UTF8String);
+  [self schedulePoll:POLL_BUSY];
+}
+
+- (void)endCommand {
+  _pending = NO;
+  _done = nil;
+  [self schedulePoll:POLL_IDLE];
+}
+
+- (void)tick:(NSTimer *)timer {
+  void (^done)(BODStatus *status);
+  BODStatus *status = pk_read();
+  BOOL finished = NO;
+
+  if (status == nil) return;
+  [self setGameTitle:status.title];
+
+  if (!_pending) {
+    /* The game's pack list can close under the sheet: a dialog of its own. */
+    if (_listed && ![status.state isEqualToString:@"listed"]) [self closeSheet];
+    return;
+  }
+
+  if (status.seq != _sentSeq) {
+    if ([status.state isEqualToString:@"busy"]) {
+      _sawBusy = YES;
+    } else if ([status.state isEqualToString:@"error"] || [status.state isEqualToString:@"listed"]) {
+      finished = YES;
+    } else {
+      finished = !_walk || _sawBusy;
+    }
+  }
+
+  if (!finished && _deadline.timeIntervalSinceNow < 0) {
+    status.state = @"error";
+    status.error = @"the game did not answer";
+    finished = YES;
+  }
+  if (!finished) return;
+
+  done = _done;
+  [self endCommand];
+  if ([status.state isEqualToString:@"error"]) [self notice:status.error];
+  if (done) done(status);
+}
+
+/* An item of the game's Game menu, for the game itself. The level buttons are
+ * for riding, so they end a pause if there is one. */
+- (void)gameMenu:(NSString *)label {
+  if (_sheet.sheetParent != nil) return;
+  if (liblsdl2_mac_pause_session()) liblsdl2_mac_pause_resume();
+  [self sendGameMenu:label];
+}
+
+- (void)sendGameMenu:(NSString *)label {
+  if (_sheet.sheetParent != nil) return;
+  [self send:[@"menu " stringByAppendingString:label] walk:NO done:nil];
+}
+
+- (IBAction)pause:(id)sender {
+  if (liblsdl2_mac_pause_session()) liblsdl2_mac_pause_resume();
+  else liblsdl2_mac_pause_open();
+}
+
+- (void)pauseChanged:(BOOL)paused {
+  _pauseButton.title = paused ? @"Resume" : @"Pause";
+}
+
+- (NSString *)gameTitle {
+  return _title ? _title : @"";
+}
+
+- (IBAction)levels:(id)sender        { [self gameMenu:@"Select Level"]; }
+- (IBAction)previousLevel:(id)sender { [self gameMenu:@"Previous Level"]; }
+- (IBAction)restartLevel:(id)sender  { [self gameMenu:@"Restart Level"]; }
+- (IBAction)nextLevel:(id)sender     { [self gameMenu:@"Next Level"]; }
+
+- (IBAction)step:(NSSegmentedControl *)sender {
+  switch (sender.selectedSegment) {
+    case 0: [self previousLevel:sender]; break;
+    case 1: [self restartLevel:sender]; break;
+    case 2: [self nextLevel:sender]; break;
+  }
+}
+
+/* ------------------------------------------------------- the level packs */
+
+- (void)buildSheet {
+  NSStackView *content, *buttons;
+  NSTableColumn *column;
+  NSTextField *heading;
+  NSScrollView *scroll;
+
+  if (_sheet) return;
+
+  _sheet = [[NSPanel alloc] initWithContentRect:NSMakeRect(0, 0, 480, 560)
+                                      styleMask:NSWindowStyleMaskTitled
+                                        backing:NSBackingStoreBuffered
+                                          defer:YES];
+  _sheet.releasedWhenClosed = NO;
+
+  heading = [NSTextField labelWithString:@"Level Packs"];
+  heading.font = [NSFont boldSystemFontOfSize:NSFont.systemFontSize + 2];
+
+  _filter = [[NSSearchField alloc] init];
+  _filter.placeholderString = @"Find a pack";
+  _filter.delegate = self;
+  _filter.target = self;
+  _filter.action = @selector(filterChanged:);
+  _filter.sendsSearchStringImmediately = YES;
+
+  column = [[NSTableColumn alloc] initWithIdentifier:@"pack"];
+  column.resizingMask = NSTableColumnAutoresizingMask;
+  _table = [[NSTableView alloc] initWithFrame:NSZeroRect];
+  [_table addTableColumn:column];
+  _table.headerView = nil;
+  _table.columnAutoresizingStyle = NSTableViewLastColumnOnlyAutoresizingStyle;
+  _table.style = NSTableViewStyleFullWidth;
+  _table.rowHeight = 22;
+  _table.allowsEmptySelection = YES;
+  _table.dataSource = self;
+  _table.delegate = self;
+  _table.target = self;
+  _table.doubleAction = @selector(play:);
+
+  scroll = [[NSScrollView alloc] init];
+  scroll.documentView = _table;
+  scroll.hasVerticalScroller = YES;
+  scroll.autohidesScrollers = YES;
+  scroll.borderType = NSBezelBorder;
+  [scroll setContentHuggingPriority:NSLayoutPriorityDefaultLow forOrientation:NSLayoutConstraintOrientationVertical];
+  [scroll setContentCompressionResistancePriority:NSLayoutPriorityDefaultLow forOrientation:NSLayoutConstraintOrientationVertical];
+
+  _note = [NSTextField wrappingLabelWithString:kPacksNote];
+  _note.textColor = NSColor.secondaryLabelColor;
+
+  _cancel = [NSButton buttonWithTitle:@"Cancel" target:self action:@selector(cancelPacks:)];
+  _cancel.keyEquivalent = @"\033";
+  _play = [NSButton buttonWithTitle:@"Play" target:self action:@selector(play:)];
+  _play.keyEquivalent = @"\r";
+
+  buttons = [[NSStackView alloc] init];
+  buttons.orientation = NSUserInterfaceLayoutOrientationHorizontal;
+  [buttons addView:_cancel inGravity:NSStackViewGravityTrailing];
+  [buttons addView:_play inGravity:NSStackViewGravityTrailing];
+
+  content = [NSStackView stackViewWithViews:@[ heading, _filter, scroll, _note, buttons ]];
+  content.orientation = NSUserInterfaceLayoutOrientationVertical;
+  content.alignment = NSLayoutAttributeLeading;
+  content.spacing = 10;
+  content.edgeInsets = NSEdgeInsetsMake(18, 20, 18, 20);
+  _sheet.contentView = content;
+
+  for (NSView *view in @[ _filter, scroll, _note, buttons ]) {
+    [view.widthAnchor constraintEqualToAnchor:content.widthAnchor constant:-40].active = YES;
+  }
+}
+
+/* Over the screen, and never bigger than it. */
+- (void)sizeSheet {
+  NSSize content = _window.contentView.frame.size;
+  CGFloat width = MAX(300, MIN(520, content.width - 48));
+  CGFloat height = MAX(280, MIN(640, content.height - 48));
+
+  [_sheet setContentSize:NSMakeSize(width, height)];
+  _note.preferredMaxLayoutWidth = width - 40;
+}
+
+- (IBAction)openPacks:(id)sender {
+  __weak BODLevelControls *weakSelf = self;
+  NSWindow *window = _window;
+
+  if (window == nil || _sheet.sheetParent != nil) return;
+
+  /* From behind the pause menu, the pause goes on: the menu makes way, and
+   * comes back if no pack is chosen. */
+  _fromPause = liblsdl2_mac_pause_session();
+  if (_fromPause) liblsdl2_mac_pause_hide_for_packs();
+
+  [self buildSheet];
+  _names = @[];
+  _current = -1;
+  _listed = NO;
+  [_shown removeAllObjects];
+  [_table reloadData];
+  _table.enabled = YES;
+  _filter.stringValue = @"";
+  _filter.enabled = NO;
+  _play.enabled = NO;
+  _cancel.enabled = YES;
+  _note.stringValue = @"Asking the game for its packs…";
+  [self sizeSheet];
+  [window beginSheet:_sheet completionHandler:nil];
+
+  [self send:@"open" walk:YES done:^(BODStatus *status) {
+    [weakSelf packsListed:status];
+  }];
+}
+
+/* A walk that ends without a list -- an error, now on the row, or a dialog of
+ * the game's own that came up on the way -- leaves the screen to the game. */
+- (void)packsListed:(BODStatus *)status {
+  if (_sheet.sheetParent == nil) return;
+
+  if (status == nil || ![status.state isEqualToString:@"listed"]) {
+    [self closeSheet];
+    return;
+  }
+
+  _names = status.names ? status.names : @[];
+  _current = [self currentIndex];
+  _listed = YES;
+  _filter.enabled = YES;
+  [self filter];
+  [_sheet makeFirstResponder:_filter];
+}
+
+/* Which of the names is the pack the game is on: the level list's title ends
+ * with it, except for the built-in pack, which it calls something else. The
+ * browser's panel works it out the same way. */
+- (NSInteger)currentIndex {
+  NSString *title = _title ? _title.lowercaseString : @"", *name;
+  NSUInteger i, length = 0;
+  NSInteger best = -1;
+
+  if ([title hasPrefix:@"built-in"]) title = @"standard";
+  for (i = 0; i < _names.count; i++) {
+    name = [_names[i] stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceCharacterSet].lowercaseString;
+    if (name.length && name.length > length && [title hasSuffix:name]) {
+      best = (NSInteger)i;
+      length = name.length;
+    }
+  }
+
+  return best;
+}
+
+- (IBAction)filterChanged:(id)sender {
+  [self filter];
+}
+
+- (void)filter {
+  NSString *query = [_filter.stringValue stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceCharacterSet];
+  NSInteger select = -1;
+  NSUInteger i;
+
+  [_shown removeAllObjects];
+  for (i = 0; i < _names.count; i++) {
+    if (query.length && [_names[i] rangeOfString:query options:NSCaseInsensitiveSearch | NSDiacriticInsensitiveSearch].location == NSNotFound) continue;
+    if ((NSInteger)i == _current) select = (NSInteger)_shown.count;
+    [_shown addObject:@(i)];
+  }
+  [_table reloadData];
+
+  /* With nothing typed, the pack the game is on; typing picks out the first
+   * pack that matches, so that Return starts it. */
+  if (query.length || select < 0) select = _shown.count ? 0 : -1;
+  if (select >= 0) {
+    [_table selectRowIndexes:[NSIndexSet indexSetWithIndex:(NSUInteger)select] byExtendingSelection:NO];
+    [_table scrollRowToVisible:select];
+  } else {
+    [_table deselectAll:nil];
+  }
+
+  _note.stringValue = _names.count == 0 ? @"The game listed no packs." :
+                      _shown.count == 0 ? @"No pack by that name." : kPacksNote;
+  _play.enabled = _listed && _table.selectedRow >= 0;
+}
+
+- (NSInteger)numberOfRowsInTableView:(NSTableView *)tableView {
+  return (NSInteger)_shown.count;
+}
+
+- (NSView *)tableView:(NSTableView *)tableView viewForTableColumn:(NSTableColumn *)column row:(NSInteger)row {
+  NSTableCellView *cell = [tableView makeViewWithIdentifier:@"pack" owner:self];
+  NSTextField *label;
+  NSInteger index;
+  NSString *name;
+
+  if (cell == nil) {
+    cell = [[NSTableCellView alloc] initWithFrame:NSMakeRect(0, 0, 100, 22)];
+    cell.identifier = @"pack";
+    label = [NSTextField labelWithString:@""];
+    label.lineBreakMode = NSLineBreakByTruncatingTail;
+    label.translatesAutoresizingMaskIntoConstraints = NO;
+    [label setContentCompressionResistancePriority:NSLayoutPriorityDefaultLow forOrientation:NSLayoutConstraintOrientationHorizontal];
+    [cell addSubview:label];
+    cell.textField = label;
+    [NSLayoutConstraint activateConstraints:@[
+      [label.leadingAnchor constraintEqualToAnchor:cell.leadingAnchor constant:6],
+      [label.trailingAnchor constraintEqualToAnchor:cell.trailingAnchor constant:-6],
+      [label.centerYAnchor constraintEqualToAnchor:cell.centerYAnchor] ]];
+  }
+
+  if (row < 0 || row >= (NSInteger)_shown.count) return cell;
+  index = _shown[(NSUInteger)row].integerValue;
+  name = [_names[(NSUInteger)index] stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceCharacterSet];
+  if (index == _current) {
+    cell.textField.stringValue = [name stringByAppendingString:@"  ✓"];
+    cell.textField.font = [NSFont boldSystemFontOfSize:NSFont.systemFontSize];
+  } else {
+    cell.textField.stringValue = name;
+    cell.textField.font = [NSFont systemFontOfSize:NSFont.systemFontSize];
+  }
+
+  return cell;
+}
+
+- (void)tableViewSelectionDidChange:(NSNotification *)notification {
+  _play.enabled = _listed && _table.selectedRow >= 0;
+}
+
+- (void)controlTextDidChange:(NSNotification *)notification {
+  if (notification.object == _filter) [self filter];
+}
+
+/* The search field keeps the keyboard, and the arrows, Return and Escape do
+ * what they would in the list. */
+- (BOOL)control:(NSControl *)control textView:(NSTextView *)textView doCommandBySelector:(SEL)command {
+  NSInteger row;
+
+  if (control != _filter) return NO;
+
+  if (command == @selector(moveDown:) || command == @selector(moveUp:)) {
+    row = _table.selectedRow + (command == @selector(moveDown:) ? 1 : -1);
+    if (row >= 0 && row < (NSInteger)_shown.count) {
+      [_table selectRowIndexes:[NSIndexSet indexSetWithIndex:(NSUInteger)row] byExtendingSelection:NO];
+      [_table scrollRowToVisible:row];
+    }
+    return YES;
+  }
+
+  if (command == @selector(insertNewline:)) {
+    [self play:control];
+    return YES;
+  }
+
+  if (command == @selector(cancelOperation:)) {
+    if (_filter.stringValue.length) {
+      _filter.stringValue = @"";
+      [self filter];
+    } else {
+      [self cancelPacks:control];
+    }
+    return YES;
+  }
+
+  return NO;
+}
+
+/* Hands the choice back to the game's own pack list, which switches and
+ * starts the pack's level; the sheet comes down when it has. */
+- (IBAction)play:(id)sender {
+  __weak BODLevelControls *weakSelf = self;
+  NSInteger row = _table.selectedRow, index;
+  NSString *name;
+
+  if (sender == _table && _table.clickedRow < 0) return;
+  if (!_listed || _pending || row < 0 || row >= (NSInteger)_shown.count) return;
+
+  index = _shown[(NSUInteger)row].integerValue;
+  name = [_names[(NSUInteger)index] stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceCharacterSet];
+
+  /* A pack is somewhere to ride: the pause, if there was one, is over. */
+  if (_fromPause) {
+    _fromPause = NO;
+    liblsdl2_mac_pause_resume();
+  }
+
+  _listed = NO;
+  _filter.enabled = NO;
+  _table.enabled = NO;
+  _play.enabled = NO;
+  _cancel.enabled = NO;
+  _note.stringValue = [NSString stringWithFormat:@"Starting %@…", name];
+
+  [self send:[NSString stringWithFormat:@"pick %ld", (long)index] walk:YES done:^(BODStatus *status) {
+    [weakSelf closeSheet];
+  }];
+}
+
+/* Closing without a choice closes the game's dialogs too. */
+- (IBAction)cancelPacks:(id)sender {
+  if (_sheet.sheetParent == nil) return;
+  if (_pending) [self endCommand];
+  [self closeSheet];
+  if (pk_ready()) pk_command("cancel");
+}
+
+- (void)closeSheet {
+  NSWindow *parent = _sheet.sheetParent;
+
+  _listed = NO;
+  if (parent || _sheet.isVisible) liblsdl2_mac_sheet_closed();
+  if (parent) [parent endSheet:_sheet];
+  [_sheet orderOut:nil];
+
+  if (_fromPause) {
+    _fromPause = NO;
+    liblsdl2_mac_pause_back_from_packs();
+  }
+}
+
+@end
+
+/* ------------------------------------------------------------ the C side */
+
+static BODLevelControls *controls;
+
+void liblsdl2_mac_attach_window(void *window) {
+  NSWindow *nswindow = (__bridge NSWindow *)window;
+
+  if (controls != nil || nswindow == nil) return;
+
+  @autoreleasepool {
+    controls = [[BODLevelControls alloc] init];
+    [controls attachTo:nswindow];
+    liblsdl2_mac_form_attach(window);
+    liblsdl2_mac_pause_attach(window);
+  }
+}
+
+void liblsdl2_mac_attach(SDL_Window *window) {
+  SDL_SysWMinfo info;
+  NSWindow *nswindow;
+
+  if (controls != nil || window == NULL) return;
+
+  if (![NSThread isMainThread]) {
+    mac_log(@"level controls: the window is not on the main thread; none added");
+    return;
+  }
+
+  SDL_VERSION(&info.version);
+  if (!SDL_GetWindowWMInfo(window, &info) || info.subsystem != SDL_SYSWM_COCOA || info.info.cocoa.window == nil) {
+    mac_log(@"level controls: no Cocoa window (%s)", SDL_GetError());
+    return;
+  }
+  nswindow = info.info.cocoa.window;
+  liblsdl2_mac_attach_window((__bridge void *)nswindow);
+}
+
+int liblsdl2_mac_wants_keys(void) {
+  return (controls != nil && [controls wantsKeys]) || liblsdl2_mac_form_wants_keys() || liblsdl2_mac_pause_wants_keys();
+}
+
+static Uint32 sheet_closed_at;
+
+void liblsdl2_mac_sheet_closed(void) {
+  sheet_closed_at = SDL_GetTicks();
+}
+
+int liblsdl2_mac_wants_key(uint32_t timestamp) {
+  return liblsdl2_mac_wants_keys() || (sheet_closed_at != 0 && timestamp <= sheet_closed_at);
+}
+
+/* The pack sheet walks the game through its own level and pack dialogs; they
+ * are hidden like every other form, and while that is going on the form sheet
+ * leaves them alone. */
+int liblsdl2_mac_pack_busy(void) {
+  return controls != nil && [controls busy];
+}
+
+/* For the pause menu. */
+void liblsdl2_mac_game_menu(const char *label) {
+  if (label) [controls sendGameMenu:[NSString stringWithUTF8String:label]];
+}
+
+void liblsdl2_mac_open_packs(void) {
+  [controls openPacks:nil];
+}
+
+const char *liblsdl2_mac_pack_title(void) {
+  return controls ? [controls gameTitle].UTF8String : "";
+}
+
+void liblsdl2_mac_screen_choose(int mode) {
+  [controls chooseScreen:mode];
+}
+
+void liblsdl2_mac_pause_changed(int paused) {
+  [controls pauseChanged:paused != 0];
+}
diff --git a/src/liblsdl2/liblsdl2_mac_form.m b/src/liblsdl2/liblsdl2_mac_form.m
new file mode 100644
index 0000000..1b40ed7
--- /dev/null
+++ b/src/liblsdl2/liblsdl2_mac_form.m
@@ -0,0 +1,1368 @@
+/* The game's menus and dialogs, drawn by the window instead of by the game.
+ *
+ * Bike or Die's own UI is Palm OS 5's, and none of it is drawn any more:
+ * bodui.c keeps every form off the screen and publishes what is on it. This
+ * is the other half -- the menu bar the game's own MBAR describes, and one
+ * sheet that can draw any of its twenty-five forms and the alerts it puts
+ * up, with real controls, and hand what is done to them back to the form.
+ *
+ * It is one renderer rather than twenty-five hand-written panels, and it is
+ * built out of what the form says about itself: its objects, their kinds and
+ * their places on it. A Palm form is laid out in absolute coordinates, so
+ * the objects that share a line on the Palm screen are the ones that belong
+ * together, and that is how the rows here are found -- by the geometry the
+ * game already has, not by a table of forms kept in step with it by hand. A
+ * form whose buttons are relabelled, or which the game has never shown here
+ * before, comes out right without anything being added.
+ *
+ * What the Palm objects become:
+ *
+ *     button, repeat           a push button; the form's default gets Return
+ *     check                    a checkbox
+ *     push (a group of them)   one segmented control
+ *     popup + its list         a pop-up button of the list's items
+ *     list on its own          a table, with Return on the default button
+ *     field                    a text field, given back when it is done
+ *     slider                   a slider
+ *     label, title             text; the title is the sheet's heading
+ *
+ * Everything is a command to bodui.c: press, value, select, text, close.
+ * Nothing here knows what any particular form means -- which is what keeps
+ * it working for the forms nobody thought about.
+ *
+ * It is walked with the keyboard, whether or not the system's own keyboard
+ * navigation is on (liblsdl2_mac_keys.m): the arrows move to the control that
+ * is that way on the sheet, Return or Space presses it, left and right change
+ * a pop-up, a segmented control or a slider, and Escape closes the dialog the
+ * way its Cancel would. A dialog opened from the pause menu goes back to it
+ * when it is dismissed (liblsdl2_mac_pause.m).
+ *
+ * All of it runs on the main thread, inside SDL's event pump, like the level
+ * controls next door: the timer that polls, the controls' actions, and the
+ * sheet itself.
+ */
+
+#import <Cocoa/Cocoa.h>
+
+#include <string.h>
+#include <unistd.h>
+
+#include <SDL2/SDL.h>
+
+#include "liblsdl2_mac.h"
+#include "liblsdl2_mac_keys.h"
+
+#define POLL_FAST   0.12   /* seconds between looks while a dialog is up */
+#define POLL_IDLE   0.20   /* and otherwise: this is how fast one appears */
+#define SETTLE      0.45   /* how long a new dialog must stay up to be shown */
+#define EXPECTED    3.0    /* how long a dialog asked for on purpose is waited for */
+#define CHAIN_END   0.3    /* how long the game must have the screen back for a dialog to be over */
+
+/* the flags bodui.c publishes; 16, "drawn as a bitmap", is of no use here */
+#define BOD_VISIBLE    1
+#define BOD_ENABLED    2
+#define BOD_DEFAULT    4
+#define BOD_FOCUS      8
+
+static void form_log(NSString *format, ...) NS_FORMAT_FUNCTION(1, 2);
+
+static void form_log(NSString *format, ...) {
+  NSString *text;
+  va_list args;
+
+  va_start(args, format);
+  text = [[NSString alloc] initWithFormat:format arguments:args];
+  va_end(args);
+  liblsdl2_log(text.UTF8String);
+}
+
+/* ------------------------------------------------------- reaching bodui.c */
+
+static uint32_t (*ui_command)(const char *cmd);
+static uint32_t (*ui_taken)(void);
+static const char *(*ui_state)(void);
+static uint32_t (*ui_seq)(void);
+static const char *(*ui_menubar)(void);
+static uint32_t (*ui_menubar_seq)(void);
+
+static BOOL ui_ready(void) {
+  if (ui_command && ui_state && ui_seq) return YES;
+  ui_command = liblsdl2_mac_symbol("bod_ui_command");
+  ui_taken = liblsdl2_mac_symbol("bod_ui_taken");
+  ui_state = liblsdl2_mac_symbol("bod_ui_state");
+  ui_seq = liblsdl2_mac_symbol("bod_ui_seq");
+  ui_menubar = liblsdl2_mac_symbol("bod_ui_menubar");
+  ui_menubar_seq = liblsdl2_mac_symbol("bod_ui_menubar_seq");
+
+  return ui_command && ui_state && ui_seq;
+}
+
+/* The game keeps one command at a time, and one sent before the last was
+ * taken replaces it. So what is sent together goes as one, a line each --
+ * choosing an item and then pressing a button, say -- and what is sent after
+ * waits until the game has taken what went before, for a second at most. */
+static NSMutableArray<NSString *> *ui_queue;
+static uint32_t ui_sent;
+static NSTimeInterval ui_sent_at;
+static BOOL ui_flushing;
+
+static void ui_flush(void) {
+  NSString *command;
+
+  if (ui_taken && ui_taken() < ui_sent && NSDate.timeIntervalSinceReferenceDate - ui_sent_at < 1.0) {
+    bod_keys_after(0.015, ^{ ui_flush(); });
+    return;
+  }
+
+  command = [ui_queue componentsJoinedByString:@"\n"];
+  [ui_queue removeAllObjects];
+  ui_flushing = NO;
+  form_log(@"dialog: %@", [command stringByReplacingOccurrencesOfString:@"\n" withString:@"; "]);
+  ui_sent = ui_command(command.UTF8String);
+  ui_sent_at = NSDate.timeIntervalSinceReferenceDate;
+}
+
+static void ui_send(NSString *command) {
+  if (!ui_ready()) return;
+  if (ui_queue == nil) ui_queue = [NSMutableArray array];
+  [ui_queue addObject:command];
+  if (ui_flushing) return;
+  ui_flushing = YES;
+  bod_keys_after(0, ^{ ui_flush(); });
+}
+
+/* The published text, taken whole: the sequence number is odd while the
+ * game's thread is writing it and moves on when it is done, so a copy made
+ * under a write is noticed and made again. */
+static NSString *ui_read(const char *(*text)(void), uint32_t (*seq)(void), uint32_t *out) {
+  NSString *copy = nil;
+  uint32_t s1 = 0;
+  int tries;
+
+  if (text == NULL || seq == NULL) return nil;
+
+  for (tries = 0; tries < 50 && copy == nil; tries++) {
+    s1 = seq();
+    if ((s1 & 1) == 0) {
+      copy = [NSString stringWithUTF8String:text()];
+      if (seq() != s1) copy = nil;
+    }
+    if (copy == nil) usleep(100);
+  }
+  if (out) *out = s1;
+
+  return copy;
+}
