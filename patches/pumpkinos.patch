+  if (rgb444_map[key] == 0xFF) {
+    UInt8 r = (key >> 8) & 0x0F, g = (key >> 4) & 0x0F, b = key & 0x0F;
+    rgb444_map[key] = BmpRGBToIndex(r * 17, g * 17, b * 17, colorTable);
+  }
+  return rgb444_map[key];
+}
+
+static Boolean WinBlitBitmap8(win_module_t *module, BitmapType *bitmapP, WinHandle wh, RectangleType *srcRect, Coord wx, Coord wy,
+                              WinDrawOperation mode, Boolean text, UInt32 tc, UInt32 bc, Boolean blitDisplay, Coord x0, Coord y0) {
+  BitmapType *winBmp = WinGetBitmap(wh), *dispBmp = module->displayWindow->bitmapP;
+  ColorTableType *srcColorTable, *dstColorTable;
+  UInt8 *srcBits, *dstBits, *dispBits, map[256], *map8 = NULL;
+  UInt16 srcRow, dstRow, dispRow;
+  Coord sw, sh, dw, dh, dispW, dispH, i, j, sx, sy, dx, dy, cx1, cx2, cy1, cy2, minx, maxx, miny, maxy;
+  UInt32 tv = 0, depth, bg = 0;
+  Boolean transp, display, dirty;
+
+  if (mode != winPaint && mode != winOverlay && mode != winErase && mode != winMask && !(mode == winSwap && text)) return false;
+  depth = BmpGetBitDepth(bitmapP);
+  if (depth != 1 && depth != 8 && depth != 16) return false;
+  if (BmpGetCompressionType(bitmapP) != BitmapCompressionTypeNone) return false;
+  if (winBmp == NULL || dispBmp == NULL || BmpGetBitDepth(winBmp) != 8) return false;
+
+  dstColorTable = BmpGetColortable(winBmp);
+  if (dstColorTable && !CtbCompare(dstColorTable, WinGetColorTable(8))) return false;
+  dstColorTable = WinGetColorTable(8);
+
+  if (depth == 8) {
+    srcColorTable = BmpGetColortable(bitmapP);
+    if (srcColorTable && !CtbCompare(srcColorTable, dstColorTable)) {
+      RGBColorType rgb;
+      UInt16 n = CtbGetNumEntries(srcColorTable);
+      for (i = 0; i < 256; i++) {
+        if (i < n) { CtbGetEntry(srcColorTable, i, &rgb); map[i] = BmpRGBToIndex(rgb.r, rgb.g, rgb.b, dstColorTable); }
+        else map[i] = i;
+      }
+      map8 = map;
+    }
+  }
+
+  transp = BmpGetTransparentValue(bitmapP, &tv);
+  if (!transp && (mode == winMask || mode == winOverlay)) transp = true;
+  if (text && mode == winPaint) transp = false;
+  if (mode == winErase || mode == winMask) bg = WinGetBackColor();
+
+  srcBits = BmpGetBits(bitmapP);
+  dstBits = BmpGetBits(winBmp);
+  dispBits = BmpGetBits(dispBmp);
+  BmpGetDimensions(bitmapP, &sw, &sh, &srcRow);
+  BmpGetDimensions(winBmp, &dw, &dh, &dstRow);
+  BmpGetDimensions(dispBmp, &dispW, &dispH, &dispRow);
+  if (srcBits == NULL || dstBits == NULL) return false;
+
+  cx1 = wh->clippingBounds.left; cx2 = wh->clippingBounds.right;
+  cy1 = wh->clippingBounds.top;  cy2 = wh->clippingBounds.bottom;
+  if (cx1 < 0) cx1 = 0;
+  if (cy1 < 0) cy1 = 0;
+  if (cx2 >= dw) cx2 = dw - 1;
+  if (cy2 >= dh) cy2 = dh - 1;
+
+  display = wh == module->displayWindow || wh->bitmapP == dispBmp;
+#ifdef BOD_GBA
+  if (((UInt32)BmpGetBits(wh->bitmapP) >> 24) == 0x06) display = true;   /* drawn straight into VRAM */
+#endif
+  dirty = wh == module->activeWindow || display;
+  if (display) blitDisplay = false;
+  minx = miny = 0x7FFF; maxx = maxy = -1;
+
+  for (i = 0; i < srcRect->extent.y; i++) {
+    UInt8 *drow, *prow = NULL;
+    sy = srcRect->topLeft.y + i;
+    dy = wy + i;
+    if (sy < 0 || sy >= sh || dy < cy1 || dy > cy2) continue;
+    drow = dstBits + dy * dstRow;
+    if (blitDisplay && y0 + dy >= 0 && y0 + dy < dispH) prow = dispBits + (y0 + dy) * dispRow;
+    for (j = 0; j < srcRect->extent.x; j++) {
+      UInt32 sp, dp;
+      Boolean skip;
+      sx = srcRect->topLeft.x + j;
+      dx = wx + j;
+      if (sx < 0 || sx >= sw || dx < cx1 || dx > cx2) continue;
+      switch (depth) {
+        case 1:
+          sp = (srcBits[sy * srcRow + (sx >> 3)] >> (7 - (sx & 7))) & 1;
+          dp = sp ? tc : bc;
+          break;
+        case 8:
+          sp = srcBits[sy * srcRow + sx];
+          dp = map8 ? map8[sp] : sp;
+          break;
+        default:
+          sp = srcBits[sy * srcRow + sx * 2] | (srcBits[sy * srcRow + sx * 2 + 1] << 8);
+          if (!BmpGetLittleEndianBits(bitmapP)) sp = ((sp & 0xFF) << 8) | (sp >> 8);
+          dp = index_from_565((UInt16)sp, dstColorTable);
+          break;
+      }
+      skip = transp && sp == tv;
+      switch (mode) {
+        case winErase: if (!skip) continue; dp = bg; break;
+        case winMask:  if (skip) continue; dp = bg; break;
+        default:       if (skip) continue; break;
+      }
+      bod_put8(drow, dx, (UInt8)dp);
+      if (prow && x0 + dx >= 0 && x0 + dx < dispW) bod_put8(prow, x0 + dx, (UInt8)dp);
+      if (dx < minx) minx = dx;
+      if (dx > maxx) maxx = dx;
+      if (dy < miny) miny = dy;
+      if (dy > maxy) maxy = dy;
+    }
+  }
+
+  if (dirty && maxx >= minx && maxy >= miny) WinDirtyRegion(wh, minx, miny, maxx, maxy);
+  return true;
+}
