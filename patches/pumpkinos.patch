+    /* Batch size trades handoff cost against how far execution overshoots the
+     * interpreted region. Overshooting is harmless for correctness (uARM runs
+     * recompiled regions fine) but blurs range bisection, so BOD_ARM_BATCH=1
+     * gives exact range semantics. */
+    if (state->armp->armRun(state->arm, rarm_batch(), rarm_call_addr, call68K_func, rarm_ret_addr)) {
+      rarm_from_uarm(state, S);
+      S->halt = 1;
+      S->result = S->r[0];
+      return 1;
+    }
+    pc = state->armp->armGetReg(state->arm, 15);
+    for (n = 1; n < 5; n++) {
+      if (rarm_segsize[n] && pc >= rarm_segbase[n] && pc < rarm_segbase[n] + rarm_segsize[n] &&
+          rarm_blob_recompiled(n)) {
+        rarm_from_uarm(state, S);
+        return 0;
+      }
+    }
+    if (emupalmos_finished()) { rarm_from_uarm(state, S); S->halt = 1; return 1; }
+    if (++guard > 200000) {
+      rarm_panic(S, pc, "interpreter did not return to recompiled code");
+      return 1;
+    }
+  }
+}
+
+int rarm_resolve(uint32_t pc) {
+  uint8_t *ram = pumpkin_heap_base();
+  MemHandle h;
+  uint8_t *p;
+  int n;
+
+  for (n = 1; n < 5; n++) {
+    if (rarm_segsize[n]) continue;
+    if ((h = DmGet1Resource('armc', n)) == NULL) continue;
+    if ((p = MemHandleLock(h)) != NULL) {
+      rarm_segbase[n] = (uint32_t)(p - ram);
+      rarm_segsize[n] = MemHandleSize(h);
+      debug(DEBUG_INFO, "ARM", "recomp: armc %d at 0x%08X size 0x%X",
+            n, rarm_segbase[n], rarm_segsize[n]);
+    }
+  }
+  for (n = 1; n < 5; n++)
+    if (rarm_segsize[n] && pc >= rarm_segbase[n] && pc < rarm_segbase[n] + rarm_segsize[n])
+      return 0;
+  return -1;
+}
+
+int rarm_escape(rarm_state *S, uint32_t target) {
+  if (target >= 0x04000000) {
+    /* PACE syscall: the address encodes the group and function number. */
+    uint32_t group = (target & 0x00F00000) >> 20;
+    uint32_t function = target & 0xFFFF;
+    uint32_t lr = S->r[14];
+    S->r[0] = emupalmos_arm_syscall(group, function, S->r[0], S->r[1], S->r[2], S->r[3], S->r[13]);
+    S->r[14] = lr;
+    S->r[15] = lr;
+    return emupalmos_finished() ? 1 : 0;
+  }
+  if (target == rarm_ret_addr) {
+    S->halt = 1;
+    S->result = S->r[0];
+    return 1;
+  }
+  if (target == rarm_call_addr) {
+    S->r[0] = call68K_func(S->r[0], S->r[1], S->r[2], S->r[3]);
+    S->r[15] = S->r[14];
+    return emupalmos_finished() ? 1 : 0;
+  }
+  rarm_panic(S, target, "branch outside the recompiled armc blobs");
+  return 1;
+}
+
+/* Tracing mode. Restoring the Palm heap between two in-process replays is not
+ * sound (PumpkinOS keeps host-side state alongside it), so instead each engine
+ * is traced in its own process run and the traces are diffed offline:
+ *   BOD_ARM_ENGINE=interp|recomp   which core executes PceNativeCall
+ *   BOD_ARM_TRACE=<n>              trace the first n calls to /tmp/bod_trace_<engine>.txt
+ * BOD_ARM_DETTIME=1 freezes the clock so both runs stay comparable. */
+static int rarm_diff_enabled(void) {
+  static int v = 0;
+  if (!v) { char *e = sys_getenv("BOD_ARM_TRACE"); v = (e && e[0] && e[0] != '0') ? 1 : -1; }
+  return v > 0;
+}
+
+static int rarm_use_interp(void) {
+  static int v = 0;
+  if (!v) {
+    char *e = sys_getenv("BOD_ARM_ENGINE");
+    v = (e && !sys_strcmp(e, "interp")) ? 1 : -1;
+  }
+  return v > 0;
+}
+
+static uint32_t rarm_diff_call(uint32_t code, uint32_t userData) {
+  static uint32_t seq = 0;
+  static int opened = 0;
+  uint32_t max;
+  char *e = sys_getenv("BOD_ARM_TRACE");
+  uint32_t r;
+
+  max = e ? (uint32_t)sys_atoi(e) : 1;
+  seq++;
+  { extern int rarm_deterministic_time;
+    char *d = sys_getenv("BOD_ARM_DETTIME");
+    rarm_deterministic_time = (d && d[0] && d[0] != '0'); }
+
+  if (seq <= max && !opened && sys_getenv("BOD_ARM_TRACEFILE")) {
+    rarm_trace_open(rarm_use_interp() ? "/tmp/bod_trace_interp.txt"
+                                      : "/tmp/bod_trace_recomp.txt", 1500000);
+    opened = 1;
+  }
+  if (seq > max && opened) { rarm_trace_close(); opened = 0; }
+
+  {
+    static int dual = 0;
+    if (!dual) { char *e = sys_getenv("BOD_ARM_DUAL"); dual = (e && e[0] && e[0] != '0') ? 1 : -1; }
+    if (dual > 0) {
+      /* Run the call under both engines from the same entry state and report
+       * disagreement. Both entries set up r0-r2/sp/lr/r9 themselves, so the
+       * inputs are identical; the recompiled pass runs first and the
+       * interpreted result is the one handed back, keeping the game correct. */
+      uint32_t rr = rarm_native_call_pce(code, userData);
+      uint32_t ri = arm_native_call_pce_interp(code, userData);
+      if (rr != ri) {
+        debug(DEBUG_ERROR, "ARM", "DUAL mismatch call #%u code=0x%08X recomp=0x%08X interp=0x%08X",
+              seq, code, rr, ri);
+      }
+      r = ri;
+    } else {
+      r = rarm_use_interp() ? arm_native_call_pce_interp(code, userData)
+                            : rarm_native_call_pce(code, userData);
+    }
+  }
+  debug(DEBUG_INFO, "ARM", "trace call #%u code=0x%08X r0=0x%08X (%s)",
+        seq, code, r, rarm_use_interp() ? "interp" : "recomp");
+  return r;
+}
+
+static uint32_t rarm_native_call_pce(uint32_t code, uint32_t userData) {
+  emu_state_t *state = pumpkin_get_local_storage(emu_key);
+  static int ring_mode = 0;
+  if (!ring_mode) {
+    char *e = sys_getenv("BOD_ARM_RING");
+    ring_mode = (e && e[0] && e[0] != '0') ? 1 : -1;
+    if (ring_mode > 0) rarm_tracing = 1;
+  }
+  uint8_t *ram = pumpkin_heap_base();
+  /* The ARM register file persists between calls, exactly as it does for the
+   * interpreted CPU; only the entry registers are set up each time. */
+  static rarm_state S;
+  uint32_t sysAddr;
+
+  S.halt = 0;
+  rarm_ram = ram;
+  rarm_ramsize = pumpkin_heap_size();
+  rarm_resolve(code);
+  sysAddr = (uint8_t *)state->systable - ram;
+  rarm_ret_addr  = state->armReturnAddr - ram;
+  rarm_call_addr = state->armCall68KAddr - ram;
+
+  S.r[9]  = sysAddr + 16;                       /* PACE syscall master table */
+  S.r[15] = code;
+  S.r[14] = rarm_ret_addr;
+  S.r[13] = (uint32_t)(state->armStack - ram) + stackSize;
+  S.r[0]  = (uint32_t)(state->armEmulState - ram);
+  S.r[1]  = userData;
+  S.r[2]  = rarm_call_addr;
+
+  rarm_run(&S);
+  return S.r[0];
+}
+
+/* The sound mixer is `armc` code too, but the sound layer reaches it through
+ * SndStreamCreate's ARM callback instead of PceNativeCall, so it used to be the
+ * one entry point left on the interpreter. It is called from the application
+ * thread for every buffer the stream needs, and interpreting it cost about a
+ * quarter of that thread: the 44.1 kHz stream ran dry whenever a frame took a
+ * little longer, which is what made the audio choppy. Run it recompiled like
+ * everything else. */
+static uint32_t rarm_call_sub(uint32_t code, uint32_t p0, uint32_t p1, uint32_t p2, uint32_t p3) {
+  emu_state_t *state = pumpkin_get_local_storage(emu_key);
+  uint8_t *ram = pumpkin_heap_base();
+  /* Its own register file, mirroring the separate CPU the interpreter keeps
+   * for this state; only the entry registers are set up on each call. */
+  static rarm_state S;
+  uint32_t saveRet, saveCall, sysAddr;
+
+  rarm_ram = ram;
+  rarm_ramsize = pumpkin_heap_size();
+  sysAddr = (uint8_t *)state->systable - ram;
+  put4l(sysAddr, ram, sysAddr + 16);
+  put4l(sysAddr + 16, ram, sysAddr + 2052);
+
+  /* The return and call-68K stubs belong to this state, not to the one the
+   * application thread runs its PceNativeCalls on. */
+  saveRet = rarm_ret_addr;
+  saveCall = rarm_call_addr;
+  rarm_ret_addr  = state->armReturnAddr - ram;
+  rarm_call_addr = state->armCall68KAddr - ram;
+
+  S.halt  = 0;
+  S.r[9]  = sysAddr + 16;                       /* PACE syscall master table */
+  S.r[15] = code;
+  S.r[14] = rarm_ret_addr;
+  S.r[13] = (uint32_t)(state->armStack - ram) + stackSize;
+  S.r[0]  = p0;
+  S.r[1]  = p1;
+  S.r[2]  = p2;
+  S.r[3]  = p3;
+
+  rarm_run(&S);
+
+  rarm_ret_addr = saveRet;
+  rarm_call_addr = saveCall;
+
+  return S.r[0];
+}
+
+/* ... unless the recompiled cores are switched off, or the callback does not
+ * live in an armc resource, in which case the interpreter still handles it. */
+static int rarm_snd_recompiled(uint32_t code) {
+  static uint32_t reported = 0;
+  int n;
+
+  if (!r68k_enabled() || rarm_use_interp()) return 0;
+  if (rarm_resolve(code) != 0) return 0;
+
+  if (reported != code) {
+    reported = code;
+    for (n = 1; n < 5; n++) {
+      if (rarm_segsize[n] && code >= rarm_segbase[n] && code < rarm_segbase[n] + rarm_segsize[n]) {
+        debug(DEBUG_INFO, "ARM", "recomp: sound callback 0x%08X is armc %d + 0x%X",
+              code, n, code - rarm_segbase[n]);
+        break;
+      }
+    }
+  }
+
+  return 1;
+}
+
 void emupalmos_disasm(int m68k, int arm) {
   emu_state_t *state = pumpkin_get_local_storage(emu_key);
   logtrap_disasm(state->lt, m68k);
