+  // Two single-pixel frames just outside the object rather than one two-pixel
+  // one: a ring that thin against a button's own frame is easy to miss.
+  for (i = 1; i <= 2; i++) {
+    rect.topLeft.x = rP->topLeft.x - i;
+    rect.topLeft.y = rP->topLeft.y - i;
+    rect.extent.x  = rP->extent.x + 2 * i;
+    rect.extent.y  = rP->extent.y + 2 * i;
