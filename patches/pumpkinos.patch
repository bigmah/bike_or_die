+#include <PalmOS.h>
+
+#include "sys.h"
+#include "pumpkin.h"
+#include "bodpack.h"
+#include "debug.h"
+
+/* Driving Bike or Die's level pack chooser from outside the game.
+ *
+ * The game keeps its packs behind three of its own dialogs: Game -> Select
+ * Level opens the level list (form 1200), "More..." on that opens the pack
+ * list (form 1201), and Select on that switches the pack and comes back to
+ * the level list. Nothing here replaces any of it -- the game's code is what
+ * decides which pack is which and what switching means. This walks the same
+ * dialogs the way a pen would, and reads the pack names off the same list
+ * the pen would pick from, so that a page (or anything else on the host) can
+ * offer the packs in a control of its own and hand the choice back.
+ *
+ * It runs as a state machine on the application's thread, in two hooks: one
+ * called when the event queue is empty (EvtGetEvent), one when a form has
+ * just been drawn (FrmDrawForm). Requests arrive from the host on some other
+ * thread through bod_pack_command(); the answer is a status text the host
+ * reads back with bod_pack_state(). Commands:
+ *
+ *   open        walk to the pack list and read the names; the dialog is left
+ *               up, waiting for one of the next two
+ *   pick N      choose pack N of that list, then press "Play this level" on
+ *               the level list that comes back
+ *   cancel      close the pack list and the level list behind it
+ *   menu LABEL  pick an item of the game's Game menu by its label, e.g.
+ *               "Next Level" -- only while the game itself is on screen
+ *
+ * The names are read the only way they can be: the list draws its items
+ * through a callback in the game's own code, so each item is drawn once into
+ * an offscreen window with WinDrawChars watched (bod_pack_capture).
+ *
+ * The status text is lines. The first is one of "idle", "busy", "listed",
+ * "done", "error <why>"; the second is "title <text>", the title the level
+ * list last had, which names the pack the game is on; and after "listed"
+ * come the pack names, one per line, in the order the game lists them, which
+ * is what "pick N" counts. Text is UTF-8, converted from the game's Latin-1.
+ */
+
+#define PK_FORM_LEVELS   1200
+#define PK_FORM_PACKS    1201
+#define PK_FORM_GAME     1001
+#define PK_LIST          10
+#define PK_MENU_BAR      1000
+#define PK_MORE          "More..."
+#define PK_SELECT        "Select"
+#define PK_CANCEL        "Cancel"
+#define PK_PLAY          "Play this level"
+#define PK_SELECT_LEVEL  "Select Level"
+
+#define PK_MAX_NAMES     512
+#define PK_NAME_LEN      48
+#define PK_CMD_LEN       64
+#define PK_TIMEOUT_US    8000000
+
+enum {
+  PK_IDLE = 0,
+  PK_OPENING,        /* asked for the level list; waiting for it to draw */
+  PK_WAIT_PACKS,     /* pressed More...; waiting for the pack list to draw */
+  PK_LISTED,         /* the pack list is up and its names are read */
+  PK_PICKED,         /* pressed Select; waiting for the level list to come back */
+  PK_CANCELLED,      /* pressed Cancel on the packs; waiting for the level list */
+  PK_DONE,
+  PK_ERROR
+};
+
+/* Shared with the host's thread. A command is a string and a sequence
+ * number; the host writes the string and then bumps the number, this side
+ * sees the number and then reads the string. The status goes the other way
+ * with a number of its own, which is odd while the text is being written and
+ * moves on when it is done, so a torn read can be noticed and repeated. */
+static char pk_cmd[PK_CMD_LEN];
+static volatile uint32_t pk_cmd_seq;
+static uint32_t pk_cmd_seen;
+
+static char pk_status[PK_MAX_NAMES * (PK_NAME_LEN * 2) + 256];
+static volatile uint32_t pk_status_seq;
+
+static int pk_state;
+static int64_t pk_deadline;
+static char pk_error[64];
+static char pk_title[64];
+
+static char pk_names[PK_MAX_NAMES][PK_NAME_LEN];
+static int pk_count;
+
+/* WinDrawChars hands its text here while an item is being drawn. */
+volatile int bod_pack_capturing;
+static int pk_capture_item;
+
+/* ------------------------------------------------------------ the host side */
+
+void bod_pack_command(const char *cmd) {
+  if (cmd == NULL) return;
+  sys_strncpy(pk_cmd, cmd, PK_CMD_LEN - 1);
+  pk_cmd[PK_CMD_LEN - 1] = 0;
+  __atomic_add_fetch(&pk_cmd_seq, 1, __ATOMIC_RELEASE);
+}
+
+const char *bod_pack_state(void) {
+  return pk_status;
+}
+
+uint32_t bod_pack_seq(void) {
+  return __atomic_load_n(&pk_status_seq, __ATOMIC_ACQUIRE);
+}
+
+/* ------------------------------------------------------------- the status */
+
+/* Latin-1 to UTF-8, `max` bytes of output including the terminator. */
+static int pk_utf8(char *out, int max, const char *s) {
+  int n = 0;
+  unsigned char c;
+
+  for (; *s && n < max - 3; s++) {
+    c = (unsigned char)*s;
+    if (c == '\n' || c == '\r') c = ' ';
+    if (c < 0x80) {
+      out[n++] = c;
+    } else {
+      out[n++] = 0xC0 | (c >> 6);
+      out[n++] = 0x80 | (c & 0x3F);
+    }
+  }
+  out[n] = 0;
+
+  return n;
+}
+
+static void pk_publish(void) {
+  const char *word;
+  int i, n = 0;
+
+  switch (pk_state) {
+    case PK_IDLE:   word = "idle";   break;
+    case PK_LISTED: word = "listed"; break;
+    case PK_DONE:   word = "done";   break;
+    case PK_ERROR:  word = "error";  break;
+    default:        word = "busy";   break;
+  }
+
+  /* Odd from here until the text is complete. */
+  __atomic_add_fetch(&pk_status_seq, 1, __ATOMIC_RELEASE);
+
+  n += sys_snprintf(pk_status + n, sizeof(pk_status) - n, "%s%s%s\ntitle ", word,
+                    pk_state == PK_ERROR ? " " : "", pk_state == PK_ERROR ? pk_error : "");
+  n += pk_utf8(pk_status + n, sizeof(pk_status) - n, pk_title);
+  n += sys_snprintf(pk_status + n, sizeof(pk_status) - n, "\n");
+
+  if (pk_state == PK_LISTED) {
+    for (i = 0; i < pk_count && n < (int)sizeof(pk_status) - PK_NAME_LEN * 2 - 2; i++) {
+      n += pk_utf8(pk_status + n, sizeof(pk_status) - n, pk_names[i]);
+      n += sys_snprintf(pk_status + n, sizeof(pk_status) - n, "\n");
+    }
+  }
+
+  __atomic_add_fetch(&pk_status_seq, 1, __ATOMIC_RELEASE);
+}
+
+static void pk_set(int state) {
+  pk_state = state;
+  pk_deadline = sys_get_clock() + PK_TIMEOUT_US;
+  pk_publish();
+}
+
+static void pk_fail(const char *why) {
+  debug(DEBUG_INFO, "BOD", "pack chooser: %s", why);
+  sys_strncpy(pk_error, why, sizeof(pk_error) - 1);
+  pk_set(PK_ERROR);
+}
+
+/* --------------------------------------------------------------- the game */
+
+/* The first visible button on the form with this label, or NULL. */
+static const ControlType *pk_button(const FormType *formP, const char *label) {
+  const ControlType *ctl;
+  const Char *s;
+  UInt16 i, n;
+
+  n = FrmGetNumberOfObjects(formP);
+  for (i = 0; i < n; i++) {
+    if (FrmGetObjectType(formP, i) != frmControlObj) continue;
+    ctl = (const ControlType *)FrmGetObjectPtr(formP, i);
+    if (ctl == NULL || !ctl->attr.visible) continue;
+    s = CtlGetLabel(ctl);
+    if (s && !sys_strcmp(s, label)) return ctl;
+  }
+
+  return NULL;
+}
+
+static ListType *pk_list(const FormType *formP, UInt16 id) {
+  UInt16 index = FrmGetObjectIndex(formP, id);
+
+  if (index == frmInvalidObjectId || FrmGetObjectType(formP, index) != frmListObj) return NULL;
+
+  return (ListType *)FrmGetObjectPtr(formP, index);
+}
+
+/* Presses a button the way CtlHitControl does: the game sees a ctlSelectEvent
+ * for it, which is all it looks at. */
+static Boolean pk_press(const FormType *formP, const char *label) {
+  const ControlType *ctl = pk_button(formP, label);
+
+  if (ctl == NULL) return false;
+  CtlHitControl(ctl);
+
+  return true;
+}
+
+/* The item id of the Game menu entry with this label. The bar is the game's
+ * MBAR resource, which the resource loader has already decoded into the
+ * structure the menu code uses. */
+static UInt16 pk_menu_item(const char *label) {
+  MenuBarType *mbar;
+  MemHandle h;
+  UInt16 id = 0;
+  int i, j;
+
+  if ((h = DmGetResource(MenuRscType, PK_MENU_BAR)) == NULL) return 0;
+  if ((mbar = MemHandleLock(h)) != NULL) {
+    for (i = 0; i < mbar->numMenus && !id; i++) {
+      for (j = 0; j < mbar->menus[i].numItems; j++) {
+        if (mbar->menus[i].items[j].itemStr && !sys_strcmp(mbar->menus[i].items[j].itemStr, label)) {
+          id = mbar->menus[i].items[j].id;
+          break;
+        }
+      }
+    }
+    MemHandleUnlock(h);
+  }
+  DmReleaseResource(h);
+
+  return id;
+}
+
+/* Whether the game itself, and not one of its dialogs or its menu, has the
+ * screen -- the only time a menu item can be picked for it. */
+static Boolean pk_game_on_top(void) {
+  MenuBarType *menu = MenuGetActiveMenu();
+
+  if (FrmGetActiveFormID() != PK_FORM_GAME) return false;
+  if (menu && menu->attr.visible) return false;
+
+  return true;
+}
+
+static Boolean pk_pick_menu(const char *label) {
+  EventType ev;
+  UInt16 id;
+
+  if ((id = pk_menu_item(label)) == 0) return false;
+
+  MemSet(&ev, sizeof(EventType), 0);
+  ev.eType = menuEvent;
+  ev.data.menu.itemID = id;
+  EvtAddEventToQueue(&ev);
+
+  return true;
+}
+
+/* The names in the pack list, read by drawing each item where nobody can see
+ * it and keeping what the game's draw function writes. */
+void bod_pack_capture(const UInt8 *chars, Int16 len) {
+  char *name;
+  int n, i;
+
+  if (pk_capture_item < 0 || pk_capture_item >= PK_MAX_NAMES) return;
+  name = pk_names[pk_capture_item];
+  n = sys_strlen(name);
+  if (n && n < PK_NAME_LEN - 1) name[n++] = ' ';
+  for (i = 0; i < len && n < PK_NAME_LEN - 1; i++) name[n++] = chars[i];
+  name[n] = 0;
+}
+
+static Boolean pk_read_names(ListType *list) {
+  WinHandle off, old;
+  RectangleType rect;
+  FontID font;
+  Int16 dy;
+  UInt16 err;
+  int i;
+
+  if (list == NULL || list->numItems <= 0) return false;
+  if (list->m68k_drawfunc == 0 && list->drawItemsCallback == NULL) return false;
+
+  font = FntSetFont(list->font);
+  dy = FntCharHeight();
+  FntSetFont(font);
+
+  if ((off = WinCreateOffscreenWindow(list->bounds.extent.x, dy, nativeFormat, &err)) == NULL) return false;
+  old = WinSetDrawWindow(off);
+
+  pk_count = list->numItems < PK_MAX_NAMES ? list->numItems : PK_MAX_NAMES;
+  for (i = 0; i < pk_count; i++) {
+    pk_names[i][0] = 0;
+    RctSetRectangle(&rect, 1, 0, list->bounds.extent.x - 2, dy);
+    pk_capture_item = i;
+    bod_pack_capturing = 1;
+    if (list->m68k_drawfunc) {
+      CallListDrawItem(list->m68k_drawfunc, i, &rect, list->itemsText);
+    } else {
+      list->drawItemsCallback(i, &rect, list->itemsText);
+    }
+    bod_pack_capturing = 0;
+    pk_capture_item = -1;
+    /* Nothing drawn is still an item; give it a name the host can show. */
+    if (pk_names[i][0] == 0) sys_snprintf(pk_names[i], PK_NAME_LEN, "(pack %d)", i + 1);
+  }
+
+  WinSetDrawWindow(old);
+  WinDeleteWindow(off, false);
+  FntSetFont(font);
+
+  debug(DEBUG_INFO, "BOD", "pack chooser: read %d pack names", pk_count);
+
+  return true;
+}
+
+/* ---------------------------------------------------------- the two hooks */
+
+/* Take the host's command, if there is a new one. */
+static void pk_take_command(void) {
+  uint32_t seq = __atomic_load_n(&pk_cmd_seq, __ATOMIC_ACQUIRE);
+  FormType *formP;
+  ListType *list;
+  char cmd[PK_CMD_LEN];
+  int n;
+
+  if (seq == pk_cmd_seen) return;
+  pk_cmd_seen = seq;
+  sys_strncpy(cmd, pk_cmd, PK_CMD_LEN - 1);
+  cmd[PK_CMD_LEN - 1] = 0;
+  debug(DEBUG_INFO, "BOD", "pack chooser: command \"%s\"", cmd);
+
+  if (!sys_strcmp(cmd, "open")) {
+    switch (FrmGetActiveFormID()) {
+      case PK_FORM_PACKS:
+        /* Already there: read it as if it had just been drawn. */
+        formP = FrmGetActiveForm();
+        if (pk_read_names(pk_list(formP, PK_LIST))) pk_set(PK_LISTED);
+        else pk_fail("the pack list is empty");
+        break;
+      case PK_FORM_LEVELS:
+        formP = FrmGetActiveForm();
+        if (pk_press(formP, PK_MORE)) pk_set(PK_WAIT_PACKS);
+        else pk_fail("no More... button on the level list");
+        break;
+      default:
+        if (!pk_game_on_top()) { pk_fail("close the dialog on the screen first"); break; }
+        if (pk_pick_menu(PK_SELECT_LEVEL)) pk_set(PK_OPENING);
+        else pk_fail("no Select Level in the menu");
+        break;
+    }
+
+  } else if (!sys_strncmp(cmd, "pick ", 5)) {
+    n = sys_atoi(cmd + 5);
+    if (pk_state != PK_LISTED || FrmGetActiveFormID() != PK_FORM_PACKS) { pk_fail("the pack list is not open"); return; }
+    formP = FrmGetActiveForm();
+    if ((list = pk_list(formP, PK_LIST)) == NULL || n < 0 || n >= list->numItems) { pk_fail("no such pack"); return; }
+    LstSetSelection(list, n);
+    LstMakeItemVisible(list, n);
+    LstDrawList(list);
+    if (pk_press(formP, PK_SELECT)) pk_set(PK_PICKED);
+    else pk_fail("no Select button on the pack list");
+
+  } else if (!sys_strcmp(cmd, "cancel")) {
+    switch (FrmGetActiveFormID()) {
+      case PK_FORM_PACKS:
+        if (pk_press(FrmGetActiveForm(), PK_CANCEL)) pk_set(PK_CANCELLED);
+        else pk_fail("no Cancel button on the pack list");
+        break;
+      case PK_FORM_LEVELS:
+        if (pk_press(FrmGetActiveForm(), PK_CANCEL)) pk_set(PK_DONE);
+        else pk_fail("no Cancel button on the level list");
+        break;
+      default:
+        pk_set(PK_IDLE);
+        break;
+    }
+
+  } else if (!sys_strncmp(cmd, "menu ", 5)) {
+    if (!pk_game_on_top()) { pk_fail("close the dialog on the screen first"); return; }
+    if (pk_pick_menu(cmd + 5)) pk_set(PK_DONE);
+    else pk_fail("no such menu item");
+
+  } else {
+    pk_fail("unknown command");
+  }
+}
+
+void bod_pack_idle(void) {
+  pk_take_command();
+
+  switch (pk_state) {
+    case PK_OPENING:
+    case PK_WAIT_PACKS:
+    case PK_PICKED:
+    case PK_CANCELLED:
+      if (sys_get_clock() > pk_deadline) pk_fail("the game did not answer");
+      break;
+    case PK_LISTED:
+      /* The dialog can go away under the host -- an Escape, say. */
+      if (FrmGetActiveFormID() != PK_FORM_PACKS) pk_set(PK_IDLE);
+      break;
+    default:
+      break;
+  }
+}
+
+/* A dialog other than the one being waited for. The game has a question of
+ * its own -- whether to keep recordings on the card, say -- and the host's
+ * panel is in front of it, so the walk ends here and the panel comes down;
+ * the player answers the game and goes on from there. */
+static Boolean pk_interrupted(const FormType *formP, UInt16 expected) {
+  if (formP->formId == expected) return false;
+  if (!formP->window.windowFlags.modal) return true;   /* not a dialog: keep waiting */
+  debug(DEBUG_INFO, "BOD", "pack chooser: form %d came up instead of %d", formP->formId, expected);
+  pk_set(PK_DONE);
+  return true;
+}
+
+void bod_pack_form_drawn(FormType *formP) {
+  const Char *title;
+
+  if (formP == NULL) return;
+
+  if (formP->formId == PK_FORM_LEVELS) {
+    if ((title = FrmGetTitle(formP)) != NULL) {
+      sys_strncpy(pk_title, title, sizeof(pk_title) - 1);
+    }
+  }
+
+  switch (pk_state) {
+    case PK_OPENING:
+      if (pk_interrupted(formP, PK_FORM_LEVELS)) break;
+      if (pk_press(formP, PK_MORE)) pk_set(PK_WAIT_PACKS);
+      else pk_fail("no More... button on the level list");
+      break;
+
+    case PK_WAIT_PACKS:
+      if (pk_interrupted(formP, PK_FORM_PACKS)) break;
+      if (pk_read_names(pk_list(formP, PK_LIST))) pk_set(PK_LISTED);
+      else pk_fail("the pack list is empty");
+      break;
+
+    case PK_PICKED:
+      /* The level list of the new pack. Start it playing. */
+      if (pk_interrupted(formP, PK_FORM_LEVELS)) break;
+      if (pk_press(formP, PK_PLAY)) pk_set(PK_DONE);
+      else pk_fail("no Play button on the level list");
+      break;
+
+    case PK_CANCELLED:
+      if (pk_interrupted(formP, PK_FORM_LEVELS)) break;
+      if (pk_press(formP, PK_CANCEL)) pk_set(PK_DONE);
+      else pk_fail("no Cancel button on the level list");
+      break;
+
+    default:
+      /* The title alone may have changed; say so. */
+      if (formP->formId == PK_FORM_LEVELS) pk_publish();
+      break;
+  }
+}
diff --git a/src/libpumpkin/bodpack.h b/src/libpumpkin/bodpack.h
new file mode 100644
