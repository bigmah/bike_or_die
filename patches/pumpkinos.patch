+/* -------------------------------------------------------------- five-way nav
+ *
+ * Keyboard navigation of forms, the way a Palm OS 5 device does it with its
+ * 5-way navigator: a focus ring steps through the form's objects and "select"
+ * acts on the one it is on. The keys arrive through NavKeyAction (navkeys.h).
+ *
+ * The order comes from the form's own 'fnav' resource when it has one -- that
+ * is what applications that support the navigator ship one per form for -- and
+ * from the objects' top-to-bottom, left-to-right geometry when it does not, so
+ * every dialog is navigable either way.
+ *
+ * Only modal forms take part. Those are the dialogs and menus; a full-screen
+ * form belongs to the application, which may well want the arrow keys itself.
+ *
+ * Selecting is a synthesised tap at the middle of the object, so it goes down
+ * exactly the path the pen does and needs nothing from the application. The
+ * ring is an inverted frame, which makes taking it down the same operation as
+ * putting it up and leaves no saved bits to get out of step with the screen.
+ */
+
+#define navFormRscType  'fnav'          // Palm OS 5.2 form navigation order
+#define navSkipFlag     0x0001          // kFrmNavObjectFlagsSkip
+#define navNoFocus      (-1)
+#define navMaxStops     128
+
+// The objects the ring can land on, and where they are. The rectangle is the
+// one the object's own handler hit-tests pen events against, so the ring is
+// drawn from exactly the coordinates a synthesised tap has to aim at.
+
+static Boolean FrmNavObject(const FormType *formP, Int16 index, RectangleType *rP) {
+  FormObjectType obj;
+
+  if (formP == NULL || index < 0 || index >= formP->numObjects) return false;
+  obj = formP->objects[index].object;
+
+  switch (formP->objects[index].objectType) {
+    case frmControlObj:
+      if (!obj.control->attr.usable || !obj.control->attr.enabled) return false;
+      if (rP) MemMove(rP, &obj.control->bounds, sizeof(RectangleType));
+      return true;
+    case frmListObj:
+      // A popup list is not a stop of its own: it belongs to the trigger that
+      // shows it, and only exists on screen while it is popped up.
+      if (obj.list->bitsBehind) return false;
+      if (!obj.list->attr.usable || !obj.list->attr.visible) return false;
+      if (rP) MemMove(rP, &obj.list->bounds, sizeof(RectangleType));
+      return true;
+    case frmFieldObj:
+      if (!obj.field->attr.usable || !obj.field->attr.editable) return false;
+      if (rP) MemMove(rP, &obj.field->rect, sizeof(RectangleType));
+      return true;
+    case frmTableObj:
+      if (rP) MemMove(rP, &obj.table->bounds, sizeof(RectangleType));
+      return true;
+    case frmGadgetObj:
+      if (!obj.gadget->attr.usable) return false;
+      if (!obj.gadget->handler && !obj.gadget->m68k_handler) return false;
+      if (rP) MemMove(rP, &obj.gadget->rect, sizeof(RectangleType));
+      return true;
+    default:
+      // Labels, bitmaps, titles, scroll bars: nothing happens when they are
+      // tapped, or the arrow keys already do their job.
+      return false;
+  }
+}
+
+static Boolean FrmNavEnabled(const FormType *formP) {
+  return formP != NULL && formP->window.windowFlags.modal;
+}
+
+// Decode the form's 'fnav' resource, whose id is the form's own. Called once,
+// when the form is created; freed with the form.
+
+static void FrmNavInit(FormType *formP) {
+  MemHandle h;
+  UInt8 *p;
+  UInt16 version, count, hdrSize, elemSize, initial;
+  UInt32 size, flags;
+  int i, j;
+
+  formP->navOrder = NULL;
+  formP->navCount = 0;
+  formP->navInitial = 0;
+  formP->navFocus = navNoFocus;
+  formP->navDrawn = 0;
+
+  if (formP->formId == 0) return;
+  if ((h = DmGetResource(navFormRscType, formP->formId)) == NULL) return;
+
+  if ((p = MemHandleLock(h)) != NULL) {
+    size = MemHandleSize(h);
+    i = 0;
+    i += get2b(&version, p, i);
+    i += get2b(&count, p, i);
+    i += get2b(&hdrSize, p, i);
+    i += get2b(&elemSize, p, i);
+    i += get4b(&flags, p, i);       // start state; the ring waits for a key here
+    i += get2b(&initial, p, i);
+
+    if (version == 1 && count > 0 && count <= navMaxStops && elemSize >= 8 &&
+        hdrSize + (UInt32)count * elemSize <= size) {
+      formP->navOrder = xcalloc(count, sizeof(struct FrmNavOrder));
+      formP->navCount = count;
+      formP->navInitial = initial;
+      for (j = 0; j < count; j++) {
+        i = hdrSize + j * elemSize;
+        i += get2b(&formP->navOrder[j].id, p, i);
+        i += get2b(&formP->navOrder[j].flags, p, i);
+        i += get2b(&formP->navOrder[j].above, p, i);
+        i += get2b(&formP->navOrder[j].below, p, i);
+      }
+      debug(DEBUG_TRACE, "Form", "FrmNav form %d: navigation order of %d objects", formP->formId, count);
+    } else {
+      debug(DEBUG_ERROR, "Form", "FrmNav form %d: unusable 'fnav' (version %d, %d objects, %u bytes)",
+        formP->formId, version, count, size);
+    }
+    MemHandleUnlock(h);
+  }
+
+  DmReleaseResource(h);
+}
+
+static void FrmNavFinish(FormType *formP) {
+  if (formP && formP->navOrder) {
+    xfree(formP->navOrder);
+    formP->navOrder = NULL;
+    formP->navCount = 0;
+  }
+}
+
+// The form's stops, in the order the ring walks them: the navigation order's
+// own, or reading order when the form has none. Objects that are not stops
+// right now -- a hidden list, a disabled button -- are left out.
+
+static Int16 FrmNavStops(const FormType *formP, Int16 *stop, Int16 max) {
+  RectangleType r, s;
+  Int16 n = 0, i, j, k;
+  UInt16 index;
+
+  MemSet(&s, sizeof(RectangleType), 0);
+
+  if (formP->navOrder) {
+    for (i = 0; i < formP->navCount && n < max; i++) {
+      if (formP->navOrder[i].flags & navSkipFlag) continue;
+      index = FrmGetObjectIndex(formP, formP->navOrder[i].id);
+      if (index == frmInvalidObjectId) continue;
+      if (!FrmNavObject(formP, index, NULL)) continue;
+      stop[n++] = index;
+    }
+    if (n > 0) return n;
+    // The order named nothing that is on screen: fall through to geometry.
+  }
+
+  for (i = 0; i < formP->numObjects && n < max; i++) {
+    if (!FrmNavObject(formP, i, &r)) continue;
+    for (j = 0; j < n; j++) {
+      FrmNavObject(formP, stop[j], &s);
+      if (r.topLeft.y < s.topLeft.y ||
+          (r.topLeft.y == s.topLeft.y && r.topLeft.x < s.topLeft.x)) break;
+    }
+    for (k = n; k > j; k--) stop[k] = stop[k-1];
+    stop[j] = i;
+    n++;
+  }
+
+  return n;
+}
+
+// Where the ring goes when it first appears: what the resource asks for, else
+// the first stop.
+
+static Int16 FrmNavFirst(const FormType *formP) {
+  Int16 stop[navMaxStops], n, i;
+  UInt16 index;
+
+  if ((n = FrmNavStops(formP, stop, navMaxStops)) == 0) return navNoFocus;
+
+  if (formP->navInitial) {
+    index = FrmGetObjectIndex(formP, formP->navInitial);
+    for (i = 0; i < n; i++) {
+      if (stop[i] == (Int16)index) return stop[i];
+    }
+  }
+
+  return stop[0];
+}
+
+static Int16 FrmNavStep(const FormType *formP, int dir) {
+  Int16 stop[navMaxStops], n, i, cur = -1;
+
+  if ((n = FrmNavStops(formP, stop, navMaxStops)) == 0) return navNoFocus;
+
+  for (i = 0; i < n; i++) {
+    if (stop[i] == formP->navFocus) cur = i;
+  }
+  if (cur == -1) return (dir > 0) ? stop[0] : stop[n-1];
+
+  return stop[(cur + dir + n) % n];
+}
+
+// Put the ring up or take it down. Inverting a frame is its own inverse, so
+// both are the same drawing; navDrawn says which of the two it is doing.
+
+static void FrmNavInvert(FormType *formP, const RectangleType *rP) {
+  RectangleType rect;
+  WinHandle olda, oldd;
+  int i;
+
+  olda = WinGetActiveWindow();
+  WinSetActiveWindow(FrmGetWindowHandle(formP));
+  oldd = WinSetDrawWindow(FrmGetWindowHandle(formP));
+
+  // Two single-pixel frames just outside the object rather than one two-pixel
+  // one: a ring that thin against a button's own frame is easy to miss.
+  for (i = 1; i <= 2; i++) {
+    rect.topLeft.x = rP->topLeft.x - i;
+    rect.topLeft.y = rP->topLeft.y - i;
+    rect.extent.x  = rP->extent.x + 2 * i;
+    rect.extent.y  = rP->extent.y + 2 * i;
+    WinInvertRectangleFrame(simpleFrame, &rect);
+  }
+
+  WinSetDrawWindow(oldd);
+  WinSetActiveWindow(olda);
+}
+
+static void FrmNavHide(FormType *formP) {
+  if (formP && formP->navDrawn) {
+    // Erase from the rectangle it was drawn at: the object may have resized
+    // since -- a popup trigger relabelled from its list, say.
+    FrmNavInvert(formP, &formP->navRect);
+    formP->navDrawn = 0;
+  }
+}
+
+static void FrmNavShow(FormType *formP) {
+  RectangleType rect;
+
+  if (formP && !formP->navDrawn && formP->navFocus != navNoFocus && formP->attr.visible) {
+    if (!FrmNavObject(formP, formP->navFocus, &rect)) return;
+    MemMove(&formP->navRect, &rect, sizeof(RectangleType));
+    FrmNavInvert(formP, &rect);
+    formP->navDrawn = 1;
+  }
+}
+
+// For the object drawing routines, which repaint over the ring. They are given
+// the active form because that is the only one with a ring on it.
+
+void FrmNavRingHide(void) {
+  FormType *formP = FrmGetActiveForm();
+
+  // Inside FrmDrawForm the whole form is being repainted; it puts the ring back
+  // itself when it is done.
+  if (formP && !formP->attr.drawing) FrmNavHide(formP);
+}
+
+void FrmNavRingShow(void) {
+  FormType *formP = FrmGetActiveForm();
+
+  if (formP && !formP->attr.drawing) FrmNavShow(formP);
+}
+
+static void FrmNavSetFocus(FormType *formP, Int16 index) {
+  if (index == navNoFocus || index == formP->navFocus) return;
+
+  FrmNavHide(formP);
+  formP->navFocus = index;
+  // A field with the ring on it also takes the insertion point, so that typing
+  // goes where the ring is.
+  if (formP->objects[index].objectType == frmFieldObj) {
+    FrmSetFocus(formP, index);
+  } else if (FldGetActiveField() != NULL) {
+    FrmReleaseFocus(formP);
+    FldSetActiveField(NULL);
+  }
+  FrmNavShow(formP);
+}
+
+// Act on the object the ring is on, by tapping it where the pen would.
+//
+// The press is delivered now and the release is left pending: a real release
+// only arrives once the application has worked through everything the press
+// put in the queue, and objects rely on that order -- a button is drawn pressed
+// by the enter event and drawn unpressed again by the release, and a release
+// that overtook the enter event would leave it stuck down.
+
+static void FrmNavTap(FormType *formP, Coord x, Coord y) {
+  frm_module_t *module = (frm_module_t *)pumpkin_get_local_storage(frm_key);
+  EventType event;
+
+  if (module == NULL) return;
+
+  MemSet(&event, sizeof(EventType), 0);
+  event.eType = penDownEvent;
+  event.screenX = x;
+  event.screenY = y;
+  event.penDown = true;
+  if (!FrmDispatchEventInternal(formP, &event)) {
+    FrmHandleEvent(formP, &event);
+  }
+
+  module->navTapPending = true;
+  module->navTapX = x;
+  module->navTapY = y;
+}
+
+// Called from EvtGetEvent once the queue has drained. Returns true if it put
+// anything in it.
+
+Boolean FrmNavFinishTap(void) {
+  frm_module_t *module = (frm_module_t *)pumpkin_get_local_storage(frm_key);
+  EventType event;
+  Coord x, y;
+
+  if (module == NULL || !module->navTapPending) return false;
+  module->navTapPending = false;
+  x = module->navTapX;
+  y = module->navTapY;
+
+  // The object that took the press is told about the release directly, and the
+  // form still sees the event afterwards. Exactly what a lifted pen does.
+  FrmTrackPenUp(x, y);
+
+  MemSet(&event, sizeof(EventType), 0);
+  event.eType = penUpEvent;
+  event.screenX = x;
+  event.screenY = y;
+  event.data.penUp.start.x = x;
+  event.data.penUp.start.y = y;
+  event.data.penUp.end.x = x;
+  event.data.penUp.end.y = y;
+  EvtAddEventToQueue(&event);
+
+  FrmNavShow(FrmGetActiveForm());
+
+  return true;
+}
+
+static Boolean FrmNavSelect(FormType *formP) {
+  RectangleType rect;
+  ListType *list;
+  Int16 index, row;
+  UInt16 objIndex;
+
+  index = formP->navFocus;
+
+  // Before the ring has been shown, and on a field -- which takes text, not
+  // presses -- select means the form's default button, the way Enter does in
+  // any other dialog.
+  if (index != navNoFocus && formP->objects[index].objectType == frmFieldObj) {
+    index = navNoFocus;
+  }
+  if (index == navNoFocus) {
+    if (formP->defaultButton == 0) return false;
+    objIndex = FrmGetObjectIndex(formP, formP->defaultButton);
+    if (objIndex == frmInvalidObjectId) return false;
+    index = objIndex;
+  }
+
+  if (!FrmNavObject(formP, index, &rect)) return false;
+
+  // Aim at the middle of the object, except in a list, where the row the
+  // selection is on is the thing being tapped.
+  row = rect.topLeft.y + rect.extent.y / 2;
+  if (formP->objects[index].objectType == frmListObj) {
+    list = formP->objects[index].object.list;
+    if (list->visibleItems > 0 && list->currentItem != noListSelection) {
+      row = rect.topLeft.y +
+            (list->currentItem - list->topItem) * (rect.extent.y / list->visibleItems) +
+            (rect.extent.y / list->visibleItems) / 2;
+    }
+  }
+
+  FrmNavHide(formP);
+  FrmNavTap(formP, rect.topLeft.x + rect.extent.x / 2, row);
+
+  return true;
+}
+
+// Up and down inside a list move its selection, and step out of the list at
+// its ends. Returns false when the key should move the ring instead.
+
+static Boolean FrmNavList(FormType *formP, int dir) {
+  ListType *list;
+  Int16 sel;
+
+  if (formP->navFocus == navNoFocus) return false;
+  if (formP->objects[formP->navFocus].objectType != frmListObj) return false;
+
+  list = formP->objects[formP->navFocus].object.list;
+  if (list->numItems <= 0) return false;
+
+  sel = list->currentItem;
+  if (sel == noListSelection) {
+    sel = (dir > 0) ? 0 : list->numItems - 1;
+  } else {
+    sel += dir;
+    if (sel < 0 || sel >= list->numItems) return false;   // out of the list
+  }
+
+  FrmNavHide(formP);
+  LstSetSelection(list, sel);
+  LstMakeItemVisible(list, sel);
+  LstDrawList(list);
+  FrmNavShow(formP);
+
+  return true;
+}
+
+// While a list is popped up it has the keyboard to itself: the trigger that
+// opened it is waiting inside LstPopupList for a selection or a dismissal.
+
+static Boolean FrmNavPopup(FormType *formP, NavKeyType nav) {
+  EventType event;
+  ListType *list;
+  Int16 sel;
+
+  if (formP->activeList < 0 || formP->activeList >= formP->numObjects) return false;
+  if (formP->objects[formP->activeList].objectType != frmListObj) return false;
+  list = formP->objects[formP->activeList].object.list;
+
+  switch (nav) {
+    case navKeyUp:
+    case navKeyDown:
+      if (list->numItems <= 0) return true;
+      sel = list->currentItem;
+      if (sel == noListSelection) {
+        sel = 0;
+      } else {
+        sel += (nav == navKeyDown) ? 1 : -1;
+        if (sel < 0) sel = list->numItems - 1;
+        if (sel >= list->numItems) sel = 0;
+      }
+      LstSetSelection(list, sel);
+      LstMakeItemVisible(list, sel);
+      LstDrawList(list);
+      return true;
+
+    case navKeySelect:
+      MemSet(&event, sizeof(EventType), 0);
+      sel = (list->currentItem == noListSelection) ? 0 : list->currentItem;
+      if (list->controlID) {
+        event.eType = popSelectEvent;
+        event.data.popSelect.listID = list->id;
+        event.data.popSelect.listP = list;
+        event.data.popSelect.selection = sel;
+        event.data.popSelect.priorSelection = list->currentItem;
+        event.data.popSelect.controlID = list->controlID;
+        event.data.popSelect.controlP = FrmGetObjectPtr(formP, FrmGetObjectIndex(formP, list->controlID));
+      } else {
+        event.eType = lstSelectEvent;
+        event.data.lstSelect.listID = list->id;
+        event.data.lstSelect.pList = list;
+        event.data.lstSelect.selection = sel;
+      }
+      list->currentItem = sel;
+      EvtAddEventToQueue(&event);
+      return true;
+
+    case navKeyCancel:
+    case navKeyLeft:
+      MemSet(&event, sizeof(EventType), 0);
+      event.eType = lstExitEvent;
+      event.data.lstExit.listID = list->id;
+      event.data.lstExit.pList = list;
+      EvtAddEventToQueue(&event);
+      return true;
+
+    default:
+      return false;
+  }
+}
+
+// The whole of it, called from EvtGetEvent before the application sees the
+// key. Returns true when the key was a navigator action this form dealt with.
+
+Boolean FrmNavHandleKey(FormType *formP, const EventType *eventP) {
+  NavKeyType nav;
+  int dir;
+
+  if (!FrmNavEnabled(formP)) return false;
+  if ((nav = NavKeyAction(eventP)) == navKeyNone) return false;
+
+  if (formP->activeList != -1) {
+    return FrmNavPopup(formP, nav);
+  }
+
+  // Space is a character wherever text is being entered.
+  if (nav == navKeySelect && eventP->data.keyDown.chr == ' ' && FldGetActiveField() != NULL) {
+    return false;
+  }
+
+  switch (nav) {
+    case navKeyUp:
+    case navKeyDown:
+      dir = (nav == navKeyDown) ? 1 : -1;
+      if (formP->navFocus == navNoFocus) {
+        FrmNavSetFocus(formP, FrmNavFirst(formP));
+      } else if (!FrmNavList(formP, dir)) {
+        FrmNavSetFocus(formP, FrmNavStep(formP, dir));
+      }
+      return true;
+
+    case navKeyLeft:
+    case navKeyRight:
+      if (formP->navFocus == navNoFocus) {
+        FrmNavSetFocus(formP, FrmNavFirst(formP));
+      } else {
