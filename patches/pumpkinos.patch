+/* Answer the registration dialog on the way in, and take it back down.
+ *
+ * Bike or Die keeps its registration in its own application database, which
+ * PumpkinOS opens read-only -- so a code entered by hand is accepted, unlocks
+ * the game for that session, and is forgotten the moment the process goes.
+ * Rather than remember it, enter it again every time: the game validates it
+ * against the HotSync user name exactly as it does a typed one, so the dialog
+ * is answered before anyone sees it.
+ *
+ * Answering it leaves it up: the game redraws the same form as its "registered
+ * to" thank-you, which somebody then has to close before the game starts. So
+ * that button is pressed too, on the redraw, and the game comes up in play
+ * rather than behind a dialog nobody asked for. Only that one redraw is
+ * touched -- the About dialog opened deliberately from the menu later on
+ * behaves normally.
+ *
+ * The dialog is found by what it is rather than by a resource id: the one form
+ * that has a text field and a button labelled "Unlock", which afterwards has a
+ * button labelled "Close" and no "Unlock". Once the game is registered that
+ * button is gone, so this stops matching on its own; a code the game refuses
+ * leaves "Unlock" where it was, which is the signal to stop and leave the
+ * dialog alone.
+ *
+ * BOD_UNLOCK is the code (default 44652, which is the one for the HotSync name
+ * the port uses); BOD_UNLOCK=0 leaves the dialog alone.
+ */
+#define BOD_UNLOCK_BUTTON "Unlock"
+#define BOD_UNLOCK_CLOSE  "Close"
+
+/* The first button on the form showing `label`, or NULL. Visibility matters:
+ * the dialog is one form throughout, whose buttons are hidden and relabelled
+ * in place -- registering hides "Unlock" where it stands and turns "Continue
+ * in trial mode" into "Close". */
+static const ControlType *bod_button(FormType *formP, const char *label) {
+  const ControlType *ctl;
+  const Char *s;
+  UInt16 i, n;
+
+  n = FrmGetNumberOfObjects(formP);
+  for (i = 0; i < n; i++) {
+    if (FrmGetObjectType(formP, i) != frmControlObj) continue;
+    ctl = (const ControlType *)FrmGetObjectPtr(formP, i);
+    if (ctl == NULL || !ctl->attr.visible) continue;
+    s = CtlGetLabel(ctl);
+    if (s && !sys_strcmp(s, label)) return ctl;
+  }
+
+  return NULL;
+}
+
+static void bod_auto_unlock(FormType *formP) {
+  static int state = 0;         /* 0 looking for it, 1 answered, 2 finished */
+  static UInt16 answered = 0;
+  static int redraws = 0;
+  const ControlType *ctl;
+  FieldType *fld = NULL;
+  UInt16 i, n, fldIndex = 0;
+  char *code;
+
+  if (state == 2 || formP == NULL) return;
+
+  /* Waiting for the answer to take. The dialog is drawn again before the game
+   * has read the button press, and once more after: the one to close is the
+   * one offering "Close" and no longer offering "Unlock". A code the game
+   * refuses never produces it, so give up after a few and leave the dialog to
+   * whoever is looking at it. */
+  if (state == 1) {
+    if (formP->formId != answered) return;
+    if (++redraws > 8) {
+      debug(DEBUG_INFO, "Form", "the registration dialog did not take the code; leaving it up");
+      state = 2;
+      return;
+    }
+    if (bod_button(formP, BOD_UNLOCK_BUTTON)) return;
+    if ((ctl = bod_button(formP, BOD_UNLOCK_CLOSE)) == NULL) return;
+    debug(DEBUG_INFO, "Form", "closing the registration dialog");
+    state = 2;
+    CtlHitControl(ctl);
+    return;
+  }
+
+  code = sys_getenv("BOD_UNLOCK");
+  if (code == NULL) code = "44652";
+  if (code[0] == 0 || (code[0] == '0' && code[1] == 0)) {
+    state = 2;
+    return;
+  }
+
+  n = FrmGetNumberOfObjects(formP);
+  for (i = 0; i < n && fld == NULL; i++) {
+    if (FrmGetObjectType(formP, i) == frmFieldObj) {
+      fld = (FieldType *)FrmGetObjectPtr(formP, i);
+      fldIndex = i;
+    }
+  }
+
+  if (fld == NULL || (ctl = bod_button(formP, BOD_UNLOCK_BUTTON)) == NULL) return;
+
+  debug(DEBUG_INFO, "Form", "answering the registration dialog with \"%s\"", code);
+  state = 1;
+  answered = formP->formId;
+  FrmSetFocus(formP, fldIndex);
+  FldDelete(fld, 0, FldGetTextLength(fld));
+  FldInsert(fld, code, sys_strlen(code));
+  CtlHitControl(ctl);
+  /* Give the focus back, or the field's caret is left blinking over whatever
+   * the dialog redraws itself as. */
+  FrmSetFocus(formP, noFocus);
+}
