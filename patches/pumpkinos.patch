+#ifndef LIBLSDL2_WEB_H
+#define LIBLSDL2_WEB_H
+
+/* The browser's present path: the frame is handed to the page rather than
+ * pushed through SDL. See liblsdl2_web.c for why. */
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+int  web_canvas_wanted(void);
+int  web_canvas_init(int width, int height, int xfactor, int yfactor);
+void web_canvas_finish(void);
+void web_canvas_blit565(uint8_t *src, int src_width, int src_height, int sx, int sy, int w, int h, int dx, int dy);
+void web_canvas_fill(uint32_t rgba);
+void web_canvas_publish(void);
+int  web_canvas_due(int64_t interval);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/src/libos/libos.c b/src/libos/libos.c
index 3490278..0b2211d 100644
--- a/src/libos/libos.c
+++ b/src/libos/libos.c
@@ -88,10 +88,34 @@ static int LoopIteration(libos_t *data, uint32_t dt) {
 }
 
 #if defined(EMSCRIPTEN)
+/* Defined by the Emscripten shell (src/emscripten/main.c), which owns the
+ * writable filesystem; absent in any other Emscripten build. */
+extern void bod_flush_saves(void) __attribute__((weak));
+
+/* How often the loop turns, in turns a second.
+ *
+ * Zero here asks Emscripten for requestAnimationFrame, which on a worker --
+ * where there is none -- it imitates with a setTimeout aimed at sixty a
+ * second. Two things are wrong with that for this loop. It is the loop that
+ * copies the screen to the display, and sixty turns a second free-running
+ * against a display refreshing sixty times a second beat: a turn that lands a
+ * hair early finds no refresh to answer and the frame waits for the next one,
+ * which is thirty-three milliseconds after the one before. And it takes one
+ * input event per turn, so sixty turns a second is also the ceiling on how
+ * fast the keyboard and the pen are read.
+ *
+ * Turning several times per refresh fixes both: the pacing is then the
+ * display's own (pumpkin_refresh_due), and what the turns in between cost is a
+ * mutex and a look at an empty event queue, since the gate is shut and nothing
+ * is drawn. setTimeout will not go below about four milliseconds once it is
+ * nested, so this is a ceiling rather than a rate.
+ */
+#define LOOP_HZ 250
+
 static void set_main_loop(void (*callback)(void *), void *data) {
   emscripten_cancel_main_loop();
   if (callback) {
-    emscripten_set_main_loop_arg(callback, data, 0, 1);
+    emscripten_set_main_loop_arg(callback, data, LOOP_HZ, 1);
   }
 }
 
@@ -126,13 +150,10 @@ static void callback(void *_data) {
     thread_close();
     debug_close();
 
-    // call cexit after IndexedDB is saved
-    EM_ASM(
-      FS.syncfs(false, function (err) {
-        console.log('save IndexedDB');
-        ccall('cexit', 'v');
-      });
-    );
+    // The application writes its settings on the way out, so the copy the
+    // browser keeps is brought up to date before the runtime goes.
+    if (bod_flush_saves) bod_flush_saves();
+    cexit();
   }
 }
 #endif
@@ -146,8 +167,14 @@ static void EventLoop(libos_t *data) {
   request.code = sysAppLaunchCmdNormalLaunch;
   request.opendb = 1;
 #if defined(EMSCRIPTEN)
-  extern UInt32 LauncherPilotMain(UInt16 cmd, MemPtr cmdPBP, UInt16 launchFlags);
-  request.pilot_main = LauncherPilotMain;
+  // Nothing is loaded from a dlib resource in this build -- everything is
+  // linked in -- so the built-in Launcher is called directly. A Palm OS
+  // application has no native PilotMain to call at all and must reach the
+  // emulator, which only happens when this is left unset.
+  if (!sys_strcmp(data->launcher, "Launcher")) {
+    extern UInt32 LauncherPilotMain(UInt16 cmd, MemPtr cmdPBP, UInt16 launchFlags);
+    request.pilot_main = LauncherPilotMain;
+  }
