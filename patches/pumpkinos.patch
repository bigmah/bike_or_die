index 0000000..0f730ee
--- /dev/null
+++ b/src/libwtest/libwtest.c
@@ -0,0 +1,419 @@
+/* Headless window driver for automated testing.
+ *
+ * Keeps the composed framebuffer in memory, writes periodic PPM snapshots, and
+ * feeds input from a plain-text script, so the game can be exercised without a
+ * visible window and without synthesising system-wide mouse/keyboard events.
+ *
+ *   BOD_TEST_OUT     directory for frames         (default /tmp/bodtest)
+ *   BOD_TEST_SCRIPT  input script
+ *   BOD_TEST_PERIOD  ms between snapshots         (default 500)
+ *
+ * Script grammar, one action per line:
+ *   wait <ms>              let the game run
+ *   key <code>             key down + up
+ *   keydown <code> / keyup <code>
+ *   pen <x> <y>            pointer motion
+ *   tap <x> <y>            pointer down + up
+ *   shot <label>           snapshot now, named
+ */
+
+#include "sys.h"
+#include "script.h"
+#include "thread.h"
+#include "pwindow.h"
+#include "audio.h"
+#include "debug.h"
+#include "xalloc.h"
+
+#define MAX_ACTIONS 512
+
+typedef struct {
+  int op;                 /* see OP_ below */
+  int a, b;
+  char label[32];
+} action_t;
+
+enum { OP_WAIT = 1, OP_KEYDOWN, OP_KEYUP, OP_PEN, OP_TAPDOWN, OP_TAPUP, OP_SHOT };
+
+typedef struct {
+  int width, height, spixel;
+  uint16_t *buf;
+  int x, y, buttons;
+  action_t act[MAX_ACTIONS];
+  int nact, cur;
+  int64_t resume_at;      /* microseconds */
+  int64_t next_shot;
+  int period;
+  uint32_t frame;
+  char out[256];
+} libwtest_window_t;
+
+struct texture_t {
+  int width, height;
+  uint8_t *buf;
+};
+
+static window_provider_t window_provider;
+
+/* ---------------------------------------------------------------- audio
+ * Writes whatever the sound layer produces to <BOD_TEST_OUT>/audio.raw, so a
+ * headless run can be checked for actual samples instead of guessing. */
+static audio_provider_t audio_provider;
+static int (*wt_getaudio)(void *buffer, int len, void *data);
+static void *wt_audio_data;
+static int wt_rate = 44100, wt_channels = 1, wt_pcm;
+static int wt_audio_fd = -1;
+static int64_t wt_audio_next;
+static uint32_t wt_audio_bytes;
+
+static void wt_audio_open(void) {
+  char path[320];
+  char *e = sys_getenv("BOD_TEST_OUT");
+  if (wt_audio_fd >= 0) return;
+  sys_snprintf(path, sizeof(path) - 1, "%s/audio.raw", (e && e[0]) ? e : "/tmp/bodtest");
+  wt_audio_fd = sys_create(path, SYS_WRITE | SYS_TRUNC, 0644);
+  debug(DEBUG_INFO, "WTEST", "audio -> %s (fd %d)", path, wt_audio_fd);
+}
+
+static int wt_audio_init(int pcm, int channels, int rate) {
+  wt_pcm = pcm; wt_channels = channels ? channels : 1; wt_rate = rate ? rate : 44100;
+  debug(DEBUG_INFO, "WTEST", "audio init pcm=%d channels=%d rate=%d", pcm, channels, rate);
+  wt_audio_open();
+  return 1;
+}
+static int wt_audio_finish(int handle) { return 0; }
+static audio_t wt_audio_create(int pcm, int channels, int rate, void *data) {
+  wt_pcm = pcm; wt_channels = channels ? channels : 1; wt_rate = rate ? rate : 44100;
+  debug(DEBUG_INFO, "WTEST", "audio create pcm=%d channels=%d rate=%d", pcm, channels, rate);
+  wt_audio_open();
+  return 1;
+}
+static int wt_audio_start(int handle, audio_t audio,
+                          int (*getaudio)(void *buffer, int len, void *data), void *data) {
+  wt_getaudio = getaudio;
+  wt_audio_data = data;
+  wt_audio_next = sys_get_clock();
+  debug(DEBUG_INFO, "WTEST", "audio stream started");
+  return 0;
+}
+static int wt_audio_play(audio_t audio, uint8_t *raw, int len) {
+  wt_audio_open();
+  if (wt_audio_fd >= 0 && raw && len > 0) { sys_write(wt_audio_fd, raw, len); wt_audio_bytes += len; }
+  return 0;
+}
+static int wt_audio_destroy(audio_t audio) { wt_getaudio = NULL; return 0; }
+static int wt_mixer_init(void) { return 0; }
+static int wt_mixer_play(uint8_t *buf, uint32_t len, int volume) {
+  debug(DEBUG_INFO, "WTEST", "mixer play %u bytes volume %d", len, volume);
+  return 0;
+}
+static int wt_mixer_stop(void) { return 0; }
+
+/* Pump the stream callback from the main loop, paced by the sample rate. */
+static void wt_audio_pump(void) {
+  static uint8_t buf[8192];
+  int64_t now, due;
+  int want, got;
+
+  if (!wt_getaudio || wt_audio_fd < 0) return;
+  now = sys_get_clock();
+  if (now < wt_audio_next) return;
+  due = now - wt_audio_next;
+  if (due > 200000) due = 200000;                 /* cap catch-up */
+  want = (int)((due * wt_rate / 1000000) * wt_channels * 2);
+  if (want <= 0) want = wt_channels * 2;
+  if (want > (int)sizeof(buf)) want = sizeof(buf);
+  got = wt_getaudio(buf, want, wt_audio_data);
+  if (got > 0) { sys_write(wt_audio_fd, buf, got); wt_audio_bytes += got; }
+  wt_audio_next = now;
+}
+
+
+/* ---------------------------------------------------------------- snapshots */
+
+static void snapshot(libwtest_window_t *window, const char *label) {
+  char path[320], hdr[64];
+  int fd, i, n;
+  uint8_t *rgb;
+
+  if (label && label[0])
+    sys_snprintf(path, sizeof(path) - 1, "%s/%s.ppm", window->out, label);
+  else
+    sys_snprintf(path, sizeof(path) - 1, "%s/f%05u.ppm", window->out, window->frame);
+  window->frame++;
+
+  if ((fd = sys_create(path, SYS_WRITE | SYS_TRUNC, 0644)) < 0) return;
+  n = sys_snprintf(hdr, sizeof(hdr) - 1, "P6\n%d %d\n255\n", window->width, window->height);
+  sys_write(fd, (uint8_t *)hdr, n);
+
+  if ((rgb = xmalloc(window->width * window->height * 3)) != NULL) {
+    for (i = 0; i < window->width * window->height; i++) {
+      uint16_t p = window->buf[i];          /* RGB565 */
+      rgb[i*3+0] = ((p >> 11) & 0x1F) << 3;
+      rgb[i*3+1] = ((p >>  5) & 0x3F) << 2;
+      rgb[i*3+2] = ( p        & 0x1F) << 3;
+    }
+    sys_write(fd, rgb, window->width * window->height * 3);
+    xfree(rgb);
+  }
+  sys_close(fd);
+}
+
+/* ------------------------------------------------------------------- script */
+
+static int keyname(const char *s) {
+  if (!sys_strcmp(s, "up"))    return WINDOW_KEY_UP;
+  if (!sys_strcmp(s, "down"))  return WINDOW_KEY_DOWN;
+  if (!sys_strcmp(s, "left"))  return WINDOW_KEY_LEFT;
+  if (!sys_strcmp(s, "right")) return WINDOW_KEY_RIGHT;
+  if (s[0] && !s[1]) return s[0];
+  return sys_atoi(s);
+}
+
+static void load_script(libwtest_window_t *window, const char *path) {
+  char line[256], w0[64], w1[64], w2[64];
+  int fd, n, len = 0;
+  uint8_t c;
+
+  if ((fd = sys_open(path, SYS_READ)) < 0) {
+    debug(DEBUG_ERROR, "WTEST", "cannot open script \"%s\"", path);
+    return;
+  }
+  for (;;) {
+    n = sys_read(fd, &c, 1);
+    if (n == 1 && c != '\n' && len < (int)sizeof(line) - 1) { line[len++] = c; continue; }
+    line[len] = 0;
+    if (len && line[0] != '#') {
+      action_t *a = &window->act[window->nact];
+      w0[0] = w1[0] = w2[0] = 0;
+      sys_sscanf(line, "%63s %63s %63s", w0, w1, w2);
+      a->op = 0;
+      if      (!sys_strcmp(w0, "wait"))    { a->op = OP_WAIT;    a->a = sys_atoi(w1); }
+      else if (!sys_strcmp(w0, "key"))     { a->op = OP_KEYDOWN; a->a = keyname(w1); a->b = 1; }
+      else if (!sys_strcmp(w0, "keydown")) { a->op = OP_KEYDOWN; a->a = keyname(w1); }
+      else if (!sys_strcmp(w0, "keyup"))   { a->op = OP_KEYUP;   a->a = keyname(w1); }
+      else if (!sys_strcmp(w0, "pen"))     { a->op = OP_PEN;     a->a = sys_atoi(w1); a->b = sys_atoi(w2); }
+      else if (!sys_strcmp(w0, "tap")) {
+        /* a tap needs a motion first: the button handler uses the last
+         * reported pen position, not the button event's own coordinates */
+        a->op = OP_PEN; a->a = sys_atoi(w1); a->b = sys_atoi(w2);
+        if (window->nact < MAX_ACTIONS - 3) {
+          window->nact++;
+          a = &window->act[window->nact];
+          a->op = OP_TAPDOWN; a->a = sys_atoi(w1); a->b = sys_atoi(w2);
+        }
+      }
+      else if (!sys_strcmp(w0, "shot"))    { a->op = OP_SHOT;    sys_strncpy(a->label, w1, sizeof(a->label)-1); }
+      if (a->op && window->nact < MAX_ACTIONS - 2) window->nact++;
+    }
+    len = 0;
+    if (n != 1) break;
+  }
+  sys_close(fd);
+  debug(DEBUG_INFO, "WTEST", "loaded %d actions from %s", window->nact, path);
+}
+
+/* -------------------------------------------------------------- provider */
+
+static window_t *libwtest_create(int encoding, int *width, int *height, int xfactor, int yfactor,
+                                 int rotate, int fullscreen, int software, char *driver, void *data) {
+  libwtest_window_t *window;
+  char *e;
+
+  if ((window = xcalloc(1, sizeof(libwtest_window_t))) == NULL) return NULL;
+  window->width = *width;
+  window->height = *height;
+  window->spixel = sizeof(uint16_t);
+  window->buf = xcalloc(window->width * window->height, window->spixel);
+  e = sys_getenv("BOD_TEST_OUT");
+  sys_strncpy(window->out, (e && e[0]) ? e : "/tmp/bodtest", sizeof(window->out) - 1);
+  e = sys_getenv("BOD_TEST_PERIOD");
+  window->period = (e && e[0]) ? sys_atoi(e) : 500;
+  e = sys_getenv("BOD_TEST_SCRIPT");
+  if (e && e[0]) load_script(window, e);
+  window->next_shot = sys_get_clock() + (int64_t)window->period * 1000;
+  debug(DEBUG_INFO, "WTEST", "headless %dx%d, frames in %s", window->width, window->height, window->out);
+  return (window_t *)window;
+}
+
+static int libwtest_destroy(window_t *_window) {
+  libwtest_window_t *window = (libwtest_window_t *)_window;
+  if (window) {
+    snapshot(window, "final");
+    if (window->buf) xfree(window->buf);
+    xfree(window);
+  }
+  return 0;
+}
+
+static int libwtest_render(window_t *_window) { return 0; }
+
+static texture_t *libwtest_create_texture(window_t *_window, int width, int height) {
+  libwtest_window_t *window = (libwtest_window_t *)_window;
+  texture_t *texture;
+  if (!window) return NULL;
+  if ((texture = xcalloc(1, sizeof(texture_t))) == NULL) return NULL;
+  texture->width = width;
+  texture->height = height;
+  if ((texture->buf = xcalloc(width * height, window->spixel)) == NULL) { xfree(texture); return NULL; }
+  return texture;
+}
+
+static int libwtest_destroy_texture(window_t *_window, texture_t *texture) {
+  if (texture) { if (texture->buf) xfree(texture->buf); xfree(texture); }
+  return 0;
+}
+
+static int libwtest_update_texture(window_t *_window, texture_t *texture, uint8_t *raw) {
+  if (texture) sys_memcpy(texture->buf, raw, texture->width * texture->height * sizeof(uint16_t));
+  return 0;
+}
+
+static int libwtest_update_texture_rect(window_t *_window, texture_t *texture, uint8_t *src,
+                                        int tx, int ty, int w, int h) {
+  libwtest_window_t *window = (libwtest_window_t *)_window;
+  uint8_t *s, *d;
+  int pitch, len, i;
+
+  if (!window || !texture || !src || w <= 0 || h <= 0 || tx < 0 || ty < 0 ||
+      (tx + w) > texture->width || (ty + h) > texture->height) return -1;
+  s = &src[(ty * texture->width + tx) * window->spixel];
+  d = &texture->buf[(ty * texture->width + tx) * window->spixel];
+  pitch = texture->width * window->spixel;
+  len = w * window->spixel;
+  for (i = 0; i < h; i++) { sys_memcpy(d, s, len); s += pitch; d += pitch; }
+  return 0;
+}
+
+static int libwtest_draw_texture_rect(window_t *_window, texture_t *texture,
+                                      int tx, int ty, int w, int h, int x, int y) {
+  libwtest_window_t *window = (libwtest_window_t *)_window;
+  uint8_t *s, *d;
+  int spitch, dpitch, len, i;
+
+  if (!window || !texture || w <= 0 || h <= 0) return -1;
+  if (x >= window->width || y >= window->height || x + w <= 0 || y + h <= 0) return -1;
+  if (x < 0) { tx -= x; w += x; x = 0; }
+  if (y < 0) { ty -= y; h += y; y = 0; }
+  if (w <= 0 || h <= 0) return -1;
+  if (x + w > window->width)  w = window->width - x;
+  if (y + h > window->height) h = window->height - y;
+  if (tx < 0 || ty < 0 || tx + w > texture->width || ty + h > texture->height) return -1;
+
+  s = &texture->buf[(ty * texture->width + tx) * window->spixel];
+  d = (uint8_t *)&window->buf[(y * window->width + x)];
+  spitch = texture->width * window->spixel;
+  dpitch = window->width * window->spixel;
+  len = w * window->spixel;
+  for (i = 0; i < h; i++) { sys_memcpy(d, s, len); s += spitch; d += dpitch; }
+  return 0;
+}
+
+static int libwtest_draw_texture(window_t *window, texture_t *texture, int x, int y) {
+  return libwtest_draw_texture_rect(window, texture, 0, 0, texture->width, texture->height, x, y);
+}
+
+static void libwtest_status(window_t *_window, int *x, int *y, int *buttons) {
+  libwtest_window_t *window = (libwtest_window_t *)_window;
+  if (x) *x = window->x;
+  if (y) *y = window->y;
+  if (buttons) *buttons = window->buttons;
+}
+
+static int libwtest_event2(window_t *_window, int wait, int *arg1, int *arg2) {
+  libwtest_window_t *window = (libwtest_window_t *)_window;
+  int64_t now;
+  action_t *a;
+
+  if (!window) return 0;
+  now = sys_get_clock();
+
+  wt_audio_pump();
+
+  if (now >= window->next_shot) {
+    snapshot(window, NULL);
+    window->next_shot = now + (int64_t)window->period * 1000;
+  }
+  if (now < window->resume_at) return 0;
+  if (window->cur >= window->nact) return 0;
+
+  a = &window->act[window->cur];
+  switch (a->op) {
+    case OP_WAIT:
+      window->resume_at = now + (int64_t)a->a * 1000;
+      window->cur++;
+      return 0;
+    case OP_SHOT:
+      snapshot(window, a->label);
+      window->cur++;
+      return 0;
+    case OP_PEN:
+      window->x = a->a; window->y = a->b;
+      *arg1 = a->a; *arg2 = a->b;
+      window->cur++;
+      return WINDOW_MOTION;
+    case OP_TAPDOWN:
+      window->x = a->a; window->y = a->b;
+      window->buttons = 1;
+      a->op = OP_TAPUP;                 /* emit the release next time round */
+      *arg1 = 1; *arg2 = 0;
+      window->resume_at = now + 60000;
+      return WINDOW_BUTTONDOWN;
+    case OP_TAPUP:
+      window->buttons = 0;
+      *arg1 = 1; *arg2 = 0;
+      window->cur++;
+      window->resume_at = now + 60000;
+      return WINDOW_BUTTONUP;
+    case OP_KEYDOWN:
+      *arg1 = a->a; *arg2 = 0;
+      if (a->b) { a->op = OP_KEYUP; window->resume_at = now + 40000; }
+      else window->cur++;
+      return WINDOW_KEYDOWN;
+    case OP_KEYUP:
+      *arg1 = a->a; *arg2 = 0;
+      window->cur++;
+      window->resume_at = now + 40000;
+      return WINDOW_KEYUP;
+  }
+  window->cur++;
+  return 0;
+}
+
+int libwtest_load(void) {
+  sys_memset(&window_provider, 0, sizeof(window_provider));
+  window_provider.create = libwtest_create;
+  window_provider.destroy = libwtest_destroy;
+  window_provider.render = libwtest_render;
+  window_provider.create_texture = libwtest_create_texture;
+  window_provider.destroy_texture = libwtest_destroy_texture;
+  window_provider.update_texture = libwtest_update_texture;
+  window_provider.update_texture_rect = libwtest_update_texture_rect;
+  window_provider.draw_texture = libwtest_draw_texture;
+  window_provider.draw_texture_rect = libwtest_draw_texture_rect;
+  window_provider.status = libwtest_status;
+  window_provider.event2 = libwtest_event2;
+
+  sys_memset(&audio_provider, 0, sizeof(audio_provider));
+  audio_provider.init = wt_audio_init;
+  audio_provider.finish = wt_audio_finish;
+  audio_provider.create = wt_audio_create;
+  audio_provider.start = wt_audio_start;
+  audio_provider.play = wt_audio_play;
+  audio_provider.destroy = wt_audio_destroy;
+  audio_provider.mixer_init = wt_mixer_init;
+  audio_provider.mixer_play = wt_mixer_play;
+  audio_provider.mixer_stop = wt_mixer_stop;
+  return 0;
+}
+
+int libwtest_init(int pe, script_ref_t obj) {
+  debug(DEBUG_INFO, "WTEST", "registering provider %s", WINDOW_PROVIDER);
+  script_set_pointer(pe, WINDOW_PROVIDER, &window_provider);
+  debug(DEBUG_INFO, "WTEST", "registering provider %s", AUDIO_PROVIDER);
+  script_set_pointer(pe, AUDIO_PROVIDER, &audio_provider);
+  script_add_iconst(pe, obj, "hdepth", 16);
+  return 0;
+}
+
+int libwtest_unload(void) { return 0; }
