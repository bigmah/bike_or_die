+  if ((out = open(dst, O_WRONLY | O_CREAT | O_TRUNC, 0666)) >= 0) {
+    r = 0;
+    while ((n = read(in, buf, sizeof(buf))) > 0) {
+      if (write(out, buf, n) != n) { r = -1; break; }
+    }
+    if (n < 0) r = -1;
+    close(out);
+  }
+  close(in);
